@page "/historial"
@attribute [Authorize(Roles = "Administrador,Tecnico,Consulta")]

@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using Microsoft.JSInterop
@using MudBlazor.Charts
@using SAGE.Web.Components.Shared
@using SAGE.Web.Data
@using SAGE.Web.Servicios
@using SAGE.Web.Servicios.Dispositivo
@using SAGE.Web.Servicios.Energia
@using SAGE.Web.Servicios.Reportes
@using SAGE.Web.Servicios.Seguridad
@using SAGE.Web.Servicios.Telemetria

@inject IUsuarioActual UsuarioActual
@inject IServiceScopeFactory ScopeFactory
@inject IFabricaDispositivo Fabrica
@inject CalculadoraEnergia Calculadora
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@inject ILogger<Historial> Logger

<PageTitle>Historial — SAGE</PageTitle>

<div class="page">
    <header class="page-head">
        <div class="page-head__text">
            <p class="page-kicker">Reportes</p>
            <h1 class="page-title">Historial</h1>
            <p class="page-meta">
                Energía y eventos por periodo
                @if (Simulado)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Info" Class="ml-2">SIMULADO</MudChip>
                }
            </p>
        </div>
    </header>

    @if (error is not null)
    {
        <MudAlert Severity="Severity.Error" Class="mb-4">@error</MudAlert>
    }

    @if (dispositivos.Count > 0)
    {
        <div class="page-panel sage-panel-pad sage-filters">
            <h2 class="sage-section-title">Consulta</h2>
            <MudGrid Spacing="3">
                <MudItem xs="12" sm="6">
                    <MudSelect T="int" Label="Dispositivo" Variant="Variant.Outlined" @bind-Value="dispositivoId">
                        @foreach (var dispositivo in dispositivos)
                        {
                            <MudSelectItem Value="@dispositivo.Id">@dispositivo.Nombre</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="Periodo" Label="Periodo" Variant="Variant.Outlined" @bind-Value="periodo">
                        <MudSelectItem Value="Periodo.UltimaHora">Última hora</MudSelectItem>
                        <MudSelectItem Value="Periodo.Hoy">Hoy</MudSelectItem>
                        <MudSelectItem Value="Periodo.UltimosSieteDias">Últimos 7 días</MudSelectItem>
                        <MudSelectItem Value="Periodo.Personalizado">Rango personalizado</MudSelectItem>
                    </MudSelect>
                </MudItem>
                @if (periodo == Periodo.Personalizado)
                {
                    <MudItem xs="12" md="6">
                        <MudDateRangePicker Label="Fechas (Bolivia)" Variant="Variant.Outlined" @bind-DateRange="fechas" DateFormat="dd/MM/yyyy" />
                    </MudItem>
                    <MudItem xs="6" md="3">
                        <MudTimePicker Label="Hora de inicio" Variant="Variant.Outlined" @bind-Time="horaInicio" />
                    </MudItem>
                    <MudItem xs="6" md="3">
                        <MudTimePicker Label="Hora de fin" Variant="Variant.Outlined" @bind-Time="horaFin" />
                    </MudItem>
                }
            </MudGrid>
            <div class="page-actions" style="margin-top:0.85rem">
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           OnClick="ConsultarAsync" Disabled="@(cargando || exportando)">Consultar</MudButton>
            </div>
        </div>
    }

    @if (cargando)
    {
        <div class="page-panel sage-panel-pad">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
        </div>
    }
    else if (consulta is { } resultado)
    {
        <header class="page-head" style="margin-bottom:1rem">
            <div class="page-head__text">
                <p class="page-meta" style="margin:0">
                    @resultado.Dispositivo.Nombre · @Formato.HoraLocal(resultado.Desde) a @Formato.HoraLocal(resultado.Hasta) (Bolivia)
                </p>
            </div>
            <div class="page-actions">
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Download"
                           OnClick="ExportarAsync" Disabled="@exportando">@(exportando ? "Exportando…" : "Exportar a Excel")</MudButton>
            </div>
        </header>

        <div class="sage-metrics" aria-label="Energía del periodo">
            <div class="sage-metric">
                <span class="sage-metric__label">Energía solar</span>
                <span class="sage-metric__value">@Formato.Energia(resultado.Energia.WhSolar, resultado.Dispositivo.FactorEscala)</span>
                <span class="sage-metric__hint"><ChipEscala Factor="@resultado.Dispositivo.FactorEscala" /></span>
            </div>
            <div class="sage-metric">
                <span class="sage-metric__label">Energía red</span>
                <span class="sage-metric__value">@Formato.Energia(resultado.Energia.WhRed, resultado.Dispositivo.FactorEscala)</span>
                <span class="sage-metric__hint"><ChipEscala Factor="@resultado.Dispositivo.FactorEscala" /></span>
            </div>
            @foreach (var (titulo, valor) in Indicadores(resultado.Energia))
            {
                <div class="sage-metric">
                    <span class="sage-metric__label">@titulo</span>
                    <span class="sage-metric__value" style="font-size:1.2rem">@valor</span>
                </div>
            }
        </div>

        <div class="page-panel sage-panel-pad">
            <div class="sage-chips" style="margin-bottom:0.75rem;align-items:center">
                <h2 class="sage-section-title" style="margin:0">Potencia solar y red (W)</h2>
                <ChipEscala Factor="@resultado.Dispositivo.FactorEscala" />
            </div>
            @if (series.Count == 0)
            {
                <p class="page-meta">No hay mediciones en este periodo.</p>
            }
            else
            {
                <MudChart T="double" ChartType="ChartType.Timeseries" ChartSeries="@series" ChartOptions="@opciones"
                          Width="100%" Height="300px" />
            }
        </div>

        <ComparacionPorFuente Energia="@resultado.Energia" Factor="@resultado.Dispositivo.FactorEscala"
                             ConmutacionesSolar="@(resultado.Eventos.Count(e => e.Tipo == "conmutacion" && e.A == "SOLAR"))"
                             ConmutacionesRed="@(resultado.Eventos.Count(e => e.Tipo == "conmutacion" && e.A == "CARGADOR"))"
                             Simulado="@Simulado" />

        <div class="page-panel sage-panel-pad">
            <h2 class="sage-section-title">Eventos del periodo</h2>
            <MudTable T="Evento" Items="@resultado.Eventos" Dense="true" Hover="true" Breakpoint="Breakpoint.Md" Elevation="0">
                <HeaderContent>
                    <MudTh>Hora (Bolivia)</MudTh>
                    <MudTh>Tipo</MudTh>
                    <MudTh>De → A</MudTh>
                    <MudTh>Estado</MudTh>
                    <MudTh>Motivo</MudTh>
                    <MudTh>Origen</MudTh>
                    <MudTh>Orden</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Hora (Bolivia)">@Formato.HoraLocal(context.Ts)</MudTd>
                    <MudTd DataLabel="Tipo">@TextosEventos.Tipo(context.Tipo)</MudTd>
                    <MudTd DataLabel="De → A">@TextosEventos.DeA(context.De, context.A)</MudTd>
                    <MudTd DataLabel="Estado">@TextosEventos.Estado(context.Estado)</MudTd>
                    <MudTd DataLabel="Motivo">@TextosEventos.Motivo(context.Motivo)</MudTd>
                    <MudTd DataLabel="Origen">@TextosEventos.Origen(context.Origen)</MudTd>
                    <MudTd DataLabel="Orden">@context.OrdenId</MudTd>
                </RowTemplate>
                <NoRecordsContent>No hay eventos en este periodo.</NoRecordsContent>
                <PagerContent><MudTablePager RowsPerPageString="Filas por página" /></PagerContent>
            </MudTable>
        </div>
    }
    else if (error is null)
    {
        <MudAlert Severity="Severity.Info">No hay dispositivos en la empresa activa.</MudAlert>
    }
</div>

@code {
    private enum Periodo { UltimaHora, Hoy, UltimosSieteDias, Personalizado }
    private sealed record Consulta(Dispositivo Dispositivo, DateTime Desde, DateTime Hasta,
        EnergiaPorFuente Energia, IReadOnlyList<Evento> Eventos);

    private IReadOnlyList<Dispositivo> dispositivos = [];
    private int dispositivoId;
    private Periodo periodo;
    private DateRange fechas = new();
    private TimeSpan? horaInicio = TimeSpan.Zero;
    private TimeSpan? horaFin = new(23, 59, 59);
    private Consulta? consulta;
    private List<ChartSeries<double>> series = [];
    private TimeSeriesChartOptions opciones = new();
    private string? error;
    private bool cargando = true;
    private bool exportando;
    private bool Simulado => Fabrica is FabricaDispositivoSimulado;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await UsuarioActual.CargarAsync();
            if (UsuarioActual.EmpresaActivaId is not int empresa)
                return;

            await using var scope = ScopeFactory.CreateAsyncScope();
            var db = scope.ServiceProvider.GetRequiredService<ApplicationDbContext>();
            dispositivos = await db.Dispositivos.AsNoTracking().Where(d => d.EmpresaId == empresa)
                .OrderBy(d => d.Nombre).ThenBy(d => d.Id).ToListAsync();
            if (dispositivos.Count == 0)
                return;

            var hoy = Formato.ALocal(DateTime.UtcNow).Date;
            fechas = new DateRange(hoy, hoy);
            dispositivoId = dispositivos[0].Id;
            await ConsultarAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error al cargar dispositivos para el historial");
            error = "No se pudieron cargar los dispositivos.";
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task ConsultarAsync()
    {
        cargando = true;
        error = null;
        consulta = null;
        try
        {
            var ahora = DateTime.UtcNow;
            var desde = periodo switch
            {
                Periodo.Hoy => Formato.DesdeLocal(Formato.ALocal(ahora).Date),
                Periodo.UltimosSieteDias => ahora.AddDays(-7),
                Periodo.Personalizado when fechas.Start is DateTime fecha && horaInicio is TimeSpan hora =>
                    Formato.DesdeLocal(fecha.Date + hora),
                Periodo.Personalizado => (DateTime?)null,
                _ => ahora.AddHours(-1)
            };
            var hasta = periodo == Periodo.Personalizado
                ? fechas.End is DateTime fechaFin && horaFin is TimeSpan fin
                    ? Formato.DesdeLocal(fechaFin.Date + fin)
                    : (DateTime?)null
                : ahora;

            if (desde is null || hasta is null || desde >= hasta)
            {
                error = "Seleccioná un rango con la hora de fin posterior a la de inicio.";
                return;
            }

            var dispositivo = dispositivos.Single(d => d.Id == dispositivoId);
            if (dispositivo.EmpresaId != UsuarioActual.EmpresaActivaId)
                return;

            var lector = Fabrica.CrearLector();
            var puntos = lector.PuntosAsync(dispositivo.Id, desde.Value, hasta.Value);
            var energia = Calculadora.CalcularAsync(dispositivo.Id, desde.Value, hasta.Value);
            var eventos = lector.EventosAsync(dispositivo.Id, desde.Value, hasta.Value);
            await Task.WhenAll(puntos, energia, eventos);

            if (dispositivo.EmpresaId != UsuarioActual.EmpresaActivaId)
                return;

            CargarGrafico(await puntos, dispositivo.FactorEscala, hasta.Value - desde.Value);
            consulta = new Consulta(dispositivo, desde.Value, hasta.Value, await energia, await eventos);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error al consultar el historial");
            error = "No se pudo cargar el historial.";
        }
        finally
        {
            cargando = false;
        }
    }

    private void CargarGrafico(IReadOnlyList<PuntoPotenciaHistorial> puntos, decimal factor, TimeSpan periodo)
    {
        opciones = new TimeSeriesChartOptions
        {
            TimeLabelFormat = periodo.TotalHours > 24 ? "dd/MM HH:mm" : "HH:mm",
            TimeLabelSpacing = TimeSpan.FromTicks(Math.Max(TimeSpan.TicksPerSecond, periodo.Ticks / 6)),
            TooltipTimeLabelFormat = "dd/MM/yyyy HH:mm:ss",
            ShowDataMarkers = false
        };
        series = puntos.Count == 0 ? [] :
        [
            new() { Name = "Solar", Data = puntos.Select(p => new TimeValue<double>(
                Formato.ALocal(p.Ts), (double)(p.PSolMw * factor / 1000))).ToArray() },
            new() { Name = "Red", Data = puntos.Select(p => new TimeValue<double>(
                Formato.ALocal(p.Ts), (double)(p.PRedMw * factor / 1000))).ToArray() }
        ];
    }

    private static (string Titulo, string Valor)[] Indicadores(EnergiaPorFuente energia) =>
    [
        ("% solar", Formato.Porcentaje(energia.PorcentajeSolar)),
        ("Tiempo en solar", Formato.Duracion(energia.TiempoSolar)),
        ("Tiempo en red", Formato.Duracion(energia.TiempoRed)),
        ("Conmutaciones", energia.Conmutaciones.ToString())
    ];

    private async Task ExportarAsync()
    {
        if (consulta is not { } resultado || exportando ||
            resultado.Dispositivo.EmpresaId != UsuarioActual.EmpresaActivaId)
            return;

        exportando = true;
        try
        {
            var dispositivo = resultado.Dispositivo;
            var lecturas = await Fabrica.CrearLector().MedicionesAsync(dispositivo.Id,
                resultado.Desde, resultado.Hasta, int.MaxValue);

            using var archivo = new MemoryStream();
            HistorialExcel.Escribir(archivo, dispositivo.Nombre, resultado.Desde, resultado.Hasta,
                dispositivo.FactorEscala, resultado.Energia, lecturas, resultado.Eventos, Simulado);

            if (dispositivo.EmpresaId != UsuarioActual.EmpresaActivaId)
                return;

            archivo.Position = 0;
            var nombre = string.Join("_", dispositivo.Nombre.Split(Path.GetInvalidFileNameChars()));
            var fecha = Formato.ALocal(resultado.Hasta);
            using var referencia = new DotNetStreamReference(archivo);
            await JS.InvokeVoidAsync("descargarArchivo", $"SAGE_historial_{nombre}_{fecha:yyyyMMdd-HHmm}.xlsx", referencia);
        }
        catch (JSDisconnectedException)
        {
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error al exportar el historial");
            Snackbar.Add("No se pudo exportar el historial.", Severity.Error);
        }
        finally
        {
            exportando = false;
        }
    }
}
