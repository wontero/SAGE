@page "/eventos"
@attribute [Authorize(Roles = "Administrador,Tecnico,Consulta")]

@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using MudBlazor
@using SAGE.Web.Data
@using SAGE.Web.Servicios
@using SAGE.Web.Servicios.Seguridad
@using SAGE.Web.Servicios.Telemetria

@inject IServiceScopeFactory ScopeFactory
@inject IUsuarioActual UsuarioActual

<PageTitle>Eventos — SAGE</PageTitle>

<div class="page">
    <header class="page-head">
        <div class="page-head__text">
            <p class="page-kicker">Telemetría</p>
            <h1 class="page-title">Eventos</h1>
            <p class="page-meta">
                Últimos 50 eventos registrados
            </p>
        </div>
    </header>

    @if (cargando)
    {
        <div class="page-panel">
            <div class="home-row home-row--muted">
                <span class="home-row__label">
                    Cargando eventos…
                </span>
            </div>
        </div>
    }
    else if (error is not null)
    {
        <MudAlert Severity="Severity.Error">
            @error
        </MudAlert>
    }
    else
    {
        <div class="page-panel sage-panel-pad sage-filters">
            <h2 class="sage-section-title">Filtros</h2>
            <MudGrid>
                <MudItem xs="12" sm="4">
                    <MudSelect T="int?" Label="Dispositivo" Variant="Variant.Outlined" @bind-Value="dispositivoId" Clearable="true">
                        @foreach (var dispositivo in dispositivos)
                        {
                            <MudSelectItem T="int?" Value="@((int?)dispositivo.Id)">@dispositivo.Nombre</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudSelect T="string" Label="Tipo" Variant="Variant.Outlined" @bind-Value="tipo" Clearable="true">
                        @foreach (var valor in new[] { "conmutacion", "estado", "alerta", "reinicio" })
                        {
                            <MudSelectItem T="string" Value="@valor">@TextosEventos.Tipo(valor)</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudDateRangePicker Label="Fechas (Bolivia)" Variant="Variant.Outlined" @bind-DateRange="fechas" DateFormat="dd/MM/yyyy" Clearable="true" />
                </MudItem>
            </MudGrid>
            <div class="page-actions" style="margin-top:0.85rem">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="FiltrarAsync">Filtrar</MudButton>
            </div>
        </div>
        <div class="page-panel">
            <MudTable T="Evento" @ref="tabla" ServerData="CargarEventosAsync" Dense="true" Hover="true"
                      Breakpoint="Breakpoint.Md" Elevation="0" RowsPerPage="50">
                <HeaderContent>
                    <MudTh>Hora (Bolivia)</MudTh>
                    <MudTh>Dispositivo</MudTh>
                    <MudTh>Tipo</MudTh>
                    <MudTh>De → A</MudTh>
                    <MudTh>Estado</MudTh>
                    <MudTh>Motivo</MudTh>
                    <MudTh>Origen</MudTh>
                    <MudTh>Orden</MudTh>
                </HeaderContent>

                <RowTemplate>
                    <MudTd DataLabel="Hora (Bolivia)">
                        @* Hora del dispositivo si es válida (los eventos acumulados sin Wi-Fi llegan después). *@
                        @Formato.HoraLocal(context.TsValida ? context.Ts : context.TsServidor)
                    </MudTd>

                    <MudTd DataLabel="Dispositivo">
                        @(context.Dispositivo?.Nombre ?? context.DispositivoId.ToString())
                    </MudTd>

                    <MudTd DataLabel="Tipo">
                        @TextosEventos.Tipo(context.Tipo)
                    </MudTd>

                    <MudTd DataLabel="De → A">
                        @TextosEventos.DeA(context.De, context.A)
                    </MudTd>

                    <MudTd DataLabel="Estado">
                        @TextosEventos.Estado(context.Estado)
                    </MudTd>

                    <MudTd DataLabel="Motivo">
                        @TextosEventos.Motivo(context.Motivo)
                    </MudTd>

                    <MudTd DataLabel="Origen">
                        @TextosEventos.Origen(context.Origen)
                    </MudTd>

                    <MudTd DataLabel="Orden">
                        @(context.OrdenId?.ToString() ?? "—")
                    </MudTd>
                </RowTemplate>

                <NoRecordsContent>No hay eventos para estos filtros.</NoRecordsContent>
                <PagerContent>
                    <MudTablePager RowsPerPageString="Filas por p?gina" PageSizeOptions="@(new int[] { 50 })" />
                </PagerContent>
            </MudTable>
        </div>
    }
</div>

@code {
    private MudTable<Evento>? tabla;
    private List<Dispositivo> dispositivos = [];
    private int? dispositivoId;
    private string? tipo;
    private DateRange fechas = new();
    private bool cargando = true;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await UsuarioActual.CargarAsync();
            if (UsuarioActual.EmpresaActivaId is not int empresaId)
            {
                error = "No ten?s una empresa activa.";
                return;
            }
            await using var scope = ScopeFactory.CreateAsyncScope();
            var db = scope.ServiceProvider.GetRequiredService<ApplicationDbContext>();
            dispositivos = await db.Dispositivos.AsNoTracking().Where(d => d.EmpresaId == empresaId)
                .OrderBy(d => d.Nombre).ToListAsync();
        }
        catch (Exception)
        {
            error = "No se pudieron cargar los dispositivos.";
        }
        finally { cargando = false; }
    }

    private async Task FiltrarAsync()
    {
        if (tabla is not null)
        {
            tabla.NavigateTo(0);
            await tabla.ReloadServerData();
        }
    }

    private async Task<TableData<Evento>> CargarEventosAsync(TableState estado, CancellationToken ct)
    {
        if (UsuarioActual.EmpresaActivaId is not int empresaId)
            return new TableData<Evento>();
        try
        {
            await using var scope = ScopeFactory.CreateAsyncScope();
            var db = scope.ServiceProvider.GetRequiredService<ApplicationDbContext>();
            var desde = fechas.Start is DateTime inicio ? Formato.DesdeLocal(inicio.Date) : (DateTime?)null;
            var hasta = fechas.End is DateTime fin ? Formato.DesdeLocal(fin.Date.AddDays(1)) : (DateTime?)null;
            var consulta = ConsultaEventos.Filtrar(db.Eventos.AsNoTracking().Include(e => e.Dispositivo),
                empresaId, dispositivoId, tipo, desde, hasta);
            var total = await consulta.CountAsync(ct);
            var items = await ConsultaEventos.Pagina(consulta, estado.Page).ToListAsync(ct);
            return new TableData<Evento> { Items = items, TotalItems = total };
        }
        catch (Exception) when (!ct.IsCancellationRequested)
        {
            error = "No se pudieron cargar los eventos.";
            return new TableData<Evento>();
        }
    }
}

