@page "/mediciones"
@attribute [Authorize(Roles = "Administrador,Tecnico,Consulta")]

@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using SAGE.Web.Data
@using SAGE.Web.Servicios.Seguridad

@inject IServiceScopeFactory ScopeFactory
@inject IUsuarioActual UsuarioActual

<PageTitle>Mediciones — SAGE</PageTitle>

<div class="page">
    <header class="page-head">
        <div class="page-head__text">
            <p class="page-kicker">Telemetría</p>
            <h1 class="page-title">Mediciones</h1>
            <p class="page-meta">Últimas 50 mediciones registradas</p>
        </div>
    </header>

    @if (cargando)
    {
        <div class="page-panel">
            <div class="home-row home-row--muted">
                <span class="home-row__label">Cargando mediciones…</span>
            </div>
        </div>
    }
    else if (error != null)
    {
        <MudAlert Severity="Severity.Error">@error</MudAlert>
    }
    else if (mediciones.Count == 0)
    {
        <div class="home-list">
            <div class="home-row home-row--muted">
                <span class="home-row__label">No hay mediciones registradas</span>
            </div>
        </div>
    }
    else
    {
        <div class="page-panel">
            <MudTable Items="mediciones" Dense="true" Hover="true" Breakpoint="Breakpoint.Md" Elevation="0">
                <HeaderContent>
                    <MudTh>Dispositivo</MudTh>
                    <MudTh>Servidor (UTC)</MudTh>
                    <MudTh>Boot</MudTh>
                    <MudTh>Seq</MudTh>
                    <MudTh>V solar</MudTh>
                    <MudTh>I solar</MudTh>
                    <MudTh>P solar</MudTh>
                    <MudTh>Modo</MudTh>
                    <MudTh>Estado</MudTh>
                    <MudTh>Fuente</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Dispositivo">@context.DispositivoId</MudTd>
                    <MudTd DataLabel="Servidor (UTC)">@context.TsServidor.ToString("dd/MM/yyyy HH:mm:ss")</MudTd>
                    <MudTd DataLabel="Boot">@context.BootId</MudTd>
                    <MudTd DataLabel="Seq">@context.Seq</MudTd>
                    <MudTd DataLabel="V solar">@context.VSol V</MudTd>
                    <MudTd DataLabel="I solar">@context.ISolMa mA</MudTd>
                    <MudTd DataLabel="P solar">@context.PSolMw mW</MudTd>
                    <MudTd DataLabel="Modo">@context.Modo</MudTd>
                    <MudTd DataLabel="Estado">@context.Estado</MudTd>
                    <MudTd DataLabel="Fuente">@context.FuenteSeleccionada</MudTd>
                </RowTemplate>
            </MudTable>
        </div>
    }
</div>

@code {
    private List<Medicion> mediciones = new();
    private bool cargando = true;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await UsuarioActual.CargarAsync();

            if (UsuarioActual.EmpresaActivaId is not int empresaId)
            {
                error = "No tenés una empresa activa.";
                return;
            }

            await using var scope = ScopeFactory.CreateAsyncScope();
            var db = scope.ServiceProvider.GetRequiredService<ApplicationDbContext>();

            // El filtro por empresa activa se aplica siempre en la consulta (RNF01).
            mediciones = await db.Mediciones.AsNoTracking()
                .Where(m => m.Dispositivo.EmpresaId == empresaId)
                .OrderByDescending(m => m.TsServidor)
                .Take(50)
                .ToListAsync();
        }
        catch (Exception)
        {
            error = "No se pudieron cargar las mediciones.";
        }
        finally
        {
            cargando = false;
        }
    }
}
