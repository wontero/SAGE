@page "/mediciones"
@attribute [Authorize(Roles = "Administrador,Tecnico,Consulta")]
@implements IDisposable

@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using SAGE.Web.Data
@using SAGE.Web.Servicios
@using SAGE.Web.Servicios.EnVivo
@using SAGE.Web.Servicios.Dispositivo
@using SAGE.Web.Components.Shared
@using SAGE.Web.Servicios.Seguridad

@inject IServiceScopeFactory ScopeFactory
@inject IUsuarioActual UsuarioActual
@inject EstadoDispositivosEnVivo EnVivo
@inject IFabricaDispositivo Fabrica

<PageTitle>Mediciones — SAGE</PageTitle>

<div class="page">
    <header class="page-head">
        <div class="page-head__text">
            <p class="page-kicker">Telemetría en tiempo real</p>
            <h1 class="page-title">Mediciones</h1>
            @if (FabricacionSimulada)
            {
                <MudChip T="string" Color="Color.Info">SIMULADO</MudChip>
            }
            <p class="page-meta">
                Últimas 200 mediciones de la empresa activa.
                Actualización automática.
            </p>
        </div>
    </header>

    @if (cargando)
    {
        <div class="page-panel">
            <MudProgressCircular Indeterminate="true"
                                 Color="Color.Primary" />
        </div>
    }
    else if (error is not null)
    {
        <MudAlert Severity="Severity.Error">
            @error
        </MudAlert>
    }
    else if (mediciones.Count == 0)
    {
        <MudAlert Severity="Severity.Info">
            No hay mediciones registradas.
        </MudAlert>
    }
    else
    {
        <div class="page-panel">
            <MudTable T="Medicion"
                      Items="@mediciones"
                      Dense="true"
                      Hover="true"
                      Breakpoint="Breakpoint.Md"
                      Elevation="0">

                <HeaderContent>
                    <MudTh>Dispositivo</MudTh>
                    <MudTh>Servidor (Bolivia)</MudTh>
                    <MudTh>Boot</MudTh>
                    <MudTh>Seq</MudTh>
                    <MudTh>V solar</MudTh>
                    <MudTh>I solar</MudTh>
                    <MudTh>P solar</MudTh>
                    <MudTh>Modo</MudTh>
                    <MudTh>Estado</MudTh>
                    <MudTh>Fuente</MudTh>
                </HeaderContent>

                <RowTemplate>
                    <MudTd DataLabel="Dispositivo">
                        @context.DispositivoId
                    </MudTd>

                    <MudTd DataLabel="Servidor (Bolivia)">
                        @Formato.HoraLocal(context.TsServidor)
                    </MudTd>

                    <MudTd DataLabel="Boot">
                        @context.BootId
                    </MudTd>

                    <MudTd DataLabel="Seq">
                        @context.Seq
                    </MudTd>

                    <MudTd DataLabel="V solar">
                        @Formato.Tension(context.VSol)
                    </MudTd>

                    <MudTd DataLabel="I solar">
                        @Formato.Corriente(context.ISolMa)
                    </MudTd>

                    <MudTd DataLabel="P solar">
                        @Formato.Potencia(context.PSolMw, factores[context.DispositivoId])
                        <ChipEscala Factor="@factores[context.DispositivoId]" />
                    </MudTd>

                    <MudTd DataLabel="Modo">
                        @context.Modo
                    </MudTd>

                    <MudTd DataLabel="Estado">
                        @context.Estado
                    </MudTd>

                    <MudTd DataLabel="Fuente">
                        @Formato.Fuente(context.FuenteSeleccionada)
                    </MudTd>
                </RowTemplate>

                <PagerContent>
                    <MudTablePager RowsPerPageString="Filas por página" />
                </PagerContent>

            </MudTable>
        </div>
    }
</div>

@code {
    private List<Medicion> mediciones = new();
    private Dictionary<int, decimal> factores = new();

    private bool cargando = true;
    private bool destruido;
    private string? error;
    private int? empresaId;

    private readonly SemaphoreSlim bloqueo = new(1, 1);

    protected override void OnInitialized()
    {
        // Patrón Observer: observar nuevas mediciones.
        EnVivo.Cambio += AlCambiarEstado;
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await UsuarioActual.CargarAsync();

            empresaId = UsuarioActual.EmpresaActivaId;

            if (empresaId is not int empresa)
            {
                error = "No tenés una empresa activa.";
                return;
            }

            await using var scope =
                ScopeFactory.CreateAsyncScope();

            var db = scope.ServiceProvider
                .GetRequiredService<ApplicationDbContext>();

            factores = await db.Dispositivos
                .AsNoTracking()
                .Where(d => d.EmpresaId == empresa)
                .ToDictionaryAsync(d => d.Id, d => d.FactorEscala);

            var lector = Fabrica.CrearLector();
            var lecturas = await Task.WhenAll(factores.Keys.Select(id =>
                lector.MedicionesRecibidasAsync(id, DateTime.MinValue, DateTime.MaxValue, 200)));
            mediciones = lecturas.SelectMany(m => m)
                .OrderByDescending(m => m.TsServidor)
                .ThenByDescending(m => m.Id)
                .Take(200)
                .ToList();
        }
        catch
        {
            error = "No se pudieron cargar las mediciones.";
        }
        finally
        {
            cargando = false;
        }
    }

    private void AlCambiarEstado(EstadoDispositivo estado)
    {
        if (destruido ||
            empresaId is not int empresa ||
            estado.EmpresaId != empresa ||
            UsuarioActual.EmpresaActivaId != empresa ||
            !estado.EnLinea)
        {
            return;
        }

        // La notificación llega después de guardar en SQL.
        // Consultamos únicamente cuando llega una medición.
        // No existe polling periódico.
        _ = InvokeAsync(async () =>
        {
            if (destruido)
                return;

            await CargarNuevaMedicionAsync(estado);
        });
    }

    private async Task CargarNuevaMedicionAsync(
        EstadoDispositivo estado)
    {
        await bloqueo.WaitAsync();

        try
        {
            if (destruido ||
                empresaId != estado.EmpresaId ||
                UsuarioActual.EmpresaActivaId != empresaId ||
                FabricacionSimulada)
            {
                return;
            }

            var nuevas = await Fabrica.CrearLector().MedicionesRecibidasAsync(
                estado.DispositivoId, estado.TsServidor, DateTime.MaxValue, 200);

            if (destruido)
                return;

            factores[estado.DispositivoId] = estado.FactorEscala;
            foreach (var nueva in nuevas)
            {
                if (mediciones.Any(m => m.Id == nueva.Id))
                    continue;

                mediciones.Add(nueva);
            }

            mediciones = mediciones
                .OrderByDescending(m => m.TsServidor)
                .ThenByDescending(m => m.Id)
                .Take(200)
                .ToList();

            StateHasChanged();
        }
        catch
        {
            // Un error de actualización visual no debe
            // interrumpir la recepción de telemetría.
        }
        finally
        {
            bloqueo.Release();
        }
    }

    public void Dispose()
    {
        destruido = true;

        // Evitar suscripciones colgadas.
        EnVivo.Cambio -= AlCambiarEstado;
    }

    private bool FabricacionSimulada => Fabrica is FabricaDispositivoSimulado;
}
