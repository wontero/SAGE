@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using Microsoft.Extensions.DependencyInjection
@using SAGE.Web.Servicios.Seguridad
@inject IServiceScopeFactory ScopeFactory
@inject IUsuarioActual UsuarioActual
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <EditForm EditContext="_editContext">
            <DataAnnotationsValidator />

            <MudStack Spacing="3">
                <MudTextField T="string"
                              @bind-Value="_modelo.NombreCompleto"
                              Label="Nombre completo"
                              Variant="Variant.Outlined"
                              For="@(() => _modelo.NombreCompleto)" />

                <MudTextField T="string"
                              @bind-Value="_modelo.Correo"
                              Label="Correo electrónico"
                              Variant="Variant.Outlined"
                              Disabled="@(_modelo.Id is not null)"
                              For="@(() => _modelo.Correo)" />

                @if (_modelo.Id is null)
                {
                    <MudTextField T="string"
                                  @bind-Value="_modelo.ContrasenaInicial"
                                  Label="Contraseña temporal"
                                  InputType="InputType.Password"
                                  Variant="Variant.Outlined"
                                  HelperText="El usuario deberá cambiarla en su primer inicio de sesión. Mínimo 8 caracteres, mayúscula, minúscula, número y símbolo."
                                  For="@(() => _modelo.ContrasenaInicial)" />
                }

                @if (Modo == "NuevoUsuario" || Modo == "Editar")
                {
                    <MudSelect T="string"
                               @bind-Value="_modelo.Rol"
                               Label="Rol"
                               Variant="Variant.Outlined">
                        @if (Modo == "NuevoUsuario")
                        {
                            <MudSelectItem T="string" Value="@("Administrador")">Administrador</MudSelectItem>
                        }
                        <MudSelectItem T="string" Value="@("Tecnico")">Técnico</MudSelectItem>
                        <MudSelectItem T="string" Value="@("Consulta")">Consulta</MudSelectItem>
                    </MudSelect>
                }

                @if (_modelo.Id is null)
                {
                    <MudSelect T="int?"
                               @bind-Value="_modelo.EmpresaId"
                               Label="Empresa"
                               Variant="Variant.Outlined">
                        @foreach (var empresa in EmpresasDisponibles)
                        {
                            <MudSelectItem T="int?" Value="@((int?)empresa.Id)">@empresa.Nombre</MudSelectItem>
                        }
                    </MudSelect>
                }

                <ValidationSummary />

                @if (!string.IsNullOrWhiteSpace(_error))
                {
                    <MudAlert Severity="Severity.Error">@_error</MudAlert>
                }
            </MudStack>
        </EditForm>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Cancelar" Disabled="_guardando">Cancelar</MudButton>
        <MudButton OnClick="Guardar"
                   Color="Color.Primary"
                   Variant="Variant.Filled"
                   Disabled="_guardando">
            @(_guardando ? "Guardando..." : "Guardar")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    // "NuevoAdministrador" (Operador), "NuevoUsuario" (Administrador) o "Editar".
    [Parameter]
    public string Modo { get; set; } = "NuevoUsuario";

    [Parameter]
    public UsuarioFormModel Modelo { get; set; } = new();

    [Parameter]
    public List<EmpresaOpcion> EmpresasDisponibles { get; set; } = new();

    private UsuarioFormModel _modelo = new();
    private EditContext _editContext = default!;
    private bool _guardando;
    private string? _error;

    protected override void OnInitialized()
    {
        _modelo = new UsuarioFormModel
        {
            Id = Modelo.Id,
            NombreCompleto = Modelo.NombreCompleto,
            Correo = Modelo.Correo,
            Rol = Modo == "NuevoAdministrador" ? "Administrador" : Modelo.Rol,
            EmpresaId = Modelo.EmpresaId
        };

        _editContext = new EditContext(_modelo);
    }

    private void Cancelar() => MudDialog.Cancel();

    private async Task Guardar()
    {
        if (_guardando)
            return;

        _error = null;
        _modelo.NombreCompleto = _modelo.NombreCompleto.Trim();
        _modelo.Correo = _modelo.Correo.Trim();

        if (Modo == "NuevoAdministrador")
        {
            _modelo.Rol = "Administrador";
        }

        if (!_editContext.Validate())
            return;

        // Validaciones de rol y empresa (fuera de las anotaciones del modelo).
        if (_modelo.Rol != "Administrador" && _modelo.Rol != "Tecnico" && _modelo.Rol != "Consulta")
        {
            _error = "El rol seleccionado no es válido.";
            return;
        }

        if (_modelo.Id is null)
        {
            if (string.IsNullOrWhiteSpace(_modelo.ContrasenaInicial))
            {
                _error = "La contraseña temporal es obligatoria.";
                return;
            }

            if (_modelo.EmpresaId is null || _modelo.EmpresaId <= 0)
            {
                _error = "Seleccioná una empresa.";
                return;
            }
        }

        _guardando = true;

        try
        {
            using var scope = ScopeFactory.CreateScope();
            var db = scope.ServiceProvider.GetRequiredService<ApplicationDbContext>();
            var usuarios = scope.ServiceProvider.GetRequiredService<UserManager<ApplicationUser>>();

            // Reverificación de permisos en el servidor (no basta con ocultar botones).
            if (Modo == "NuevoAdministrador")
            {
                if (!UsuarioActual.EsOperador)
                {
                    _error = "No tenés permiso para crear administradores.";
                    return;
                }
            }
            else
            {
                if (!UsuarioActual.EsAdministrador)
                {
                    _error = "No tenés permiso para administrar usuarios.";
                    return;
                }
            }

            if (_modelo.Id is null)
            {
                await CrearAsync(db, usuarios);
            }
            else
            {
                await EditarAsync(db, usuarios);
            }
        }
        catch
        {
            _error = "No se pudo guardar el usuario. Verificá la conexión e intentá nuevamente.";
        }
        finally
        {
            _guardando = false;
        }
    }

    private async Task CrearAsync(ApplicationDbContext db, UserManager<ApplicationUser> usuarios)
    {
        var empresaId = _modelo.EmpresaId!.Value;

        // La empresa debe estar activa y ser elegible por quien crea.
        var empresaActiva = await db.Empresas.AnyAsync(e => e.Id == empresaId && e.Activa);
        if (!empresaActiva)
        {
            _error = "Seleccioná una empresa activa.";
            return;
        }

        if (Modo != "NuevoAdministrador")
        {
            // El Administrador solo puede asignar una de sus propias empresas.
            var empresasPropias = UsuarioActual.Empresas.Select(e => e.Id).ToList();
            if (!SAGE.Web.Servicios.Seguridad.ReglasUsuarios.AdministradorPuedeAsignarEmpresa(empresasPropias, empresaId))
            {
                _error = "No podés asignar una empresa que no es tuya.";
                return;
            }
        }

        var existente = await usuarios.FindByEmailAsync(_modelo.Correo);
        if (existente is not null)
        {
            _error = "Ya existe un usuario con ese correo.";
            return;
        }

        await using var transaccion = await db.Database.BeginTransactionAsync();

        var nuevo = new ApplicationUser
        {
            UserName = _modelo.Correo,
            Email = _modelo.Correo,
            EmailConfirmed = true,
            NombreCompleto = _modelo.NombreCompleto,
            Activo = true,
            DebeCambiarContrasena = true
        };

        if (!Comprobar(await usuarios.CreateAsync(nuevo, _modelo.ContrasenaInicial!)))
            return;

        if (!Comprobar(await usuarios.AddToRoleAsync(nuevo, _modelo.Rol)))
            return;

        db.UsuarioEmpresas.Add(new UsuarioEmpresa
        {
            UsuarioId = nuevo.Id,
            EmpresaId = empresaId,
            FechaVinculo = DateTime.UtcNow
        });
        await db.SaveChangesAsync();

        await transaccion.CommitAsync();

        Snackbar.Add("Usuario creado correctamente.", Severity.Success);
        MudDialog.Close(DialogResult.Ok(true));
    }

    private async Task EditarAsync(ApplicationDbContext db, UserManager<ApplicationUser> usuarios)
    {
        var usuario = await usuarios.FindByIdAsync(_modelo.Id!);
        if (usuario is null)
        {
            _error = "El usuario ya no existe.";
            return;
        }

        var rolesActuales = await usuarios.GetRolesAsync(usuario);
        _error = await ReglasUsuarios.ErrorDeGestionAsync(db, UsuarioActual, usuario.Id, rolesActuales,
            AccionUsuario.Editar);
        if (_error is not null)
            return;

        if (_modelo.Rol != "Tecnico" && _modelo.Rol != "Consulta")
        {
            _error = "Solo podés asignar los roles Técnico o Consulta.";
            return;
        }

        usuario.NombreCompleto = _modelo.NombreCompleto;
        if (!Comprobar(await usuarios.UpdateAsync(usuario)))
            return;

        var cambioRol = rolesActuales.Count != 1 || !rolesActuales.Contains(_modelo.Rol);
        if (cambioRol)
        {
            if (rolesActuales.Count > 0 && !Comprobar(await usuarios.RemoveFromRolesAsync(usuario, rolesActuales)))
                return;

            if (!Comprobar(await usuarios.AddToRoleAsync(usuario, _modelo.Rol)))
                return;

            if (!Comprobar(await usuarios.UpdateSecurityStampAsync(usuario)))
                return;
        }

        Snackbar.Add("Usuario actualizado correctamente.", Severity.Success);
        MudDialog.Close(DialogResult.Ok(true));
    }

    private bool Comprobar(IdentityResult resultado)
    {
        if (resultado.Succeeded)
            return true;

        _error = string.Join(" ", resultado.Errors.Select(TraducirError).Distinct());
        return false;
    }

    private static string TraducirError(IdentityError error)
    {
        return error.Code switch
        {
            "DuplicateEmail" or "DuplicateUserName" => "Ya existe un usuario con ese correo.",
            "InvalidEmail" or "InvalidUserName" => "El correo ingresado no es válido.",
            "PasswordTooShort" => "La contraseña debe tener al menos 8 caracteres.",
            "PasswordRequiresDigit" => "La contraseña debe incluir un número.",
            "PasswordRequiresLower" => "La contraseña debe incluir una minúscula.",
            "PasswordRequiresUpper" => "La contraseña debe incluir una mayúscula.",
            "PasswordRequiresNonAlphanumeric" => "La contraseña debe incluir un símbolo.",
            "PasswordRequiresUniqueChars" => "La contraseña debe incluir más caracteres diferentes.",
            "ConcurrencyFailure" => "El usuario fue modificado. Cerrá y volvé a abrir el formulario.",
            _ => "No se pudo completar la operación del usuario."
        };
    }
}
