@using Microsoft.EntityFrameworkCore
@using Microsoft.Extensions.DependencyInjection
@using SAGE.Web.Servicios.Seguridad
@inject IServiceScopeFactory ScopeFactory
@inject IUsuarioActual UsuarioActual
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudStack Spacing="3">
            <div class="sage-person" style="margin-bottom:0.25rem;">
                <span class="sage-person__name">@NombreAdministrador</span>
                <span class="sage-person__mail">Empresas vinculadas a este administrador</span>
            </div>

            @if (_cargando)
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
            }
            else
            {
                <MudList T="string" Dense="true">
                    @foreach (var e in _vinculadas)
                    {
                        <MudListItem T="string">
                            <div class="sage-row-actions" style="justify-content:space-between; width:100%;">
                                <span class="sage-person__name">@e.Nombre</span>
                                <MudButton Size="Size.Small"
                                           Color="Color.Error"
                                           Variant="Variant.Text"
                                           Disabled="@(_ocupado || _vinculadas.Count <= 1)"
                                           OnClick="@(() => Desvincular(e.Id))">
                                    Desvincular
                                </MudButton>
                            </div>
                        </MudListItem>
                    }
                </MudList>

                @if (_vinculadas.Count <= 1)
                {
                    <MudAlert Severity="Severity.Info" Dense="true">
                        Un administrador con una sola empresa no puede desvincularse. Para quitarle el acceso, desactívalo.
                    </MudAlert>
                }

                <MudText Typo="Typo.subtitle2">Vincular a otra empresa</MudText>
                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                    <MudSelect T="int"
                               @bind-Value="_empresaNueva"
                               Label="Empresa"
                               Variant="Variant.Outlined"
                               Dense="true"
                               Disabled="@(_ocupado || _disponibles.Count == 0)">
                        @foreach (var e in _disponibles)
                        {
                            <MudSelectItem T="int" Value="@e.Id">@e.Nombre</MudSelectItem>
                        }
                    </MudSelect>
                    <MudButton Color="Color.Primary"
                               Variant="Variant.Filled"
                               Disabled="@(_ocupado || _empresaNueva <= 0)"
                               OnClick="Vincular">
                        Vincular
                    </MudButton>
                </MudStack>

                @if (_disponibles.Count == 0)
                {
                    <MudText Typo="Typo.body2">Ya está vinculado a todas las empresas activas.</MudText>
                }

                @if (!string.IsNullOrWhiteSpace(_error))
                {
                    <MudAlert Severity="Severity.Error">@_error</MudAlert>
                }
            }
        </MudStack>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Cerrar">Cerrar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public string AdministradorId { get; set; } = string.Empty;

    [Parameter]
    public string NombreAdministrador { get; set; } = string.Empty;

    private readonly List<EmpresaOpcion> _vinculadas = new();
    private readonly List<EmpresaOpcion> _disponibles = new();
    private int _empresaNueva;
    private bool _cargando = true;
    private bool _ocupado;
    private bool _huboCambios;
    private string? _error;

    protected override async Task OnInitializedAsync() => await CargarAsync();

    private async Task CargarAsync()
    {
        _cargando = true;
        _error = null;
        _vinculadas.Clear();
        _disponibles.Clear();

        try
        {
            using var scope = ScopeFactory.CreateScope();
            var db = scope.ServiceProvider.GetRequiredService<ApplicationDbContext>();

            var activas = await db.Empresas.AsNoTracking()
                .Where(e => e.Activa)
                .OrderBy(e => e.Nombre)
                .Select(e => new EmpresaOpcion(e.Id, e.Nombre))
                .ToListAsync();

            var vinculadasIds = await db.UsuarioEmpresas.AsNoTracking()
                .Where(ue => ue.UsuarioId == AdministradorId)
                .Select(ue => ue.EmpresaId)
                .ToListAsync();

            _vinculadas.AddRange(activas.Where(e => vinculadasIds.Contains(e.Id)));
            _disponibles.AddRange(activas.Where(e => !vinculadasIds.Contains(e.Id)));
            _empresaNueva = _disponibles.FirstOrDefault()?.Id ?? 0;
        }
        catch
        {
            _error = "No se pudieron cargar las empresas.";
        }
        finally
        {
            _cargando = false;
        }
    }

    private async Task Vincular()
    {
        if (_ocupado || _empresaNueva <= 0)
            return;

        _ocupado = true;
        _error = null;

        try
        {
            if (!UsuarioActual.EsOperador)
            {
                _error = "No tenés permiso para esta acción.";
                return;
            }

            using var scope = ScopeFactory.CreateScope();
            var db = scope.ServiceProvider.GetRequiredService<ApplicationDbContext>();

            var yaExiste = await db.UsuarioEmpresas
                .AnyAsync(ue => ue.UsuarioId == AdministradorId && ue.EmpresaId == _empresaNueva);
            if (!yaExiste)
            {
                db.UsuarioEmpresas.Add(new UsuarioEmpresa
                {
                    UsuarioId = AdministradorId,
                    EmpresaId = _empresaNueva,
                    FechaVinculo = DateTime.UtcNow
                });
                await db.SaveChangesAsync();
                _huboCambios = true;
                Snackbar.Add("Administrador vinculado a la empresa.", Severity.Success);
            }

            await CargarAsync();
        }
        catch
        {
            _error = "No se pudo vincular la empresa.";
        }
        finally
        {
            _ocupado = false;
        }
    }

    private async Task Desvincular(int empresaId)
    {
        if (_ocupado)
            return;

        if (_vinculadas.Count <= 1)
        {
            _error = "No se puede dejar al administrador sin empresas. Desactívalo en su lugar.";
            return;
        }

        _ocupado = true;
        _error = null;

        try
        {
            if (!UsuarioActual.EsOperador)
            {
                _error = "No tenés permiso para esta acción.";
                return;
            }

            using var scope = ScopeFactory.CreateScope();
            var db = scope.ServiceProvider.GetRequiredService<ApplicationDbContext>();

            var total = await db.UsuarioEmpresas.CountAsync(ue => ue.UsuarioId == AdministradorId);
            if (total <= 1)
            {
                _error = "No se puede dejar al administrador sin empresas. Desactívalo en su lugar.";
                return;
            }

            var vinculo = await db.UsuarioEmpresas
                .FirstOrDefaultAsync(ue => ue.UsuarioId == AdministradorId && ue.EmpresaId == empresaId);
            if (vinculo is not null)
            {
                db.UsuarioEmpresas.Remove(vinculo);
                await db.SaveChangesAsync();
                _huboCambios = true;
                Snackbar.Add("Empresa desvinculada.", Severity.Success);
            }

            await CargarAsync();
        }
        catch
        {
            _error = "No se pudo desvincular la empresa.";
        }
        finally
        {
            _ocupado = false;
        }
    }

    private void Cerrar() => MudDialog.Close(DialogResult.Ok(_huboCambios));
}
