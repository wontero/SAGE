@page "/usuarios"
@attribute [Authorize(Roles = "Administrador")]
@using System.Security.Claims
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using Microsoft.Extensions.DependencyInjection
@inject IServiceScopeFactory ScopeFactory
@inject AuthenticationStateProvider AuthStateProvider
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Usuarios — SAGE</PageTitle>

<MudStack Spacing="3">
    <MudText Typo="Typo.h4">Usuarios</MudText>

    <MudButton Color="Color.Primary"
               Variant="Variant.Filled"
               StartIcon="@Icons.Material.Filled.PersonAdd"
               OnClick="NuevoUsuario"
               Disabled="@(_cargando || _cambiandoEstado)">
        Nuevo usuario
    </MudButton>

    <MudGrid>
        <MudItem xs="12" md="6">
            <MudTextField T="string"
                          @bind-Value="_busqueda"
                          Label="Buscar por nombre o correo"
                          Variant="Variant.Outlined"
                          Immediate="true"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search" />
        </MudItem>

        <MudItem xs="12" md="3">
            <MudSelect T="int"
                       @bind-Value="_empresaFiltro"
                       Label="Empresa"
                       Variant="Variant.Outlined">
                <MudSelectItem T="int" Value="0">
                    Todas las empresas
                </MudSelectItem>

                @foreach (var empresa in _empresas)
                {
                    <MudSelectItem T="int" Value="@empresa.Id">
                        @empresa.Nombre
                    </MudSelectItem>
                }
            </MudSelect>
        </MudItem>

        <MudItem xs="12" md="3">
            <MudSelect T="string"
                       @bind-Value="_rolFiltro"
                       Label="Rol"
                       Variant="Variant.Outlined">
                <MudSelectItem T="string" Value="@("")">
                    Todos los roles
                </MudSelectItem>

                <MudSelectItem T="string" Value="@("Administrador")">
                    Administrador
                </MudSelectItem>

                <MudSelectItem T="string" Value="@("Tecnico")">
                    Técnico
                </MudSelectItem>

                <MudSelectItem T="string" Value="@("Consulta")">
                    Consulta
                </MudSelectItem>
            </MudSelect>
        </MudItem>
    </MudGrid>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <MudAlert Severity="Severity.Error">
            @_error
        </MudAlert>
    }

    <MudTable T="UsuarioFila"
              Items="@UsuariosFiltrados"
              Loading="_cargando"
              Hover="true"
              Striped="true"
              Breakpoint="Breakpoint.Sm"
              Elevation="1">
        <HeaderContent>
            <MudTh>Nombre completo</MudTh>
            <MudTh>Correo</MudTh>
            <MudTh>Rol</MudTh>
            <MudTh>Empresa</MudTh>
            <MudTh>Estado</MudTh>
            <MudTh>Acciones</MudTh>
        </HeaderContent>

        <RowTemplate>
            <MudTd DataLabel="Nombre completo">
                @context.NombreCompleto
            </MudTd>

            <MudTd DataLabel="Correo">
                @context.Correo
            </MudTd>

            <MudTd DataLabel="Rol">
                <MudChip T="string"
                         Color="@ColorRol(context.Rol)"
                         Size="Size.Small">
                    @(context.Rol == "Tecnico" ? "Técnico" : context.Rol)
                </MudChip>
            </MudTd>

            <MudTd DataLabel="Empresa">
                @context.EmpresaNombre
            </MudTd>

            <MudTd DataLabel="Estado">
                <MudChip T="string"
                         Color="@(context.Activo ? Color.Success : Color.Default)"
                         Size="Size.Small">
                    @(context.Activo ? "Activo" : "Inactivo")
                </MudChip>
            </MudTd>

            <MudTd DataLabel="Acciones">
                <MudStack Spacing="1">
                    <MudButton Color="Color.Primary"
                               Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Edit"
                               OnClick="@(() => EditarUsuario(context))"
                               Disabled="@(_cargando || _cambiandoEstado)">
                        Editar
                    </MudButton>

                    <MudButton Color="@(context.Activo ? Color.Warning : Color.Success)"
                               Size="Size.Small"
                               StartIcon="@(context.Activo
                                                           ? Icons.Material.Filled.Block
                                                       : Icons.Material.Filled.CheckCircle)"
                               OnClick="@(() => CambiarEstadoUsuario(context))"
                               Disabled="@(_cargando || _cambiandoEstado)">
                        @(context.Activo ? "Desactivar" : "Activar")
                    </MudButton>

                    <MudButton Color="Color.Secondary"
                               Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.LockReset"
                               OnClick="@(() => RestablecerContrasena(context))"
                               Disabled="@(_cargando || _cambiandoEstado)">
                        Restablecer contraseña
                    </MudButton>
                </MudStack>
            </MudTd>
        </RowTemplate>

        <NoRecordsContent>
            <MudText>No se encontraron usuarios.</MudText>
        </NoRecordsContent>

        <PagerContent>
            <MudTablePager RowsPerPageString="Filas por página"
                           InfoFormat="{first_item}-{last_item} de {all_items}" />
        </PagerContent>
    </MudTable>
</MudStack>

@code {
    private List<UsuarioFila> _usuarios = new();
    private List<Empresa> _empresas = new();

    private string _busqueda = string.Empty;
    private string _rolFiltro = string.Empty;
    private int _empresaFiltro;
    private bool _cargando = true;
    private bool _cambiandoEstado;
    private string? _error;

    private IEnumerable<UsuarioFila> UsuariosFiltrados =>
        _usuarios.Where(u =>
            (string.IsNullOrWhiteSpace(_busqueda) ||
             u.NombreCompleto.Contains(
                 _busqueda.Trim(), StringComparison.OrdinalIgnoreCase) ||
             u.Correo.Contains(
                 _busqueda.Trim(), StringComparison.OrdinalIgnoreCase)) &&
            (_empresaFiltro == 0 || u.EmpresaId == _empresaFiltro) &&
            (string.IsNullOrEmpty(_rolFiltro) || u.Rol == _rolFiltro));

    protected override async Task OnInitializedAsync()
    {
        await CargarUsuarios();
    }

    private async Task CargarUsuarios()
    {
        _cargando = true;
        _error = null;
        _usuarios.Clear();
        _empresas.Clear();

        try
        {
            using var scope = ScopeFactory.CreateScope();

            var db = scope.ServiceProvider
                .GetRequiredService<ApplicationDbContext>();

            var userManager = scope.ServiceProvider
                .GetRequiredService<UserManager<ApplicationUser>>();

            var estado = await AuthStateProvider.GetAuthenticationStateAsync();

            var administradorId = estado.User
                .FindFirstValue(ClaimTypes.NameIdentifier);

            var administrador = administradorId is null
                ? null
                : await userManager.FindByIdAsync(administradorId);

            if (administrador is null ||
                !administrador.Activo ||
                !await userManager.IsInRoleAsync(administrador, "Administrador"))
            {
                _error = "No tenés permiso para consultar los usuarios.";
                return;
            }

            _empresas = await db.Empresas
                .AsNoTracking()
                .OrderBy(e => e.Nombre)
                .ToListAsync();

            var usuarios = await db.Users
                .AsNoTracking()
                .Include(u => u.Empresa)
                .OrderBy(u => u.NombreCompleto)
                .ToListAsync();

            var filas = new List<UsuarioFila>();

            foreach (var usuario in usuarios)
            {
                var roles = await userManager.GetRolesAsync(usuario);

                filas.Add(new UsuarioFila
                {
                    Id = usuario.Id,
                    NombreCompleto = usuario.NombreCompleto,
                    Correo = usuario.Email ?? string.Empty,
                    Rol = roles.FirstOrDefault() ?? "Sin rol",
                    EmpresaId = usuario.EmpresaId,
                    EmpresaNombre = usuario.Empresa?.Nombre ?? "Sin empresa",
                    Activo = usuario.Activo
                });
            }

            _usuarios = filas;
        }
        catch
        {
            _error = "No se pudieron cargar los usuarios.";
            Snackbar.Add(_error, Severity.Error);
        }
        finally
        {
            _cargando = false;
        }
    }

    private Task NuevoUsuario()
    {
        return AbrirFormulario(
            new UsuarioFormModel(),
            "Nuevo usuario");
    }

    private Task EditarUsuario(UsuarioFila usuario)
    {
        var modelo = new UsuarioFormModel
        {
            Id = usuario.Id,
            NombreCompleto = usuario.NombreCompleto,
            Correo = usuario.Correo,
            Rol = usuario.Rol,
            EmpresaId = usuario.EmpresaId
        };

        return AbrirFormulario(modelo, "Editar usuario");
    }

    private async Task AbrirFormulario(
        UsuarioFormModel modelo, string titulo)
    {
        var parametros = new DialogParameters
        {
            [nameof(UsuarioDialog.Modelo)] = modelo
        };

        var opciones = new DialogOptions
        {
            FullWidth = true,
            MaxWidth = MaxWidth.Small,
            CloseButton = true
        };

        var dialogo = await DialogService.ShowAsync<UsuarioDialog>(
            titulo, parametros, opciones);

        var resultado = await dialogo.Result;

        if (resultado is not null && !resultado.Canceled)
        {
            await CargarUsuarios();
        }
    }

    private async Task CambiarEstadoUsuario(UsuarioFila fila)
    {
        if (_cambiandoEstado)
            return;

        _cambiandoEstado = true;

        try
        {
            var estado = await AuthStateProvider.GetAuthenticationStateAsync();

            var administradorId = estado.User
                .FindFirstValue(ClaimTypes.NameIdentifier);

            if (fila.Id == administradorId)
            {
                Snackbar.Add(
                    "No podés desactivar tu propia cuenta.",
                    Severity.Warning);
                return;
            }

            var nuevoEstado = !fila.Activo;
            var accion = nuevoEstado ? "activar" : "desactivar";

            var parametros = new DialogParameters
            {
                ["Contenido"] =
                    $"¿Querés {accion} al usuario {fila.NombreCompleto}?"
            };

            var dialogo = await DialogService.ShowAsync<
                SAGE.Web.Components.Pages.Empresas.ConfirmDialog>(
                    "Confirmar cambio de estado",
                    parametros);

            var confirmacion = await dialogo.Result;

            if (confirmacion is null || confirmacion.Canceled)
                return;

            using var scope = ScopeFactory.CreateScope();

            var userManager = scope.ServiceProvider
                .GetRequiredService<UserManager<ApplicationUser>>();

            var db = scope.ServiceProvider
                .GetRequiredService<ApplicationDbContext>();

            // Verificar los permisos antes de modificar los datos.
            var administrador = administradorId is null
                ? null
                : await userManager.FindByIdAsync(administradorId);

            if (administrador is null ||
                !administrador.Activo ||
                !await userManager.IsInRoleAsync(administrador, "Administrador"))
            {
                Snackbar.Add(
                    "No tenés permiso para modificar usuarios.",
                    Severity.Error);
                return;
            }

            var usuario = await userManager.FindByIdAsync(fila.Id);

            if (usuario is null)
            {
                Snackbar.Add(
                    "El usuario ya no existe.",
                    Severity.Error);
                return;
            }

            if (usuario.Id == administrador.Id)
            {
                Snackbar.Add(
                    "No podés desactivar tu propia cuenta.",
                    Severity.Warning);
                return;
            }

            if (usuario.Activo == nuevoEstado)
            {
                Snackbar.Add(
                    "El usuario ya tiene ese estado.",
                    Severity.Info);

                await CargarUsuarios();
                return;
            }

            await using (var transaccion =
                await db.Database.BeginTransactionAsync())
            {
                usuario.Activo = nuevoEstado;

                var resultado = await userManager.UpdateAsync(usuario);

                if (!resultado.Succeeded)
                {
                    Snackbar.Add(
                        "No se pudo cambiar el estado. Recargá la lista e intentá nuevamente.",
                        Severity.Error);
                    return;
                }

                var resultadoSesion =
                    await userManager.UpdateSecurityStampAsync(usuario);

                if (!resultadoSesion.Succeeded)
                {
                    Snackbar.Add(
                        "No se pudo completar el cambio de estado.",
                        Severity.Error);
                    return;
                }

                await transaccion.CommitAsync();
            }

            Snackbar.Add(
                nuevoEstado
                    ? "Usuario activado correctamente."
                    : "Usuario desactivado correctamente.",
                Severity.Success);

            await CargarUsuarios();
        }
        catch
        {
            Snackbar.Add(
                "No se pudo cambiar el estado del usuario.",
                Severity.Error);
        }
        finally
        {
            _cambiandoEstado = false;
        }
    }

    private async Task RestablecerContrasena(UsuarioFila usuario)
    {
        var parametros = new DialogParameters
        {
            [nameof(RestablecerContrasenaDialog.UsuarioId)] = usuario.Id,
            [nameof(RestablecerContrasenaDialog.Correo)] = usuario.Correo
        };

        var opciones = new DialogOptions
        {
            FullWidth = true,
            MaxWidth = MaxWidth.Small,
            CloseButton = true
        };

        var dialogo =
            await DialogService.ShowAsync<RestablecerContrasenaDialog>(
                "Restablecer contraseña",
                parametros,
                opciones);

        await dialogo.Result;
    }

    private static Color ColorRol(string rol) => rol switch
    {
        "Administrador" => Color.Primary,
        "Tecnico" => Color.Warning,
        "Consulta" => Color.Info,
        _ => Color.Default
    };

    private sealed class UsuarioFila
    {
        public string Id { get; set; } = string.Empty;
        public string NombreCompleto { get; set; } = string.Empty;
        public string Correo { get; set; } = string.Empty;
        public string Rol { get; set; } = string.Empty;
        public int? EmpresaId { get; set; }
        public string EmpresaNombre { get; set; } = string.Empty;
        public bool Activo { get; set; }
    }
}