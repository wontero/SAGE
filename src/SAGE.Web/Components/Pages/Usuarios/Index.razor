@page "/usuarios"
@attribute [Authorize(Roles = "Operador,Administrador")]
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using Microsoft.Extensions.DependencyInjection
@using SAGE.Web.Servicios.Seguridad
@inject IServiceScopeFactory ScopeFactory
@inject IUsuarioActual UsuarioActual
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Usuarios — SAGE</PageTitle>

<div class="page">
    <header class="page-head">
        <div class="page-head__text">
            <p class="page-kicker">@(UsuarioActual.EsOperador ? "Operador SAGE" : "Administración")</p>
            <h1 class="page-title">Usuarios</h1>
            @if (!UsuarioActual.EsOperador && UsuarioActual.EmpresaActiva is not null)
            {
                <p class="page-meta">@UsuarioActual.EmpresaActiva.Nombre</p>
            }
            else if (UsuarioActual.EsOperador)
            {
                <p class="page-meta">Administradores de empresas cliente</p>
            }
        </div>
        <div class="page-actions">
            <MudButton Color="Color.Primary"
                       Variant="Variant.Filled"
                       StartIcon="@Icons.Material.Filled.PersonAdd"
                       OnClick="NuevoUsuario"
                       Disabled="@(_cargando || _ocupado)">
                @(UsuarioActual.EsOperador ? "Nuevo administrador" : "Nuevo usuario")
            </MudButton>
        </div>
    </header>

    <div class="page-filters">
        <MudTextField T="string"
                      @bind-Value="_busqueda"
                      Label="Buscar por nombre o correo"
                      Variant="Variant.Outlined"
                      Immediate="true"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search" />
    </div>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <MudAlert Severity="Severity.Error" Class="mb-3">@_error</MudAlert>
    }

    <div class="page-panel">
        <MudTable T="UsuarioFila"
                  Items="@UsuariosFiltrados"
                  Loading="_cargando"
                  Hover="true"
                  Breakpoint="Breakpoint.Sm"
                  Elevation="0">
            <HeaderContent>
                <MudTh>Persona</MudTh>
                @if (UsuarioActual.EsOperador)
                {
                    <MudTh>Empresas</MudTh>
                }
                else
                {
                    <MudTh>Rol</MudTh>
                }
                <MudTh>Estado</MudTh>
                <MudTh>Acciones</MudTh>
            </HeaderContent>

            <RowTemplate>
                <MudTd DataLabel="Persona">
                    <div class="sage-person">
                        <span class="sage-person__name">
                            @context.NombreCompleto
                            @if (context.EsYo)
                            {
                                <span class="sage-chip sage-chip--muted">Vos</span>
                            }
                        </span>
                        <span class="sage-person__mail">@context.Correo</span>
                    </div>
                </MudTd>
                @if (UsuarioActual.EsOperador)
                {
                    <MudTd DataLabel="Empresas">
                        <div class="sage-chips">
                            @foreach (var empresa in context.Empresas)
                            {
                                <span class="sage-chip">@empresa</span>
                            }
                        </div>
                    </MudTd>
                }
                else
                {
                    <MudTd DataLabel="Rol">
                        <span class="sage-chip @ClaseRol(context.Rol)">
                            @(context.Rol == "Tecnico" ? "Técnico" : context.Rol)
                        </span>
                    </MudTd>
                }
                <MudTd DataLabel="Estado">
                    <span class="sage-chip @(context.Activo ? "sage-chip--ok" : "sage-chip--off")">
                        @(context.Activo ? "Activo" : "Inactivo")
                    </span>
                </MudTd>
                <MudTd DataLabel="Acciones">
                    @if (context.SoloLectura)
                    {
                        <span class="sage-person__mail">Lo gestiona SAGE</span>
                    }
                    else
                    {
                        <div class="sage-row-actions">
                            @if (UsuarioActual.EsOperador)
                            {
                                <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                                           OnClick="@(() => GestionarEmpresas(context))"
                                           Disabled="@(_cargando || _ocupado)">
                                    Empresas
                                </MudButton>
                            }
                            else
                            {
                                <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                                           OnClick="@(() => EditarUsuario(context))"
                                           Disabled="@(_cargando || _ocupado)">
                                    Editar
                                </MudButton>
                            }

                            <MudButton Variant="Variant.Text"
                                       Color="@(context.Activo ? Color.Warning : Color.Success)"
                                       Size="Size.Small"
                                       OnClick="@(() => CambiarEstado(context))"
                                       Disabled="@(_cargando || _ocupado || context.EsYo)">
                                @(context.Activo ? "Desactivar" : "Activar")
                            </MudButton>

                            <MudButton Variant="Variant.Text" Color="Color.Default" Size="Size.Small"
                                       OnClick="@(() => RestablecerContrasena(context))"
                                       Disabled="@(_cargando || _ocupado)">
                                Contraseña
                            </MudButton>
                        </div>
                    }
                </MudTd>
            </RowTemplate>

            <NoRecordsContent>
                <div class="sage-empty">
                    <p class="sage-empty__title">Sin resultados</p>
                    <p class="sage-empty__text">Probá otra búsqueda o creá un usuario nuevo.</p>
                </div>
            </NoRecordsContent>

            <PagerContent>
                <MudTablePager RowsPerPageString="Filas por página"
                               InfoFormat="{first_item}-{last_item} de {all_items}" />
            </PagerContent>
        </MudTable>
    </div>
</div>

@code {
    private List<UsuarioFila> _usuarios = new();
    private string _busqueda = string.Empty;
    private bool _cargando = true;
    private bool _ocupado;
    private string? _error;

    private IEnumerable<UsuarioFila> UsuariosFiltrados =>
        _usuarios.Where(u =>
            string.IsNullOrWhiteSpace(_busqueda) ||
            u.NombreCompleto.Contains(_busqueda.Trim(), StringComparison.OrdinalIgnoreCase) ||
            u.Correo.Contains(_busqueda.Trim(), StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        await UsuarioActual.CargarAsync();
        await CargarUsuarios();
    }

    private async Task CargarUsuarios()
    {
        _cargando = true;
        _error = null;
        _usuarios = new();

        try
        {
            using var scope = ScopeFactory.CreateScope();
            var db = scope.ServiceProvider.GetRequiredService<ApplicationDbContext>();
            var userManager = scope.ServiceProvider.GetRequiredService<UserManager<ApplicationUser>>();

            var adminRoleId = await db.Roles
                .Where(r => r.Name == DatosIniciales.RolAdministrador)
                .Select(r => r.Id).FirstOrDefaultAsync();
            var operadorRoleId = await db.Roles
                .Where(r => r.Name == DatosIniciales.RolOperador)
                .Select(r => r.Id).FirstOrDefaultAsync();

            if (UsuarioActual.EsOperador)
            {
                var adminIds = await db.UserRoles
                    .Where(ur => ur.RoleId == adminRoleId)
                    .Select(ur => ur.UserId).ToListAsync();

                var usuarios = await db.Users.AsNoTracking()
                    .Where(u => adminIds.Contains(u.Id))
                    .Include(u => u.Empresas).ThenInclude(ue => ue.Empresa)
                    .OrderBy(u => u.NombreCompleto)
                    .ToListAsync();

                foreach (var u in usuarios)
                {
                    _usuarios.Add(new UsuarioFila
                    {
                        Id = u.Id,
                        NombreCompleto = u.NombreCompleto,
                        Correo = u.Email ?? string.Empty,
                        Rol = DatosIniciales.RolAdministrador,
                        Activo = u.Activo,
                        Empresas = u.Empresas.Select(ue => ue.Empresa.Nombre).OrderBy(n => n).ToList(),
                        EmpresaIds = u.Empresas.Select(ue => ue.EmpresaId).ToList(),
                        SoloLectura = false,
                        EsYo = false
                    });
                }
            }
            else
            {
                if (UsuarioActual.EmpresaActivaId is not int empresaActiva)
                {
                    _error = "No tenés una empresa activa.";
                    return;
                }

                var empresasVisibles = UsuarioActual.Empresas.Select(e => e.Id).ToArray();
                var operadorIds = await db.UserRoles
                    .Where(ur => ur.RoleId == operadorRoleId)
                    .Select(ur => ur.UserId).ToListAsync();

                var usuarios = await db.Users.AsNoTracking()
                    .Where(u => u.Empresas.Any(ue => ue.EmpresaId == empresaActiva) && !operadorIds.Contains(u.Id))
                    .Include(u => u.Empresas.Where(ue => empresasVisibles.Contains(ue.EmpresaId)))
                    .ThenInclude(ue => ue.Empresa)
                    .OrderBy(u => u.NombreCompleto)
                    .ToListAsync();

                foreach (var u in usuarios)
                {
                    var roles = await userManager.GetRolesAsync(u);
                    var rol = roles.FirstOrDefault() ?? "Sin rol";
                    var esYo = u.Id == UsuarioActual.UsuarioId;
                    var esOtroAdmin = rol == DatosIniciales.RolAdministrador && !esYo;

                    _usuarios.Add(new UsuarioFila
                    {
                        Id = u.Id,
                        NombreCompleto = u.NombreCompleto,
                        Correo = u.Email ?? string.Empty,
                        Rol = rol,
                        Activo = u.Activo,
                        Empresas = u.Empresas.Select(ue => ue.Empresa.Nombre).OrderBy(n => n).ToList(),
                        EmpresaIds = u.Empresas.Select(ue => ue.EmpresaId).ToList(),
                        SoloLectura = esOtroAdmin,
                        EsYo = esYo
                    });
                }
            }
        }
        catch
        {
            _error = "No se pudieron cargar los usuarios.";
        }
        finally
        {
            _cargando = false;
        }
    }

    private async Task<List<EmpresaOpcion>> EmpresasParaCrearAsync()
    {
        if (UsuarioActual.EsOperador)
        {
            using var scope = ScopeFactory.CreateScope();
            var db = scope.ServiceProvider.GetRequiredService<ApplicationDbContext>();
            return await db.Empresas.AsNoTracking()
                .Where(e => e.Activa)
                .OrderBy(e => e.Nombre)
                .Select(e => new EmpresaOpcion(e.Id, e.Nombre))
                .ToListAsync();
        }

        return UsuarioActual.Empresas.ToList();
    }

    private async Task NuevoUsuario()
    {
        var empresas = await EmpresasParaCrearAsync();
        var modelo = new UsuarioFormModel
        {
            Rol = UsuarioActual.EsOperador ? "Administrador" : "Tecnico",
            EmpresaId = UsuarioActual.EsOperador
                ? empresas.FirstOrDefault()?.Id
                : (UsuarioActual.EmpresaActivaId ?? empresas.FirstOrDefault()?.Id)
        };

        await AbrirFormulario(
            UsuarioActual.EsOperador ? "NuevoAdministrador" : "NuevoUsuario",
            modelo,
            empresas,
            UsuarioActual.EsOperador ? "Nuevo administrador" : "Nuevo usuario");
    }

    private Task EditarUsuario(UsuarioFila usuario)
    {
        var modelo = new UsuarioFormModel
        {
            Id = usuario.Id,
            NombreCompleto = usuario.NombreCompleto,
            Correo = usuario.Correo,
            Rol = usuario.Rol == "Consulta" ? "Consulta" : "Tecnico"
        };

        return AbrirFormulario("Editar", modelo, new(), "Editar usuario");
    }

    private async Task AbrirFormulario(string modo, UsuarioFormModel modelo, List<EmpresaOpcion> empresas, string titulo)
    {
        var parametros = new DialogParameters<UsuarioDialog>
        {
            { x => x.Modo, modo },
            { x => x.Modelo, modelo },
            { x => x.EmpresasDisponibles, empresas }
        };

        var opciones = new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Small, CloseButton = true };
        var dialogo = await DialogService.ShowAsync<UsuarioDialog>(titulo, parametros, opciones);
        var resultado = await dialogo.Result;

        if (resultado is not null && !resultado.Canceled)
        {
            await CargarUsuarios();
        }
    }

    private async Task GestionarEmpresas(UsuarioFila usuario)
    {
        var parametros = new DialogParameters<EmpresasAdminDialog>
        {
            { x => x.AdministradorId, usuario.Id },
            { x => x.NombreAdministrador, usuario.NombreCompleto }
        };

        var opciones = new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Small, CloseButton = true };
        var dialogo = await DialogService.ShowAsync<EmpresasAdminDialog>("Empresas del administrador", parametros, opciones);
        var resultado = await dialogo.Result;

        if (resultado is not null && !resultado.Canceled && resultado.Data is true)
        {
            await CargarUsuarios();
        }
    }

    private async Task CambiarEstado(UsuarioFila fila)
    {
        if (_ocupado)
            return;

        if (fila.EsYo)
        {
            Snackbar.Add("No podés desactivar tu propia cuenta.", Severity.Warning);
            return;
        }

        _ocupado = true;
        try
        {
            var nuevoEstado = !fila.Activo;
            var accion = nuevoEstado ? "activar" : "desactivar";

            var parametros = new DialogParameters
            {
                ["Contenido"] = $"¿Querés {accion} al usuario {fila.NombreCompleto}?"
            };
            var dialogo = await DialogService.ShowAsync<
                SAGE.Web.Components.Pages.Empresas.ConfirmDialog>("Confirmar cambio de estado", parametros);
            var confirmacion = await dialogo.Result;
            if (confirmacion is null || confirmacion.Canceled)
                return;

            using var scope = ScopeFactory.CreateScope();
            var userManager = scope.ServiceProvider.GetRequiredService<UserManager<ApplicationUser>>();

            if (!UsuarioActual.EsOperador && !UsuarioActual.EsAdministrador)
            {
                Snackbar.Add("No tenés permiso para modificar usuarios.", Severity.Error);
                return;
            }

            var usuario = await userManager.FindByIdAsync(fila.Id);
            if (usuario is null)
            {
                Snackbar.Add("El usuario ya no existe.", Severity.Error);
                return;
            }

            var db = scope.ServiceProvider.GetRequiredService<ApplicationDbContext>();
            var roles = await userManager.GetRolesAsync(usuario);
            if (await ReglasUsuarios.ErrorDeGestionAsync(db, UsuarioActual, usuario.Id, roles,
                    AccionUsuario.CambiarEstado) is { } error)
            {
                Snackbar.Add(error, Severity.Error);
                return;
            }

            usuario.Activo = nuevoEstado;
            if (!(await userManager.UpdateAsync(usuario)).Succeeded)
            {
                Snackbar.Add("No se pudo cambiar el estado.", Severity.Error);
                return;
            }

            await userManager.UpdateSecurityStampAsync(usuario);

            Snackbar.Add(nuevoEstado ? "Usuario activado." : "Usuario desactivado.", Severity.Success);
            await CargarUsuarios();
        }
        catch
        {
            Snackbar.Add("No se pudo cambiar el estado del usuario.", Severity.Error);
        }
        finally
        {
            _ocupado = false;
        }
    }

    private async Task RestablecerContrasena(UsuarioFila usuario)
    {
        var parametros = new DialogParameters
        {
            [nameof(RestablecerContrasenaDialog.UsuarioId)] = usuario.Id,
            [nameof(RestablecerContrasenaDialog.Correo)] = usuario.Correo
        };
        var opciones = new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Small, CloseButton = true };
        var dialogo = await DialogService.ShowAsync<RestablecerContrasenaDialog>("Restablecer contraseña", parametros, opciones);
        await dialogo.Result;
    }

    private static string ClaseRol(string rol) => rol switch
    {
        "Administrador" => "",
        "Tecnico" => "sage-chip--warn",
        "Consulta" => "sage-chip--info",
        _ => "sage-chip--muted"
    };

    private sealed class UsuarioFila
    {
        public string Id { get; set; } = string.Empty;
        public string NombreCompleto { get; set; } = string.Empty;
        public string Correo { get; set; } = string.Empty;
        public string Rol { get; set; } = string.Empty;
        public bool Activo { get; set; }
        public List<string> Empresas { get; set; } = new();
        public List<int> EmpresaIds { get; set; } = new();
        public bool SoloLectura { get; set; }
        public bool EsYo { get; set; }
    }
}
