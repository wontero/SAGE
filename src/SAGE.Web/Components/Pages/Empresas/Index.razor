@page "/empresas"
@attribute [Authorize(Roles = "Operador")]
@using Microsoft.EntityFrameworkCore
@inject IServiceScopeFactory ScopeFactory
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Empresas — SAGE</PageTitle>

<div class="page">
    <header class="page-head">
        <div class="page-head__text">
            <p class="page-kicker">Operador SAGE</p>
            <h1 class="page-title">Empresas</h1>
            <p class="page-meta">Clientes del servicio y sus administradores</p>
        </div>
        <div class="page-actions">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="AbrirNueva">
                Nueva empresa
            </MudButton>
        </div>
    </header>

    <div class="sage-metrics" aria-label="Resumen de empresas">
        <div class="sage-metric">
            <span class="sage-metric__label">Activas</span>
            <span class="sage-metric__value">@_empresas.Count(e => e.Activa)</span>
        </div>
        <div class="sage-metric">
            <span class="sage-metric__label">Inactivas</span>
            <span class="sage-metric__value">@_empresas.Count(e => !e.Activa)</span>
        </div>
        <div class="sage-metric">
            <span class="sage-metric__label">Administradores</span>
            <span class="sage-metric__value">@_empresas.Sum(e => e.CantidadAdministradores)</span>
        </div>
        <div class="sage-metric">
            <span class="sage-metric__label">Usuarios</span>
            <span class="sage-metric__value">@_empresas.Sum(e => e.CantidadUsuarios)</span>
        </div>
    </div>

    <div class="page-filters">
        <MudTextField @bind-Value="_busqueda"
                      Label="Buscar por nombre o NIT"
                      Variant="Variant.Outlined"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Immediate="true"
                      DebounceInterval="300"
                      OnDebounceIntervalElapsed="Recargar" />
    </div>

    <div class="page-panel">
        <MudTable Items="_empresas" Dense="true" Hover="true" Loading="_cargando" Breakpoint="Breakpoint.Sm" Elevation="0">
            <HeaderContent>
                <MudTh>Empresa</MudTh>
                <MudTh>NIT</MudTh>
                <MudTh>Teléfono</MudTh>
                <MudTh>Admins</MudTh>
                <MudTh>Usuarios</MudTh>
                <MudTh>Estado</MudTh>
                <MudTh>Acciones</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Empresa">
                    <div class="sage-person">
                        <span class="sage-person__name">@context.Nombre</span>
                        @if (!string.IsNullOrWhiteSpace(context.CorreoContacto))
                        {
                            <span class="sage-person__mail">@context.CorreoContacto</span>
                        }
                    </div>
                </MudTd>
                <MudTd DataLabel="NIT">@context.Nit</MudTd>
                <MudTd DataLabel="Teléfono">@(context.Telefono ?? "—")</MudTd>
                <MudTd DataLabel="Admins">@context.CantidadAdministradores</MudTd>
                <MudTd DataLabel="Usuarios">@context.CantidadUsuarios</MudTd>
                <MudTd DataLabel="Estado">
                    <span class="sage-chip @(context.Activa ? "sage-chip--ok" : "sage-chip--off")">
                        @(context.Activa ? "Activa" : "Inactiva")
                    </span>
                </MudTd>
                <MudTd DataLabel="Acciones">
                    <div class="sage-row-actions">
                        <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                                   OnClick="@(() => AbrirEditar(context))">Editar</MudButton>
                        <MudButton Variant="Variant.Text"
                                   Color="@(context.Activa ? Color.Warning : Color.Success)"
                                   Size="Size.Small"
                                   OnClick="@(() => CambiarEstado(context))">
                            @(context.Activa ? "Desactivar" : "Activar")
                        </MudButton>
                    </div>
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <div class="sage-empty">
                    <p class="sage-empty__title">Sin empresas</p>
                    <p class="sage-empty__text">Creá la primera empresa cliente para empezar.</p>
                </div>
            </NoRecordsContent>
        </MudTable>
    </div>
</div>

@code {
    private List<EmpresaListaItem> _empresas = new();
    private string _busqueda = string.Empty;
    private bool _cargando;

    protected override async Task OnInitializedAsync() => await Recargar();

    private async Task Recargar()
    {
        _cargando = true;
        try
        {
            await using var scope = ScopeFactory.CreateAsyncScope();
            var db = scope.ServiceProvider.GetRequiredService<ApplicationDbContext>();
            var query = db.Empresas.AsNoTracking().AsQueryable();
            if (!string.IsNullOrWhiteSpace(_busqueda))
            {
                var termino = _busqueda.Trim();
                query = query.Where(e => e.Nombre.Contains(termino) || e.Nit.Contains(termino));
            }

            // Usuarios vinculados con rol Administrador (Identity guarda los roles aparte).
            var adminRoleId = await db.Roles
                .Where(r => r.Name == DatosIniciales.RolAdministrador)
                .Select(r => r.Id)
                .FirstOrDefaultAsync();

            var adminUserIds = db.UserRoles
                .Where(ur => ur.RoleId == adminRoleId)
                .Select(ur => ur.UserId);

            _empresas = await query
                .OrderBy(e => e.Nombre)
                .Select(e => new EmpresaListaItem
                {
                    Id = e.Id,
                    Nombre = e.Nombre,
                    Nit = e.Nit,
                    Telefono = e.Telefono,
                    Activa = e.Activa,
                    Direccion = e.Direccion,
                    CorreoContacto = e.CorreoContacto,
                    CantidadUsuarios = e.Usuarios.Count,
                    CantidadAdministradores = e.Usuarios.Count(ue => adminUserIds.Contains(ue.UsuarioId))
                })
                .ToListAsync();
        }
        finally
        {
            _cargando = false;
        }
    }

    private async Task AbrirNueva()
    {
        var parameters = new DialogParameters<EmpresaDialog>
        {
            { x => x.Modelo, new EmpresaFormModel() }
        };
        var dialog = await DialogService.ShowAsync<EmpresaDialog>("Nueva empresa", parameters);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled)
        {
            await Recargar();
        }
    }

    private async Task AbrirEditar(EmpresaListaItem item)
    {
        var parameters = new DialogParameters<EmpresaDialog>
        {
            {
                x => x.Modelo, new EmpresaFormModel
                {
                    Id = item.Id,
                    Nombre = item.Nombre,
                    Nit = item.Nit,
                    Telefono = item.Telefono,
                    Direccion = item.Direccion,
                    CorreoContacto = item.CorreoContacto
                }
            }
        };
        var dialog = await DialogService.ShowAsync<EmpresaDialog>("Editar empresa", parameters);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled)
        {
            await Recargar();
        }
    }

    private async Task CambiarEstado(EmpresaListaItem item)
    {
        var accion = item.Activa ? "desactivar" : "activar";
        var contenido = $"¿Seguro que deseas {accion} la empresa \"{item.Nombre}\"?";
        if (item.Activa)
        {
            contenido += " Sus usuarios que no tengan otra empresa activa no podrán iniciar sesión.";
        }

        var parameters = new DialogParameters<ConfirmDialog>
        {
            { x => x.Contenido, contenido }
        };
        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Confirmar", parameters);
        var result = await dialog.Result;
        if (result is null || result.Canceled)
        {
            return;
        }

        await using var scope = ScopeFactory.CreateAsyncScope();
        var db = scope.ServiceProvider.GetRequiredService<ApplicationDbContext>();
        var empresa = await db.Empresas.FindAsync(item.Id);
        if (empresa is null)
        {
            Snackbar.Add("La empresa ya no existe.", Severity.Error);
            return;
        }

        empresa.Activa = !empresa.Activa;
        await db.SaveChangesAsync();
        Snackbar.Add(empresa.Activa ? "Empresa activada." : "Empresa desactivada.", Severity.Success);
        await Recargar();
    }

    private sealed class EmpresaListaItem
    {
        public int Id { get; set; }
        public string Nombre { get; set; } = string.Empty;
        public string Nit { get; set; } = string.Empty;
        public string? Telefono { get; set; }
        public string? Direccion { get; set; }
        public string? CorreoContacto { get; set; }
        public bool Activa { get; set; }
        public int CantidadUsuarios { get; set; }
        public int CantidadAdministradores { get; set; }
    }
}
