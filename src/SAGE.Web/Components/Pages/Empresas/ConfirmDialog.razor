<MudDialog>
    <DialogContent>
        <MudText>@Contenido</MudText>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancelar">No</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Aceptar">Sí</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public string Contenido { get; set; } = string.Empty;

    private void Cancelar() => MudDialog.Cancel();

    private void Aceptar() => MudDialog.Close(DialogResult.Ok(true));
}
