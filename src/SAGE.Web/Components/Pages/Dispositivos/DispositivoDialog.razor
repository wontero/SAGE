@using Microsoft.EntityFrameworkCore
@using Microsoft.Extensions.DependencyInjection
@using SAGE.Web.Servicios.Seguridad
@inject IServiceScopeFactory ScopeFactory
@inject IUsuarioActual UsuarioActual
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <EditForm EditContext="_editContext">
            <DataAnnotationsValidator />

            <MudStack Spacing="3">
                @if (UsuarioActual.EmpresaActiva is not null)
                {
                    <MudAlert Severity="Severity.Info" Dense="true">
                        Empresa: <b>@UsuarioActual.EmpresaActiva.Nombre</b>
                    </MudAlert>
                }

                <MudTextField T="string"
                              @bind-Value="_modelo.Nombre"
                              Label="Nombre del dispositivo"
                              Variant="Variant.Outlined"
                              For="@(() => _modelo.Nombre)" />

                <MudTextField T="string"
                              @bind-Value="_modelo.Descripcion"
                              Label="Descripción"
                              Variant="Variant.Outlined"
                              Lines="3"
                              For="@(() => _modelo.Descripcion)" />

                <MudCheckBox T="bool"
                             @bind-Value="_modelo.EsSimulado"
                             Label="Es un dispositivo simulado"
                             Color="Color.Primary" />

                <MudAlert Severity="Severity.Info">
                    @(_modelo.EsSimulado ? "Se identificará como SIMULADO." : "Se identificará como REAL.")
                </MudAlert>

                @if (_modelo.Id is null)
                {
                    <MudText Typo="Typo.body2">
                        Al crear el dispositivo se generará un token que podrás copiar una sola vez.
                    </MudText>
                }

                <ValidationSummary />

                @if (!string.IsNullOrWhiteSpace(_error))
                {
                    <MudAlert Severity="Severity.Error">@_error</MudAlert>
                }
            </MudStack>
        </EditForm>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Cancelar" Disabled="_guardando">Cancelar</MudButton>
        <MudButton OnClick="Guardar"
                   Color="Color.Primary"
                   Variant="Variant.Filled"
                   Disabled="@(_guardando)">
            @(_guardando ? "Guardando..." : "Guardar")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public DispositivoFormModel Modelo { get; set; } = new();

    private DispositivoFormModel _modelo = new();
    private EditContext _editContext = default!;
    private bool _guardando;
    private string? _error;

    protected override void OnInitialized()
    {
        _modelo = new DispositivoFormModel
        {
            Id = Modelo.Id,
            EmpresaId = Modelo.EmpresaId ?? UsuarioActual.EmpresaActivaId,
            Nombre = Modelo.Nombre,
            Descripcion = Modelo.Descripcion,
            EsSimulado = Modelo.EsSimulado
        };

        _editContext = new EditContext(_modelo);
    }

    private void Cancelar() => MudDialog.Cancel();

    private async Task Guardar()
    {
        if (_guardando)
            return;

        _error = null;
        _modelo.Nombre = _modelo.Nombre.Trim();

        // Siempre se usa la empresa activa (ya no hay selector).
        _modelo.EmpresaId = UsuarioActual.EmpresaActivaId;

        if (!_editContext.Validate())
            return;

        _guardando = true;
        try
        {
            if (!UsuarioActual.EsAdministrador)
            {
                _error = "No tenés permiso para administrar dispositivos.";
                return;
            }

            if (_modelo.EmpresaId is not int empresaId || !UsuarioActual.PuedeVerEmpresa(empresaId))
            {
                _error = "No tenés una empresa activa válida.";
                return;
            }

            using var scope = ScopeFactory.CreateScope();
            var db = scope.ServiceProvider.GetRequiredService<ApplicationDbContext>();

            var empresaActiva = await db.Empresas.AnyAsync(e => e.Id == empresaId && e.Activa);
            if (!empresaActiva)
            {
                _error = "La empresa activa no existe o está inactiva.";
                return;
            }

            string? tokenGenerado = null;

            if (_modelo.Id is null)
            {
                tokenGenerado = TokenDispositivo.Generar();
                db.Dispositivos.Add(new Dispositivo
                {
                    EmpresaId = empresaId,
                    Nombre = _modelo.Nombre,
                    Descripcion = string.IsNullOrWhiteSpace(_modelo.Descripcion) ? null : _modelo.Descripcion.Trim(),
                    EsSimulado = _modelo.EsSimulado,
                    TokenHash = TokenDispositivo.CalcularHash(tokenGenerado),
                    Activo = true,
                    FechaRegistro = DateTime.UtcNow
                });
            }
            else
            {
                var dispositivo = await db.Dispositivos.FindAsync(_modelo.Id.Value);
                if (dispositivo is null || !UsuarioActual.PuedeVerEmpresa(dispositivo.EmpresaId))
                {
                    _error = "El dispositivo ya no existe.";
                    return;
                }

                dispositivo.Nombre = _modelo.Nombre;
                dispositivo.Descripcion = string.IsNullOrWhiteSpace(_modelo.Descripcion) ? null : _modelo.Descripcion.Trim();
                dispositivo.EsSimulado = _modelo.EsSimulado;
                // La empresa del dispositivo no cambia desde esta pantalla.
            }

            await db.SaveChangesAsync();

            Snackbar.Add(_modelo.Id is null ? "Dispositivo creado correctamente." : "Dispositivo actualizado correctamente.", Severity.Success);
            MudDialog.Close(DialogResult.Ok(tokenGenerado));
        }
        catch
        {
            _error = "No se pudo guardar el dispositivo. Verificá la conexión e intentá nuevamente.";
        }
        finally
        {
            _guardando = false;
        }
    }
}
