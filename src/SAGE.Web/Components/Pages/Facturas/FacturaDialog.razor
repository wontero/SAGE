@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using SAGE.Web.Servicios.Seguridad
@inject IServiceScopeFactory ScopeFactory
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IUsuarioActual UsuarioActual
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudStack Spacing="2">
            @if (UsuarioActual.EmpresaActiva is not null)
            {
                <MudAlert Severity="Severity.Info" Dense="true">
                    Empresa: <b>@UsuarioActual.EmpresaActiva.Nombre</b>
                </MudAlert>
            }

            <MudStack Row="true" Spacing="2">
                <MudSelect T="int" @bind-Value="_mes" Label="Mes" Variant="Variant.Outlined" Required="true">
                    @foreach (var m in Enumerable.Range(1, 12))
                    {
                        <MudSelectItem T="int" Value="@m">@FacturaReglas.NombreMes(m)</MudSelectItem>
                    }
                </MudSelect>
                <MudNumericField T="int" @bind-Value="_anio" Label="Año" Variant="Variant.Outlined" Min="2000" Max="2100" HideSpinButtons="true" />
            </MudStack>

            <MudNumericField T="decimal" @bind-Value="_kwh" Label="Consumo (kWh)" Variant="Variant.Outlined" Min="0" HideSpinButtons="true" />
            <MudNumericField T="decimal" @bind-Value="_monto" Label="Monto (Bs)" Variant="Variant.Outlined" Min="0" HideSpinButtons="true" />

            @if (!string.IsNullOrEmpty(_error))
            {
                <MudAlert Severity="Severity.Error">@_error</MudAlert>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancelar">Cancelar</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Guardar" Disabled="_guardando">
            Guardar
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    private int _mes = FacturaReglas.HoyLocal().Month;
    private int _anio = FacturaReglas.HoyLocal().Year;
    private decimal _kwh;
    private decimal _monto;
    private string? _error;
    private bool _guardando;

    private void Cancelar() => MudDialog.Cancel();

    private async Task Guardar()
    {
        _error = null;
        _guardando = true;
        try
        {
            // Los permisos se vuelven a comprobar aquí: no basta con ocultar el botón.
            if (!UsuarioActual.EsAdministrador && !UsuarioActual.EsTecnico)
            {
                _error = "No tienes permiso para registrar facturas.";
                return;
            }

            await using var scope = ScopeFactory.CreateAsyncScope();
            var usuarios = scope.ServiceProvider.GetRequiredService<UserManager<ApplicationUser>>();
            var db = scope.ServiceProvider.GetRequiredService<ApplicationDbContext>();
            var auth = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var usuario = await usuarios.GetUserAsync(auth.User);
            if (usuario is null)
            {
                _error = "No se pudo identificar al usuario.";
                return;
            }

            // Siempre se usa la empresa activa, y se reverifica el acceso en el servidor.
            if (UsuarioActual.EmpresaActivaId is not int empresaId || !UsuarioActual.PuedeVerEmpresa(empresaId))
            {
                _error = "No tienes una empresa activa válida.";
                return;
            }

            var motivo = FacturaReglas.Validar(_anio, _mes, _kwh, _monto);
            if (motivo is not null)
            {
                _error = char.ToUpperInvariant(motivo[0]) + motivo[1..] + ".";
                return;
            }

            var empresaActiva = await db.Empresas.AnyAsync(e => e.Id == empresaId && e.Activa);
            if (!empresaActiva)
            {
                _error = "La empresa no existe o está inactiva.";
                return;
            }

            var repetida = await db.Facturas.AnyAsync(f =>
                f.EmpresaId == empresaId && f.Anio == _anio && f.Mes == _mes);
            if (repetida)
            {
                _error = "Ya existe la factura de ese mes";
                return;
            }

            db.Facturas.Add(new Factura
            {
                EmpresaId = empresaId,
                Anio = _anio,
                Mes = _mes,
                ConsumoKwh = _kwh,
                MontoBs = _monto,
                Origen = OrigenFactura.Manual,
                RegistradaPorId = usuario.Id,
                FechaRegistro = DateTime.UtcNow
            });

            try
            {
                await db.SaveChangesAsync();
            }
            catch (DbUpdateException)
            {
                _error = "Ya existe la factura de ese mes";
                return;
            }

            Snackbar.Add("Factura registrada.", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        finally
        {
            _guardando = false;
        }
    }
}
