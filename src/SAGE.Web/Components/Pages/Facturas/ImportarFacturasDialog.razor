@using System.Globalization
@using System.Text
@using ClosedXML.Excel
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext Db
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudStack Spacing="2">
            <MudText Typo="Typo.body2">
                Sube un archivo .xlsx (máximo 1 MB) con los encabezados
                <b>Año | Mes | Consumo (kWh) | Monto (Bs)</b>, una factura por fila.
                Si alguna fila tiene errores, no se guarda ninguna.
            </MudText>

            @if (EsAdmin)
            {
                <MudSelect T="int?" @bind-Value="_empresaId" Label="Empresa destino" Variant="Variant.Outlined" Required="true">
                    @foreach (var empresa in Empresas)
                    {
                        <MudSelectItem T="int?" Value="@((int?)empresa.Id)">@empresa.Nombre</MudSelectItem>
                    }
                </MudSelect>
            }

            <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap">
                <MudButton HtmlTag="label"
                           for="archivo-facturas"
                           Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.UploadFile"
                           Disabled="_procesando">
                    Elegir archivo .xlsx
                </MudButton>
                <InputFile id="archivo-facturas" OnChange="Importar" accept=".xlsx" hidden />

                <MudButton Href="/facturas/plantilla"
                           Variant="Variant.Outlined"
                           StartIcon="@Icons.Material.Filled.Download"
                           download="plantilla_facturas.xlsx">
                    Descargar plantilla
                </MudButton>
            </MudStack>

            @if (_procesando)
            {
                <MudProgressLinear Indeterminate="true" />
            }

            @if (_importadas is int n)
            {
                <MudAlert Severity="Severity.Success">Se importaron @n facturas</MudAlert>
            }

            @if (_errores.Count > 0)
            {
                <MudAlert Severity="Severity.Error">
                    No se importó ninguna factura. Corrige estos errores y vuelve a subir el archivo:
                </MudAlert>
                <MudPaper Outlined="true" Class="pa-2" Style="max-height: 220px; overflow-y: auto;">
                    @foreach (var error in _errores)
                    {
                        <MudText Typo="Typo.body2">• @error</MudText>
                    }
                </MudPaper>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cerrar">Cerrar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private const long MaxBytes = 1024 * 1024;
    private const int MaxFilas = 1000;

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public bool EsAdmin { get; set; }

    [Parameter]
    public List<EmpresaOpcion> Empresas { get; set; } = new();

    private int? _empresaId;
    private int? _importadas;
    private bool _procesando;
    private readonly List<string> _errores = new();

    private void Cerrar() => MudDialog.Close(DialogResult.Ok(_importadas is > 0));

    private async Task Importar(InputFileChangeEventArgs e)
    {
        _errores.Clear();
        _importadas = null;
        _procesando = true;
        try
        {
            var archivo = e.File;

            // Permisos: se vuelven a comprobar aquí (RNF01).
            var auth = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var principal = auth.User;
            var esAdmin = principal.IsInRole("Administrador");
            if (!esAdmin && !principal.IsInRole("Tecnico"))
            {
                _errores.Add("No tienes permiso para importar facturas.");
                return;
            }

            var usuario = await UserManager.GetUserAsync(principal);
            if (usuario is null)
            {
                _errores.Add("No se pudo identificar al usuario.");
                return;
            }

            var empresaId = esAdmin ? _empresaId : usuario.EmpresaId;
            if (empresaId is null)
            {
                _errores.Add(esAdmin ? "Selecciona primero la empresa destino." : "Tu usuario no tiene una empresa asignada.");
                return;
            }

            if (!await Db.Empresas.AnyAsync(x => x.Id == empresaId && x.Activa))
            {
                _errores.Add("La empresa no existe o está inactiva.");
                return;
            }

            if (!archivo.Name.EndsWith(".xlsx", StringComparison.OrdinalIgnoreCase))
            {
                _errores.Add("El archivo debe ser .xlsx.");
                return;
            }

            if (archivo.Size > MaxBytes)
            {
                _errores.Add("El archivo supera el máximo de 1 MB.");
                return;
            }

            using var memoria = new MemoryStream();
            await using (var flujo = archivo.OpenReadStream(MaxBytes))
            {
                await flujo.CopyToAsync(memoria);
            }

            memoria.Position = 0;

            XLWorkbook libro;
            try
            {
                libro = new XLWorkbook(memoria);
            }
            catch (Exception)
            {
                _errores.Add("No se pudo leer el archivo. Verifica que sea un .xlsx válido.");
                return;
            }

            var nuevas = new List<Factura>();

            using (libro)
            {
                var hoja = libro.Worksheets.FirstOrDefault();
                var ultimaFila = hoja?.LastRowUsed()?.RowNumber() ?? 0;

                if (hoja is null || ultimaFila < 2)
                {
                    _errores.Add("El archivo no tiene filas de datos.");
                    return;
                }

                if (ultimaFila - 1 > MaxFilas)
                {
                    _errores.Add($"El archivo tiene demasiadas filas (máximo {MaxFilas}).");
                    return;
                }

                if (!EncabezadosValidos(hoja))
                {
                    _errores.Add("Los encabezados de la primera fila deben ser: Año | Mes | Consumo (kWh) | Monto (Bs).");
                    return;
                }

                var existentes = (await Db.Facturas.AsNoTracking()
                        .Where(f => f.EmpresaId == empresaId)
                        .Select(f => new { f.Anio, f.Mes })
                        .ToListAsync())
                    .Select(f => (f.Anio, f.Mes))
                    .ToHashSet();
                var vistos = new HashSet<(int, int)>();

                for (var fila = 2; fila <= ultimaFila; fila++)
                {
                    var celdas = Enumerable.Range(1, 4).Select(c => hoja.Cell(fila, c)).ToList();
                    if (celdas.All(c => c.IsEmpty()))
                    {
                        continue;
                    }

                    if (!TryEntero(celdas[0], out var anio))
                    {
                        _errores.Add($"Fila {fila}: el año no es un número válido.");
                        continue;
                    }

                    if (!TryEntero(celdas[1], out var mes))
                    {
                        _errores.Add($"Fila {fila}: el mes no es un número válido.");
                        continue;
                    }

                    if (!TryDecimal(celdas[2], out var kwh))
                    {
                        _errores.Add($"Fila {fila}: el consumo (kWh) no es un número válido.");
                        continue;
                    }

                    if (!TryDecimal(celdas[3], out var monto))
                    {
                        _errores.Add($"Fila {fila}: el monto no es un número válido.");
                        continue;
                    }

                    var motivo = FacturaReglas.Validar(anio, mes, kwh, monto);
                    if (motivo is not null)
                    {
                        _errores.Add($"Fila {fila}: {motivo}.");
                        continue;
                    }

                    if (existentes.Contains((anio, mes)))
                    {
                        _errores.Add($"Fila {fila}: el mes {mes}/{anio} ya está registrado.");
                        continue;
                    }

                    if (!vistos.Add((anio, mes)))
                    {
                        _errores.Add($"Fila {fila}: el mes {mes}/{anio} está repetido en el archivo.");
                        continue;
                    }

                    nuevas.Add(new Factura
                    {
                        EmpresaId = empresaId.Value,
                        Anio = anio,
                        Mes = mes,
                        ConsumoKwh = kwh,
                        MontoBs = monto,
                        Origen = OrigenFactura.Excel,
                        RegistradaPorId = usuario.Id,
                        FechaRegistro = DateTime.UtcNow
                    });
                }
            }

            // Todo o nada: si hubo cualquier error no se guarda ninguna fila.
            if (_errores.Count > 0)
            {
                return;
            }

            if (nuevas.Count == 0)
            {
                _errores.Add("El archivo no tiene filas de datos.");
                return;
            }

            Db.Facturas.AddRange(nuevas);
            try
            {
                await Db.SaveChangesAsync();
            }
            catch (DbUpdateException)
            {
                Db.ChangeTracker.Clear();
                _errores.Add("No se pudo guardar: alguno de los meses ya fue registrado por otra persona. Vuelve a intentarlo.");
                return;
            }

            _importadas = nuevas.Count;
            Snackbar.Add($"Se importaron {nuevas.Count} facturas", Severity.Success);
        }
        catch (IOException)
        {
            _errores.Add("No se pudo leer el archivo (puede superar 1 MB).");
        }
        finally
        {
            _procesando = false;
        }
    }

    private static bool EncabezadosValidos(IXLWorksheet hoja)
    {
        var esperados = new[]
        {
            new[] { "ano", "anio" },
            new[] { "mes" },
            new[] { "consumokwh" },
            new[] { "montobs" }
        };

        for (var i = 0; i < esperados.Length; i++)
        {
            var texto = Normalizar(hoja.Cell(1, i + 1).GetString());
            if (!esperados[i].Contains(texto))
            {
                return false;
            }
        }

        return true;
    }

    private static string Normalizar(string texto)
    {
        var descompuesto = texto.Normalize(NormalizationForm.FormD);
        var sb = new StringBuilder();
        foreach (var c in descompuesto)
        {
            if (CharUnicodeInfo.GetUnicodeCategory(c) == UnicodeCategory.NonSpacingMark)
            {
                continue;
            }

            if (char.IsLetterOrDigit(c))
            {
                sb.Append(char.ToLowerInvariant(c));
            }
        }

        return sb.ToString();
    }

    private static bool TryEntero(IXLCell celda, out int valor)
    {
        valor = 0;
        if (celda.IsEmpty() || !celda.TryGetValue<double>(out var d))
        {
            return false;
        }

        if (d != Math.Floor(d) || d < int.MinValue || d > int.MaxValue)
        {
            return false;
        }

        valor = (int)d;
        return true;
    }

    private static bool TryDecimal(IXLCell celda, out decimal valor)
    {
        valor = 0;
        return !celda.IsEmpty() && celda.TryGetValue<decimal>(out valor);
    }
}
