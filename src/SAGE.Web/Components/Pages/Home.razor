@page "/"
@attribute [Authorize]
@implements IDisposable

@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using MudBlazor
@using SAGE.Web.Data
@using SAGE.Web.Components.Shared
@using SAGE.Web.Servicios
@using SAGE.Web.Servicios.Dispositivo
@using SAGE.Web.Servicios.EnVivo
@using SAGE.Web.Servicios.Energia
@using SAGE.Web.Servicios.Seguridad

@inject IUsuarioActual UsuarioActual
@inject IServiceScopeFactory ScopeFactory
@inject EstadoDispositivosEnVivo EnVivo
@inject CalculadoraEnergia Calculadora
@inject IFabricaDispositivo Fabrica
@inject ILogger<Home> Logger

<PageTitle>Inicio — SAGE</PageTitle>

<div class="page">

    <header class="page-head">
        <div class="page-head__text">
            <p class="page-kicker">@SaludoLocal()</p>
            <h1 class="page-title">@_nombre</h1>
            <p class="page-meta">
                @(_esOperador ? "Operador SAGE" : "Tablero energético")
            </p>
        </div>
    </header>

    @if (_cargando)
    {
        <MudProgressCircular Indeterminate="true"
                             Color="Color.Primary" />
    }
    else if (_error is not null)
    {
        <MudAlert Severity="Severity.Error">
            @_error
        </MudAlert>
    }
    else if (_esOperador)
    {
        <MudGrid Spacing="3">

            <MudItem xs="12" sm="6" md="3">
                <MudPaper Class="pa-4">
                    <MudText Typo="Typo.subtitle2">
                        Empresas activas
                    </MudText>
                    <MudText Typo="Typo.h4">
                        @_empresasActivas
                    </MudText>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <MudPaper Class="pa-4">
                    <MudText Typo="Typo.subtitle2">
                        Empresas inactivas
                    </MudText>
                    <MudText Typo="Typo.h4">
                        @_empresasInactivas
                    </MudText>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <MudPaper Class="pa-4">
                    <MudText Typo="Typo.subtitle2">
                        Administradores
                    </MudText>
                    <MudText Typo="Typo.h4">
                        @_administradores
                    </MudText>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <MudPaper Class="pa-4">
                    <MudText Typo="Typo.subtitle2">
                        Usuarios en total
                    </MudText>
                    <MudText Typo="Typo.h4">
                        @_usuarios
                    </MudText>
                </MudPaper>
            </MudItem>

        </MudGrid>

        <MudPaper Class="pa-4 mt-4">

            <MudText Typo="Typo.h6">
                Empresas y usuarios por rol
            </MudText>

            <MudTable T="FilaOperador"
                      Items="@_filasOperador"
                      Dense="true"
                      Hover="true">

                <HeaderContent>
                    <MudTh>Empresa</MudTh>
                    <MudTh>Estado</MudTh>
                    <MudTh>Administradores</MudTh>
                    <MudTh>Técnicos</MudTh>
                    <MudTh>Consulta</MudTh>
                </HeaderContent>

                <RowTemplate>
                    <MudTd>@context.Nombre</MudTd>
                    <MudTd>
                        @(context.Activa ? "Activa" : "Inactiva")
                    </MudTd>
                    <MudTd>@context.Administradores</MudTd>
                    <MudTd>@context.Tecnicos</MudTd>
                    <MudTd>@context.Consultas</MudTd>
                </RowTemplate>

            </MudTable>

        </MudPaper>
    }
    else
    {
        <MudTabs @bind-ActivePanelIndex="_pestana"
                 Rounded="true"
                 ApplyEffectsToContainer="true">

            <MudTabPanel Text="@_empresaNombre">

                @if (_empresaActiva is not null)
                {
                    <MudGrid Spacing="3" Class="mt-2">

                        <MudItem xs="12" sm="6" md="4">
                            <MudPaper Class="pa-4">
                                <MudText Typo="Typo.subtitle2">
                                    Dispositivos en línea
                                </MudText>
                                <MudText Typo="Typo.h4">
                                    @_empresaActiva.EnLinea /
                                    @_empresaActiva.TotalDispositivos
                                </MudText>
                            </MudPaper>
                        </MudItem>

                        <MudItem xs="12" sm="6" md="4">
                            <MudPaper Class="pa-4">
                                <MudText Typo="Typo.subtitle2">
                                    Potencia solar ahora
                                </MudText>
                                <MudText Typo="Typo.h5">
                                    @Potencia(_empresaActiva.PSolarMw)
                                </MudText>
                            </MudPaper>
                        </MudItem>

                        <MudItem xs="12" sm="6" md="4">
                            <MudPaper Class="pa-4">
                                <MudText Typo="Typo.subtitle2">
                                    Potencia de red ahora
                                </MudText>
                                <MudText Typo="Typo.h5">
                                    @Potencia(_empresaActiva.PRedMw)
                                </MudText>
                            </MudPaper>
                        </MudItem>

                        <MudItem xs="12" sm="6" md="4">
                            <MudPaper Class="pa-4">
                                <MudText Typo="Typo.subtitle2">
                                    Alertas abiertas
                                </MudText>
                                <MudText Typo="Typo.h4">
                                    @_empresaActiva.AlertasAbiertas
                                </MudText>
                            </MudPaper>
                        </MudItem>

                        <MudItem xs="12" sm="6" md="4">
                            <MudPaper Class="pa-4">
                                <MudText Typo="Typo.subtitle2">
                                    Consumo facturado, 12 meses
                                </MudText>
                                <MudText Typo="Typo.h5">
                                    @Numero(_empresaActiva.ConsumoKwh) kWh
                                </MudText>
                            </MudPaper>
                        </MudItem>

                        <MudItem xs="12" sm="6" md="4">
                            <MudPaper Class="pa-4">
                                <MudText Typo="Typo.subtitle2">
                                    Monto facturado, 12 meses
                                </MudText>
                                <MudText Typo="Typo.h5">
                                    @Numero(_empresaActiva.MontoBs) Bs
                                </MudText>
                            </MudPaper>
                        </MudItem>

                    </MudGrid>

                    @if (_empresaActiva.TieneEscala)
                    {
                        <div class="mt-3">
                            <MudChip T="string"
                                     Color="Color.Info"
                                     Variant="Variant.Outlined">
                                Potencia escalada para maqueta
                            </MudChip>
                        </div>
                    }

                    <MudPaper Class="pa-4 mt-4">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                            <MudText Typo="Typo.h6">Energía hoy</MudText>
                            @if (EnergiaSimulada)
                            {
                                <MudChip T="string" Color="Color.Info">SIMULADO</MudChip>
                            }
                            @foreach (var factor in _empresaActiva.Factores)
                            {
                                <ChipEscala Factor="@factor" />
                            }
                        </MudStack>
                        <MudText>Solar · @Formato.Energia(_empresaActiva.WhSolarHoy)</MudText>
                        <MudText>Red · @Formato.Energia(_empresaActiva.WhRedHoy)</MudText>
                    </MudPaper>

                    <MudPaper Class="pa-4 mt-4">

                        <MudText Typo="Typo.h6">
                            Última medición
                        </MudText>

                        @if (_empresaActiva.Dispositivos.Count == 0)
                        {
                            <MudText Class="mt-3">
                                No hay dispositivos activos.
                            </MudText>
                        }
                        else
                        {
                            <MudTable T="TarjetaDispositivo"
                                      Items="@_empresaActiva.Dispositivos"
                                      Dense="true"
                                      Hover="true">

                                <HeaderContent>
                                    <MudTh>Dispositivo</MudTh>
                                    <MudTh>Tipo</MudTh>
                                    <MudTh>Conexión</MudTh>
                                    <MudTh>Fuente</MudTh>
                                    <MudTh>Potencia</MudTh>
                                    <MudTh>Última medición</MudTh>
                                </HeaderContent>

                                <RowTemplate>
                                    <MudTd>@context.Nombre</MudTd>

                                    <MudTd>
                                        @(context.EsSimulado
                                            ? "Simulado" : "Real")
                                    </MudTd>

                                    <MudTd>
                                        <MudChip T="string"
                                                 Size="Size.Small"
                                                 Color="@(context.EnLinea
                                                                                                 ? Color.Success
                                                                                                 : Color.Error)">
                                            @(context.EnLinea
                                                ? "En línea"
                                                : "Sin conexión")
                                        </MudChip>
                                    </MudTd>

                                    <MudTd>
                                        @Formato.Fuente(context.Fuente)
                                    </MudTd>

                                    <MudTd>
                                        @Potencia(context.PotenciaSeleccionadaMw)
                                    </MudTd>

                                    <MudTd>
                                        @Formato.Hace(context.UltimoContacto)
                                    </MudTd>
                                </RowTemplate>

                            </MudTable>
                        }

                    </MudPaper>
                }

            </MudTabPanel>

            @if (UsuarioActual.Empresas.Count >= 2)
            {
                <MudTabPanel Text="Todas mis empresas">

                    <MudPaper Class="pa-4 mt-3">

                        <MudText Typo="Typo.h6">
                            Resumen de mis empresas
                        </MudText>

                        <MudTable T="ResumenEmpresa"
                                  Items="@_resumenes"
                                  Dense="true"
                                  Hover="true"
                                  Breakpoint="Breakpoint.Md">

                            <HeaderContent>
                                <MudTh>Empresa</MudTh>
                                <MudTh>Dispositivos</MudTh>
                                <MudTh>Solar</MudTh>
                                <MudTh>Red</MudTh>
                                <MudTh>Energía hoy</MudTh>
                                <MudTh>Alertas</MudTh>
                                <MudTh>Consumo 12 meses</MudTh>
                                <MudTh>Monto 12 meses</MudTh>
                                <MudTh>Acción</MudTh>
                            </HeaderContent>

                            <RowTemplate>
                                <MudTd DataLabel="Empresa">
                                    @context.Nombre
                                </MudTd>

                                <MudTd DataLabel="Dispositivos">
                                    @context.EnLinea /
                                    @context.TotalDispositivos
                                </MudTd>

                                <MudTd DataLabel="Solar">
                                    @Potencia(context.PSolarMw)
                                </MudTd>

                                <MudTd DataLabel="Red">
                                    @Potencia(context.PRedMw)
                                </MudTd>

                                <MudTd DataLabel="Energía hoy">
                                    <MudText>Solar · @Formato.Energia(context.WhSolarHoy)</MudText>
                                    <MudText>Red · @Formato.Energia(context.WhRedHoy)</MudText>
                                    @foreach (var factor in context.Factores)
                                    {
                                        <ChipEscala Factor="@factor" />
                                    }
                                    @if (EnergiaSimulada)
                                    {
                                        <MudChip T="string" Color="Color.Info">SIMULADO</MudChip>
                                    }
                                </MudTd>

                                <MudTd DataLabel="Alertas">
                                    @context.AlertasAbiertas
                                </MudTd>

                                <MudTd DataLabel="Consumo 12 meses">
                                    @Numero(context.ConsumoKwh) kWh
                                </MudTd>

                                <MudTd DataLabel="Monto 12 meses">
                                    @Numero(context.MontoBs) Bs
                                </MudTd>

                                <MudTd DataLabel="Acción">
                                    <MudButton Size="Size.Small"
                                               Variant="Variant.Text"
                                               Color="Color.Primary"
                                               OnClick="@(() => IrEmpresaAsync(context.EmpresaId))">
                                        Seleccionar
                                    </MudButton>
                                </MudTd>
                            </RowTemplate>

                            @* M8: fila Total dentro de la tabla *@
                            <FooterContent>
                                <MudTh>
                                    <strong>TOTAL</strong>
                                </MudTh>

                                <MudTh>
                                    @_resumenes.Sum(r => r.EnLinea) /
                                    @_resumenes.Sum(r => r.TotalDispositivos)
                                </MudTh>

                                <MudTh>
                                    @Potencia(_resumenes.Sum(r => r.PSolarMw))
                                </MudTh>

                                <MudTh>
                                    @Potencia(_resumenes.Sum(r => r.PRedMw))
                                </MudTh>

                                <MudTh>
                                    <MudText>Solar · @Formato.Energia(_resumenes.Sum(r => r.WhSolarHoy))</MudText>
                                    <MudText>Red · @Formato.Energia(_resumenes.Sum(r => r.WhRedHoy))</MudText>
                                    @foreach (var factor in _resumenes.SelectMany(r => r.Factores).Distinct())
                                    {
                                        <ChipEscala Factor="@factor" />
                                    }
                                    @if (EnergiaSimulada)
                                    {
                                        <MudChip T="string" Color="Color.Info">SIMULADO</MudChip>
                                    }
                                </MudTh>

                                <MudTh>
                                    @_resumenes.Sum(r => r.AlertasAbiertas)
                                </MudTh>

                                <MudTh>
                                    @Numero(_resumenes.Sum(r => r.ConsumoKwh)) kWh
                                </MudTh>

                                <MudTh>
                                    @Numero(_resumenes.Sum(r => r.MontoBs)) Bs
                                </MudTh>

                                <MudTh></MudTh>
                            </FooterContent>

                        </MudTable>

                    </MudPaper>

                    <MudPaper Class="pa-4 mt-4">

                        <MudText Typo="Typo.h6">
                            Potencia actual por empresa
                        </MudText>

                        @if (_resumenes.Count > 0)
                        {
                            <MudChart T="double"
                                      ChartType="ChartType.Bar"
                                      ChartSeries="@_series"
                                      ChartLabels="@_etiquetas"
                                      Width="100%"
                                      Height="320px" />
                        }

                    </MudPaper>

                </MudTabPanel>
            }

        </MudTabs>
    }

</div>

@code {

    private readonly List<ResumenEmpresa> _resumenes = new();

    private ResumenEmpresa? _empresaActiva;

    private List<FilaOperador> _filasOperador = new();

    private List<ChartSeries<double>> _series = new();

    private string[] _etiquetas = [];

    private string _nombre = "usuario";
    private string _empresaNombre = "Mi empresa";

    private bool _esOperador;
    private bool _cargando = true;
    private bool _destruido;
    private bool _actualizandoEnergia;
    private DateTime _proximaEnergiaUtc;
    private bool EnergiaSimulada => Fabrica is FabricaDispositivoSimulado;

    private string? _error;

    private int _pestana;

    private int _empresasActivas;
    private int _empresasInactivas;
    private int _administradores;
    private int _usuarios;

    protected override async Task OnInitializedAsync()
    {
        EnVivo.Cambio += AlCambiarEstado;
        EnVivo.AlertasCambiaron += AlCambiarAlertas;
        UsuarioActual.EmpresaCambiada += AlCambiarEmpresa;

        await UsuarioActual.CargarAsync();

        _nombre = string.IsNullOrWhiteSpace(
            UsuarioActual.NombreCompleto)
            ? "usuario"
            : UsuarioActual.NombreCompleto;

        _esOperador = UsuarioActual.EsOperador;

        await CargarAsync();
    }

    private async Task CargarAsync()
    {
        _cargando = true;
        _error = null;

        try
        {
            if (_esOperador)
            {
                await CargarOperadorAsync();
            }
            else
            {
                await CargarEmpresasAsync();
            }
        }
        catch
        {
            _error = "No se pudo cargar el tablero de Inicio.";
        }
        finally
        {
            _cargando = false;
        }
    }

    private async Task CargarOperadorAsync()
    {
        await using var scope = ScopeFactory.CreateAsyncScope();

        var db = scope.ServiceProvider
            .GetRequiredService<ApplicationDbContext>();

        _empresasActivas =
            await db.Empresas.CountAsync(e => e.Activa);

        _empresasInactivas =
            await db.Empresas.CountAsync(e => !e.Activa);

        _usuarios = await db.Users.CountAsync();

        var administradores = await db.UserRoles
            .Join(
                db.Roles,
                ur => ur.RoleId,
                r => r.Id,
                (ur, r) => new { ur.UserId, r.Name })
            .Where(x => x.Name == "Administrador")
            .Select(x => x.UserId)
            .Distinct()
            .CountAsync();

        _administradores = administradores;

        var empresas = await db.Empresas
            .AsNoTracking()
            .OrderBy(e => e.Nombre)
            .Select(e => new
            {
                e.Id,
                e.Nombre,
                e.Activa
            })
            .ToListAsync();

        _filasOperador.Clear();

        foreach (var empresa in empresas)
        {
            var usuariosEmpresa = db.UsuarioEmpresas
                .Where(ue => ue.EmpresaId == empresa.Id);

            var administradoresEmpresa = await usuariosEmpresa
                .CountAsync(ue =>
                    db.UserRoles.Any(ur =>
                        ur.UserId == ue.UsuarioId &&
                        db.Roles.Any(r =>
                            r.Id == ur.RoleId &&
                            r.Name == "Administrador")));

            var tecnicosEmpresa = await usuariosEmpresa
                .CountAsync(ue =>
                    db.UserRoles.Any(ur =>
                        ur.UserId == ue.UsuarioId &&
                        db.Roles.Any(r =>
                            r.Id == ur.RoleId &&
                            r.Name == "Tecnico")));

            var consultasEmpresa = await usuariosEmpresa
                .CountAsync(ue =>
                    db.UserRoles.Any(ur =>
                        ur.UserId == ue.UsuarioId &&
                        db.Roles.Any(r =>
                            r.Id == ur.RoleId &&
                            r.Name == "Consulta")));

            _filasOperador.Add(new FilaOperador
            {
                Nombre = empresa.Nombre,
                Activa = empresa.Activa,
                Administradores = administradoresEmpresa,
                Tecnicos = tecnicosEmpresa,
                Consultas = consultasEmpresa
            });
        }
    }

    private async Task CargarEmpresasAsync()
    {
        _resumenes.Clear();

        await using var scope = ScopeFactory.CreateAsyncScope();

        var db = scope.ServiceProvider
            .GetRequiredService<ApplicationDbContext>();

        var ahora = DateTime.UtcNow;

        var mesActual = ahora.Year * 12 + ahora.Month;
        var primerMes = mesActual - 11;

        // Solo empresas asignadas al usuario.
        foreach (var empresa in UsuarioActual.Empresas)
        {
            if (!UsuarioActual.PuedeVerEmpresa(empresa.Id))
                continue;

            var resumen = new ResumenEmpresa
            {
                EmpresaId = empresa.Id,
                Nombre = empresa.Nombre
            };

            var dispositivos = await db.Dispositivos
                .AsNoTracking()
                .Where(d =>
                    d.EmpresaId == empresa.Id &&
                    d.Activo)
                .OrderBy(d => d.Nombre)
                .ToListAsync();

            foreach (var dispositivo in dispositivos)
            {
                var tarjeta = new TarjetaDispositivo
                {
                    Id = dispositivo.Id,
                    Nombre = dispositivo.Nombre,
                    EsSimulado = dispositivo.EsSimulado,
                    FactorEscala = dispositivo.FactorEscala,
                    UltimoContacto = dispositivo.UltimoContacto
                };

                resumen.Dispositivos.Add(tarjeta);

                var ultima = await db.Mediciones
                    .AsNoTracking()
                    .Where(m =>
                        m.DispositivoId == dispositivo.Id)
                    .OrderByDescending(m => m.TsServidor)
                    .FirstOrDefaultAsync();

                if (ultima is not null)
                {
                    tarjeta.Actualizar(
                        EstadoDispositivo.Desde(
                            ultima,
                            empresa.Id,
                            dispositivo.FactorEscala));
                }

                tarjeta.EnLinea =
                    dispositivo.UltimoContacto.HasValue &&
                    ahora - dispositivo.UltimoContacto.Value
                        <= TimeSpan.FromSeconds(30);

                var vivo = EnVivo.Obtener(dispositivo.Id);

                if (vivo is not null &&
                    vivo.EmpresaId == empresa.Id)
                {
                    tarjeta.Actualizar(vivo);
                }
            }

            resumen.AlertasAbiertas = await db.Alertas
                .AsNoTracking()
                .CountAsync(a =>
                    a.Dispositivo.EmpresaId == empresa.Id &&
                    a.Activa &&
                    a.Fin == null);

            // Últimos doce meses, por empresa.
            var facturas = await db.Facturas
                .AsNoTracking()
                .Where(f =>
                    f.EmpresaId == empresa.Id &&
                    f.Anio * 12 + f.Mes >= primerMes &&
                    f.Anio * 12 + f.Mes <= mesActual)
                .Select(f => new
                {
                    f.ConsumoKwh,
                    f.MontoBs
                })
                .ToListAsync();

            resumen.ConsumoKwh =
                facturas.Sum(f => f.ConsumoKwh);

            resumen.MontoBs =
                facturas.Sum(f => f.MontoBs);

            resumen.Recalcular();

            _resumenes.Add(resumen);
        }

        SincronizarEmpresaActiva();
        ActualizarGrafico();
        await ActualizarEnergiaAsync(ahora);
    }

    private void SincronizarEmpresaActiva()
    {
        var id = UsuarioActual.EmpresaActivaId;

        _empresaActiva = _resumenes
            .FirstOrDefault(r => r.EmpresaId == id);

        _empresaNombre =
            _empresaActiva?.Nombre ?? "Mi empresa";
    }

    private void AlCambiarEstado(EstadoDispositivo estado)
    {
        if (_destruido || _esOperador)
            return;

        // En consolidado se aceptan las empresas del usuario.
        if (!UsuarioActual.PuedeVerEmpresa(estado.EmpresaId))
            return;

        _ = InvokeAsync(async () =>
        {
            if (_destruido)
                return;

            var resumen = _resumenes
                .FirstOrDefault(r =>
                    r.EmpresaId == estado.EmpresaId);

            var dispositivo = resumen?.Dispositivos
                .FirstOrDefault(d =>
                    d.Id == estado.DispositivoId);

            if (resumen is null || dispositivo is null)
                return;

            dispositivo.Actualizar(estado);

            resumen.Recalcular();
            ActualizarGrafico();

            StateHasChanged();

            var ahora = DateTime.UtcNow;
            if (estado.EnLinea && !_cargando && !_actualizandoEnergia && ahora >= _proximaEnergiaUtc)
            {
                await ActualizarEnergiaAsync(ahora);
                if (!_destruido)
                    StateHasChanged();
            }
        });
    }

    private async Task ActualizarEnergiaAsync(DateTime ahora)
    {
        _actualizandoEnergia = true;
        _proximaEnergiaUtc = ahora.AddSeconds(10);
        try
        {
            var inicio = Formato.DesdeLocal(Formato.ALocal(ahora).Date);
            foreach (var resumen in _resumenes.ToArray())
            {
                decimal solar = 0, red = 0;
                foreach (var dispositivo in resumen.Dispositivos)
                {
                    if (_destruido)
                        return;

                    var energia = await Calculadora.CalcularEmpresaAsync(resumen.EmpresaId, dispositivo.Id, inicio, ahora);
                    solar += energia.WhSolar * dispositivo.FactorEscala;
                    red += energia.WhRed * dispositivo.FactorEscala;
                }

                resumen.WhSolarHoy = solar;
                resumen.WhRedHoy = red;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error al calcular la energía de hoy");
        }
        finally
        {
            _actualizandoEnergia = false;
        }
    }

    private void AlCambiarAlertas(int empresaId)
    {
        if (_destruido || _esOperador ||
            !UsuarioActual.PuedeVerEmpresa(empresaId))
            return;

        _ = InvokeAsync(async () =>
        {
            if (_destruido)
                return;

            try
            {
                await using var scope =
                    ScopeFactory.CreateAsyncScope();

                var db = scope.ServiceProvider
                    .GetRequiredService<ApplicationDbContext>();

                var cantidad = await db.Alertas
                    .AsNoTracking()
                    .CountAsync(a =>
                        a.Dispositivo.EmpresaId == empresaId &&
                        a.Activa &&
                        a.Fin == null);

                var resumen = _resumenes
                    .FirstOrDefault(r =>
                        r.EmpresaId == empresaId);

                if (resumen is not null)
                {
                    resumen.AlertasAbiertas = cantidad;
                    StateHasChanged();
                }
            }
            catch
            {
                // Un error de lectura no interrumpe la telemetría.
            }
        });
    }

    private void AlCambiarEmpresa()
    {
        if (_destruido)
            return;

        _ = InvokeAsync(() =>
        {
            _pestana = 0;
            SincronizarEmpresaActiva();
            StateHasChanged();
        });
    }

    private async Task IrEmpresaAsync(int empresaId)
    {
        if (!UsuarioActual.PuedeVerEmpresa(empresaId))
            return;

        await UsuarioActual.SeleccionarEmpresaAsync(empresaId);

        _pestana = 0;
        SincronizarEmpresaActiva();
    }

    private void ActualizarGrafico()
    {
        _etiquetas = _resumenes
            .Select(r => r.Nombre)
            .ToArray();

        _series = new List<ChartSeries<double>>
        {
            new ChartSeries<double>
            {
                Name = "Solar (W)",
                Data = _resumenes
                    .Select(r => (double)(r.PSolarMw / 1000m))
                    .ToArray()
            },
            new ChartSeries<double>
            {
                Name = "Red (W)",
                Data = _resumenes
                    .Select(r => (double)(r.PRedMw / 1000m))
                    .ToArray()
            }
        };
    }

    private static string Potencia(decimal mw)
    {
        return Formato.Potencia(mw);
    }

    private static string Numero(decimal valor)
    {
        return valor.ToString(
            "N2",
            System.Globalization.CultureInfo.GetCultureInfo("es-BO"));
    }

    private static string SaludoLocal()
    {
        var hora = TimeZoneInfo.ConvertTimeFromUtc(
            DateTime.UtcNow,
            ObtenerZonaBolivia()).Hour;

        return hora switch
        {
            >= 5 and < 12 => "Buenos días",
            >= 12 and < 19 => "Buenas tardes",
            _ => "Buenas noches"
        };
    }

    private static TimeZoneInfo ObtenerZonaBolivia()
    {
        foreach (var id in new[]
        {
            "America/La_Paz",
            "SA Western Standard Time"
        })
        {
            try
            {
                return TimeZoneInfo.FindSystemTimeZoneById(id);
            }
            catch (TimeZoneNotFoundException)
            {
            }
            catch (InvalidTimeZoneException)
            {
            }
        }

        return TimeZoneInfo.Local;
    }

    public void Dispose()
    {
        _destruido = true;

        EnVivo.Cambio -= AlCambiarEstado;
        EnVivo.AlertasCambiaron -= AlCambiarAlertas;
        UsuarioActual.EmpresaCambiada -= AlCambiarEmpresa;
    }

    private sealed class FilaOperador
    {
        public string Nombre { get; set; } = "";
        public bool Activa { get; set; }
        public int Administradores { get; set; }
        public int Tecnicos { get; set; }
        public int Consultas { get; set; }
    }

    private sealed class ResumenEmpresa
    {
        public int EmpresaId { get; set; }
        public string Nombre { get; set; } = "";

        public int TotalDispositivos { get; set; }
        public int EnLinea { get; set; }

        public decimal PSolarMw { get; set; }
        public decimal PRedMw { get; set; }

        public decimal WhSolarHoy { get; set; }
        public decimal WhRedHoy { get; set; }
        public IEnumerable<decimal> Factores => Dispositivos.Select(d => d.FactorEscala).Distinct();

        public int AlertasAbiertas { get; set; }
        public decimal ConsumoKwh { get; set; }
        public decimal MontoBs { get; set; }

        public bool TieneEscala { get; set; }

        public List<TarjetaDispositivo> Dispositivos { get; } = new();

        public void Recalcular()
        {
            TotalDispositivos = Dispositivos.Count;
            EnLinea = Dispositivos.Count(d => d.EnLinea);

            PSolarMw = Dispositivos
                .Where(d => d.EnLinea)
                .Sum(d => d.PSolMw * d.FactorEscala);

            PRedMw = Dispositivos
                .Where(d => d.EnLinea)
                .Sum(d => d.PRedMw * d.FactorEscala);

            TieneEscala = Dispositivos
                .Any(d => d.FactorEscala != 1m);
        }
    }

    private sealed class TarjetaDispositivo
    {
        public int Id { get; set; }
        public string Nombre { get; set; } = "";
        public bool EsSimulado { get; set; }
        public decimal FactorEscala { get; set; } = 1m;

        public bool EnLinea { get; set; }
        public DateTime? UltimoContacto { get; set; }

        public string Fuente { get; set; } = "";

        public decimal PSolMw { get; set; }
        public decimal PRedMw { get; set; }

        public decimal PotenciaSeleccionadaMw =>
            (Fuente == "SOLAR" ? PSolMw : PRedMw) *
            FactorEscala;

        public void Actualizar(EstadoDispositivo estado)
        {
            EnLinea = estado.EnLinea;
            UltimoContacto = estado.TsServidor;
            Fuente = estado.FuenteSeleccionada;
            PSolMw = estado.PSolMw;
            PRedMw = estado.PRedMw;
        }
    }
}
