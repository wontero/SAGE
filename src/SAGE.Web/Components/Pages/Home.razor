@page "/"
@attribute [Authorize]
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using SAGE.Web.Data
@implements IDisposable
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject IServiceScopeFactory ScopeFactory

<PageTitle>Inicio — SAGE</PageTitle>

<div class="home">
    <header class="home-intro">
        <div class="page-head__text">
            <p class="home-kicker">@_saludo</p>
            <h1 class="home-title">@_nombre</h1>
            <p class="home-meta">@_fraseRol@(_esAdmin ? "" : $" · {_empresaNombre}")</p>
        </div>
    </header>

    <div class="home-body">
        <div class="home-body__side">
            <section class="home-group" aria-labelledby="home-now-title">
                <h2 id="home-now-title" class="home-group__title">Ahora</h2>
                <div class="home-list">
                    <div class="home-row home-row--hero">
                        <div class="home-row__stack">
                            <span class="home-row__label">Potencia</span>
                            <span class="home-row__hint">
                                <span class="home-live-dot" aria-hidden="true"></span>
                                En vivo · cada 5 s
                            </span>
                        </div>
                        <span class="home-row__hero">@Watts(_potenciaTotalMw) <small>W</small></span>
                    </div>
                    <div class="home-row">
                        <span class="home-row__label">
                            <span class="home-swatch home-swatch--solar" aria-hidden="true"></span>
                            Solar
                        </span>
                        <span class="home-row__value">@Watts(_potenciaSolarMw) W</span>
                    </div>
                    <div class="home-row">
                        <span class="home-row__label">
                            <span class="home-swatch home-swatch--red" aria-hidden="true"></span>
                            Red
                        </span>
                        <span class="home-row__value">@Watts(_potenciaRedMw) W</span>
                    </div>
                    @if (_potenciaTotalMw > 0)
                    {
                        <div class="home-mix" aria-hidden="true">
                            <span class="home-mix__solar" style="width: @Porcentaje(_potenciaSolarMw, _potenciaTotalMw)%"></span>
                            <span class="home-mix__red" style="width: @Porcentaje(_potenciaRedMw, _potenciaTotalMw)%"></span>
                        </div>
                    }
                </div>
            </section>

            <section class="home-group" aria-labelledby="home-summary-title">
                <h2 id="home-summary-title" class="home-group__title">Resumen</h2>
                <div class="home-list">
                    @foreach (var kpi in Kpis())
                    {
                        <div class="home-row">
                            <span class="home-row__label">@kpi.Titulo</span>
                            <span class="home-row__value">@kpi.Valor</span>
                        </div>
                    }
                </div>
            </section>
        </div>

        <section class="home-group" aria-labelledby="home-devices-title">
            <h2 id="home-devices-title" class="home-group__title">Última medición</h2>
            <div class="home-list">
                @if (_dispositivos.Count == 0)
                {
                    <div class="home-row home-row--muted">
                        <span class="home-row__label">No hay dispositivos activos</span>
                    </div>
                }
                else
                {
                    @foreach (var d in _dispositivos)
                    {
                        var solar = d.Medicion?.EsSolar == true;
                        <div class="home-row home-row--device">
                            <div class="home-row__stack">
                                <span class="home-row__label">@d.Nombre</span>
                                <span class="home-row__hint">
                                    @if (_esAdmin)
                                    {
                                        @d.EmpresaNombre
                                        <span aria-hidden="true"> · </span>
                                    }
                                    @if (d.EsSimulado)
                                    {
                                        <text>Simulado</text>
                                        @if (d.Medicion is not null)
                                        {
                                            <span aria-hidden="true"> · </span>
                                        }
                                    }
                                    @if (d.Medicion is null)
                                    {
                                        <text>Sin mediciones</text>
                                    }
                                    else
                                    {
                                        <text>@(solar ? "Solar" : "Red") · @TiempoDesde(d.Medicion.TsServidor)</text>
                                    }
                                </span>
                            </div>
                            @if (d.Medicion is not null)
                            {
                                <span class="home-row__value home-row__value--emphasis">
                                    @Watts(solar ? d.Medicion.PSolMw : d.Medicion.PRedMw) W
                                </span>
                            }
                            else
                            {
                                <span class="home-row__value">—</span>
                            }
                        </div>
                    }
                }
                <a class="home-action" href="dispositivos">
                    <span>Ver dispositivos</span>
                    <span class="home-action__chev" aria-hidden="true">›</span>
                </a>
            </div>
        </section>
    </div>
</div>

@code {
    private readonly CancellationTokenSource _cts = new();

    private string _nombre = "usuario";
    private string _rol = "Sin rol";
    private string _saludo = "Hola";
    private string _fraseRol = "";
    private string _empresaNombre = "—";
    private bool _esAdmin;
    private int? _empresaId;

    private int _empresasActivas;
    private int _usuarios;
    private int _dispositivosEnLinea;
    private int _dispositivosTotal;
    private int _facturas;
    private decimal _potenciaSolarMw;
    private decimal _potenciaRedMw;
    private decimal _potenciaTotalMw;
    private List<TarjetaDispositivo> _dispositivos = new();

    protected override async Task OnInitializedAsync()
    {
        _saludo = SaludoLocal();

        var auth = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var principal = auth.User;
        var user = await UserManager.GetUserAsync(principal);
        _nombre = user?.NombreCompleto ?? principal.Identity?.Name ?? "usuario";
        _empresaId = user?.EmpresaId;

        var roles = user is null
            ? Array.Empty<string>()
            : await UserManager.GetRolesAsync(user);
        _rol = roles.FirstOrDefault() ?? "Sin rol";
        _esAdmin = roles.Contains("Administrador");
        _fraseRol = _esAdmin ? "Administrador" : _rol == "Tecnico" ? "Técnico" : "Consulta";

        await CargarResumenAsync();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            _ = RefrescarCadaCincoSegundosAsync();
        }
    }

    private async Task CargarResumenAsync()
    {
        await using var scope = ScopeFactory.CreateAsyncScope();
        var db = scope.ServiceProvider.GetRequiredService<ApplicationDbContext>();

        var propia = _empresaId ?? -1;

        if (_esAdmin)
        {
            _empresasActivas = await db.Empresas.CountAsync(e => e.Activa);
            _usuarios = await db.Users.CountAsync();
        }
        else if (_empresaId is int empresaId)
        {
            _empresaNombre = await db.Empresas.AsNoTracking()
                .Where(e => e.Id == empresaId)
                .Select(e => e.Nombre)
                .FirstOrDefaultAsync() ?? "—";
        }

        _facturas = await db.Facturas.CountAsync(f => _esAdmin || f.EmpresaId == propia);

        await CargarDispositivosAsync(db, propia);
    }

    private async Task CargarDispositivosAsync(ApplicationDbContext db, int propia)
    {
        var consulta = db.Dispositivos.AsNoTracking().Where(d => d.Activo);
        if (!_esAdmin)
        {
            consulta = consulta.Where(d => d.EmpresaId == propia);
        }

        var limite = DateTime.UtcNow.AddSeconds(-30);
        _dispositivosTotal = await consulta.CountAsync();
        _dispositivosEnLinea = await consulta.CountAsync(d => d.UltimoContacto != null && d.UltimoContacto >= limite);

        var lista = await consulta
            .OrderBy(d => d.Nombre)
            .Take(20)
            .Select(d => new TarjetaDispositivo
            {
                Id = d.Id,
                Nombre = d.Nombre,
                EmpresaNombre = d.Empresa.Nombre,
                EsSimulado = d.EsSimulado
            })
            .ToListAsync();

        foreach (var d in lista)
        {
            d.Medicion = await db.Mediciones.AsNoTracking()
                .Where(m => m.DispositivoId == d.Id)
                .OrderByDescending(m => m.Id)
                .Select(m => new UltimaMedicion
                {
                    PSolMw = m.PSolMw,
                    PRedMw = m.PRedMw,
                    EsSolar = m.FuenteSeleccionada == "SOLAR",
                    TsServidor = m.TsServidor
                })
                .FirstOrDefaultAsync();
        }

        _dispositivos = lista;
        RecalcularPotencia();
    }

    private void RecalcularPotencia()
    {
        _potenciaSolarMw = 0;
        _potenciaRedMw = 0;
        foreach (var d in _dispositivos)
        {
            if (d.Medicion is null) continue;
            _potenciaSolarMw += d.Medicion.PSolMw;
            _potenciaRedMw += d.Medicion.PRedMw;
        }

        _potenciaTotalMw = _potenciaSolarMw + _potenciaRedMw;
    }

    private async Task RefrescarCadaCincoSegundosAsync()
    {
        using var temporizador = new PeriodicTimer(TimeSpan.FromSeconds(5));
        try
        {
            while (await temporizador.WaitForNextTickAsync(_cts.Token))
            {
                await using var scope = ScopeFactory.CreateAsyncScope();
                var db = scope.ServiceProvider.GetRequiredService<ApplicationDbContext>();
                await CargarDispositivosAsync(db, _empresaId ?? -1);
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
        }
        catch (ObjectDisposedException)
        {
        }
        catch (Exception)
        {
        }
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }

    private IEnumerable<KpiItem> Kpis()
    {
        if (_esAdmin)
        {
            yield return new("Empresas activas", _empresasActivas.ToString());
            yield return new("Usuarios", _usuarios.ToString());
        }

        yield return new("Dispositivos en línea", $"{_dispositivosEnLinea} / {_dispositivosTotal}");
        yield return new("Facturas registradas", _facturas.ToString());
    }

    private static string Watts(decimal mw) => (mw / 1000m).ToString("N2", FacturaReglas.Cultura);

    private static double Porcentaje(decimal parte, decimal total)
    {
        if (total <= 0) return 0;
        return Math.Round((double)(parte / total * 100m), 1);
    }

    private static string TiempoDesde(DateTime utc)
    {
        var segundos = Math.Max(0, (DateTime.UtcNow - utc).TotalSeconds);

        if (segundos < 60)
            return $"hace {(int)segundos} s";

        if (segundos < 3600)
            return $"hace {(int)(segundos / 60)} min";

        if (segundos < 86400)
            return $"hace {(int)(segundos / 3600)} h";

        return $"hace {(int)(segundos / 86400)} días";
    }

    private static string SaludoLocal()
    {
        var tz = ResolveTz();
        var hora = TimeZoneInfo.ConvertTimeFromUtc(DateTime.UtcNow, tz).Hour;
        return hora switch
        {
            >= 5 and < 12 => "Buenos días",
            >= 12 and < 19 => "Buenas tardes",
            _ => "Buenas noches"
        };
    }

    private static TimeZoneInfo ResolveTz()
    {
        foreach (var id in new[] { "America/La_Paz", "SA Western Standard Time" })
        {
            try { return TimeZoneInfo.FindSystemTimeZoneById(id); }
            catch (TimeZoneNotFoundException) { }
            catch (InvalidTimeZoneException) { }
        }

        return TimeZoneInfo.Local;
    }

    private sealed record KpiItem(string Titulo, string Valor);

    private sealed class TarjetaDispositivo
    {
        public int Id { get; set; }
        public string Nombre { get; set; } = string.Empty;
        public string EmpresaNombre { get; set; } = string.Empty;
        public bool EsSimulado { get; set; }
        public UltimaMedicion? Medicion { get; set; }
    }

    private sealed class UltimaMedicion
    {
        public decimal PSolMw { get; set; }
        public decimal PRedMw { get; set; }
        public bool EsSolar { get; set; }
        public DateTime TsServidor { get; set; }
    }
}
