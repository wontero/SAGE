@page "/ensayos/{Id:int}"
@attribute [Authorize(Roles = "Administrador,Tecnico,Consulta")]

@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using MudBlazor
@using SAGE.Web.Data
@using SAGE.Web.Servicios
@using SAGE.Web.Servicios.Energia
@using SAGE.Web.Servicios.Seguridad
@using SAGE.Web.Components.Shared

@inject IServiceScopeFactory ScopeFactory
@inject IUsuarioActual UsuarioActual
@inject CalculadoraEnergia Calculadora

<PageTitle>Ensayo — SAGE</PageTitle>

@* S23-M12: datos del ensayo y las mediciones de su intervalo (RF17). *@

<div class="page">

    <div class="sage-back">
        <MudButton Href="/ensayos"
                   Variant="Variant.Text"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Outlined.ArrowBack">
            Volver a ensayos
        </MudButton>
    </div>

    @if (_cargando)
    {
        <div class="page-panel sage-panel-pad">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
        </div>
    }
    else if (_ensayo is null)
    {
        <MudAlert Severity="Severity.Warning">No encontrado.</MudAlert>
    }
    else
    {
        <MudStack Spacing="3">

            <header class="page-head" style="margin-bottom:0">
                <div class="page-head__text">
                    <p class="page-kicker">Pruebas</p>
                    <h1 class="page-title">Ensayo en @_ensayo.Dispositivo.Nombre</h1>
                    <p class="page-meta">@_ensayo.CargaDescripcion</p>
                </div>
                <div class="page-actions">
                    @if (_ensayo.Fin is null)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Filled">En curso</MudChip>
                    }
                    <ChipEscala Factor="@_ensayo.Dispositivo.FactorEscala" />
                </div>
            </header>

            <div class="page-panel sage-panel-pad">
                <div class="home-list">
                    <div class="home-row">
                        <span class="home-row__label">Inicio</span>
                        <span class="home-row__value">@Formato.HoraLocal(_ensayo.Inicio)</span>
                    </div>
                    <div class="home-row">
                        <span class="home-row__label">Fin</span>
                        <span class="home-row__value">@(_ensayo.Fin is DateTime fin ? Formato.HoraLocal(fin) : "En curso")</span>
                    </div>
                    <div class="home-row">
                        <span class="home-row__label">Duración</span>
                        <span class="home-row__value">@Formato.Duracion((_ensayo.Fin ?? DateTime.UtcNow) - _ensayo.Inicio)</span>
                    </div>
                    <div class="home-row">
                        <span class="home-row__label">Creado por</span>
                        <span class="home-row__value">@(_ensayo.CreadoPor?.NombreCompleto ?? "—")</span>
                    </div>
                    <div class="home-row">
                        <span class="home-row__label">Condiciones</span>
                        <span class="home-row__value">@_ensayo.Condiciones</span>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(_ensayo.Notas))
                    {
                        <div class="home-row">
                            <span class="home-row__label">Notas</span>
                            <span class="home-row__value">@_ensayo.Notas</span>
                        </div>
                    }
                </div>
            </div>

            @if (_energia is not null)
            {
                <ComparacionPorFuente Energia="@_energia" Factor="@_ensayo.Dispositivo.FactorEscala"
                                     ConmutacionesSolar="@_conmutacionesSolar" ConmutacionesRed="@_conmutacionesRed" />
            }

            <div class="page-panel sage-panel-pad">

                <h2 class="sage-section-title">Mediciones del intervalo</h2>
                <p class="page-meta" style="margin:0 0 0.75rem">
                    Total: <b>@_total</b> mediciones
                    @(_ensayo.Fin is null ? "(hasta ahora)" : "")
                </p>

                <MudTable T="Medicion"
                          @ref="_tabla"
                          ServerData="CargarMedicionesAsync"
                          Dense="true"
                          Hover="true"
                          Breakpoint="Breakpoint.Sm"
                          Elevation="0"
                          RowsPerPage="50">

                    <HeaderContent>
                        <MudTh>Hora</MudTh>
                        <MudTh>Modo</MudTh>
                        <MudTh>Estado</MudTh>
                        <MudTh>Fuente</MudTh>
                        <MudTh>Solar V</MudTh>
                        <MudTh>Solar I</MudTh>
                        <MudTh>Solar P <ChipEscala Factor="@_ensayo.Dispositivo.FactorEscala" /></MudTh>
                        <MudTh>Red V</MudTh>
                        <MudTh>Red I</MudTh>
                        <MudTh>Red P <ChipEscala Factor="@_ensayo.Dispositivo.FactorEscala" /></MudTh>
                    </HeaderContent>

                    <RowTemplate>
                        <MudTd DataLabel="Hora">@Formato.HoraLocal(context.Ts)</MudTd>
                        <MudTd DataLabel="Modo">@Formato.Modo(context.Modo, context.FuenteSeleccionada)</MudTd>
                        <MudTd DataLabel="Estado">@SAGE.Web.Servicios.Telemetria.TextosEventos.Estado(context.Estado)</MudTd>
                        <MudTd DataLabel="Fuente">@Formato.Fuente(context.FuenteSeleccionada)</MudTd>
                        <MudTd DataLabel="Solar V">@Formato.Tension(context.VSol)</MudTd>
                        <MudTd DataLabel="Solar I">@Formato.Corriente(context.ISolMa)</MudTd>
                        <MudTd DataLabel="Solar P">@Formato.Potencia(context.PSolMw, _ensayo.Dispositivo.FactorEscala)</MudTd>
                        <MudTd DataLabel="Red V">@Formato.Tension(context.VRed)</MudTd>
                        <MudTd DataLabel="Red I">@Formato.Corriente(context.IRedMa)</MudTd>
                        <MudTd DataLabel="Red P">@Formato.Potencia(context.PRedMw, _ensayo.Dispositivo.FactorEscala)</MudTd>
                    </RowTemplate>

                    <NoRecordsContent>
                        <MudText>No hay mediciones en el intervalo del ensayo.</MudText>
                    </NoRecordsContent>

                    <PagerContent>
                        <MudTablePager RowsPerPageString="Filas por página" />
                    </PagerContent>

                </MudTable>

            </div>

        </MudStack>
    }

</div>

@code {
    [Parameter]
    public int Id { get; set; }

    private Ensayo? _ensayo;
    private EnergiaPorFuente? _energia;
    private DateTime _finIntervalo;
    private int _conmutacionesSolar;
    private int _conmutacionesRed;
    private MudTable<Medicion>? _tabla;
    private int _total;
    private bool _cargando = true;

    protected override async Task OnParametersSetAsync()
    {
        _cargando = true;
        _ensayo = null;
        _energia = null;
        _total = 0;

        try
        {
            await UsuarioActual.CargarAsync();

            if (UsuarioActual.EmpresaActivaId is not int empresaId)
                return;

            await using var scope = ScopeFactory.CreateAsyncScope();
            var db = scope.ServiceProvider.GetRequiredService<ApplicationDbContext>();

            // Otra empresa → "No encontrado" (no revela que existe).
            var ensayo = await db.Ensayos
                .AsNoTracking()
                .Include(e => e.Dispositivo)
                .Include(e => e.CreadoPor)
                .FirstOrDefaultAsync(e => e.Id == Id && e.Dispositivo.EmpresaId == empresaId);

            if (ensayo is null)
                return;

            var fin = ensayo.Fin ?? DateTime.UtcNow;
            var energia = fin < ensayo.Inicio
                ? new EnergiaPorFuente(0, 0, TimeSpan.Zero, TimeSpan.Zero, 0)
                : await Calculadora.CalcularEmpresaAsync(empresaId, ensayo.DispositivoId, ensayo.Inicio, fin,
                    soloMedida: true);
            var cambios = await db.Eventos.AsNoTracking()
                .Where(e => e.DispositivoId == ensayo.DispositivoId && e.Dispositivo.EmpresaId == empresaId &&
                    e.Tipo == "conmutacion" && e.Ts >= ensayo.Inicio && e.Ts <= fin)
                .GroupBy(e => e.A)
                .Select(g => new { Fuente = g.Key, Cantidad = g.Count() })
                .ToListAsync();

            if (Id != ensayo.Id || UsuarioActual.EmpresaActivaId != empresaId)
                return;

            _ensayo = ensayo;
            _finIntervalo = fin;
            _energia = energia;
            _conmutacionesSolar = cambios.Find(c => c.Fuente == "SOLAR")?.Cantidad ?? 0;
            _conmutacionesRed = cambios.Find(c => c.Fuente == "CARGADOR")?.Cantidad ?? 0;
        }
        finally
        {
            _cargando = false;
        }
    }

    private async Task<TableData<Medicion>> CargarMedicionesAsync(TableState estado, CancellationToken ct)
    {
        if (_ensayo is null)
            return new TableData<Medicion> { Items = Array.Empty<Medicion>(), TotalItems = 0 };

        var empresaId = UsuarioActual.EmpresaActivaId;
        var inicio = _ensayo.Inicio;
        var fin = _finIntervalo;

        await using var scope = ScopeFactory.CreateAsyncScope();
        var db = scope.ServiceProvider.GetRequiredService<ApplicationDbContext>();

        var consulta = db.Mediciones
            .AsNoTracking()
            .Where(m =>
                m.DispositivoId == _ensayo.DispositivoId &&
                m.Dispositivo.EmpresaId == empresaId &&
                m.Ts >= inicio &&
                m.Ts <= fin);

        _total = await consulta.CountAsync(ct);

        var items = await consulta
            .OrderBy(m => m.Ts)
            .ThenBy(m => m.Seq)
            .Skip(estado.Page * estado.PageSize)
            .Take(estado.PageSize)
            .ToListAsync(ct);

        StateHasChanged();

        return new TableData<Medicion> { Items = items, TotalItems = _total };
    }
}
