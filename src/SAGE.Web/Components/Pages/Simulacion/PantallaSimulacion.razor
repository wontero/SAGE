@page "/simulacion"
@attribute [Authorize(Roles = "Administrador,Tecnico,Consulta")]
@using Microsoft.EntityFrameworkCore
@using Microsoft.Extensions.DependencyInjection
@using SAGE.Web.Servicios
@using SAGE.Web.Servicios.Seguridad
@using SAGE.Web.Servicios.Simulacion
@inject IServiceScopeFactory ScopeFactory
@inject IUsuarioActual UsuarioActual
@inject ISnackbar Snackbar

<PageTitle>Simulación económica — SAGE</PageTitle>

@* // Patrón: Builder — rol: director *@

<div class="page">
    <header class="page-head">
        <div class="page-head__text">
            <p class="page-kicker">Simulación económica</p>
            <h1 class="page-title">Simulación</h1>
            @if (UsuarioActual.EmpresaActiva is not null)
            {
                <p class="page-meta">@UsuarioActual.EmpresaActiva.Nombre</p>
            }
        </div>
    </header>

    @if (_cargando)
    {
        <div class="page-panel">
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
        </div>
    }
    else
    {
        @if (_puedeSimular && UsuarioActual.EmpresaActivaId.HasValue)
        {
            <section class="page-panel sage-panel-pad">
                <h2 class="home-group__title">Lo que SAGE calcula con tus facturas</h2>
                @if (_tarifaFacturas is not decimal tarifaFacturas)
                {
                    <MudText>Cargá tus facturas en <MudLink Href="/facturas">Facturas</MudLink> para calcular el consumo y simular.</MudText>
                }
                else
                {
                    <MudText>Usás en promedio <strong>@Numero(_consumo) kWh por mes</strong> (@_facturas.Count @(_facturas.Count == 1 ? "factura" : "facturas")).</MudText>
                    @if (_parametros is { } parametros)
                    {
                        var referencia = SimulacionBuilder.CalcularReferencia(_consumo, tarifaFacturas, parametros);
                        <MudText>Para cubrirlo todo con solar necesitás <strong>≈ @Numero(referencia.PotenciaKwp) kWp</strong>.</MudText>
                        <MudText Typo="Typo.body2">@Numero(_consumo) kWh ÷ @Numero(parametros.GeneracionKwhKwpMes) kWh por kWp ≈ @Numero(referencia.PotenciaKwp) kWp</MudText>
                        <MudText>Inversión aproximada (Referencia SAGE) · @Numero(referencia.PotenciaKwp) × @Numero(parametros.CostoInstalacionBsKwp) = <strong>@Numero(referencia.InversionBs) Bs</strong></MudText>
                        <MudText>Pagás hoy ≈ <strong>@Numero(decimal.Round(referencia.CostoRedMensualBs, 2)) Bs por mes</strong> de luz.</MudText>
                    }
                    <MudExpansionPanels Class="mt-3">
                        <MudExpansionPanel Text="Ver las facturas usadas">
                            <FacturasSimulacion Facturas="_facturasBase" />
                            <MudText Class="mt-3">Tarifa de tus facturas · @Tarifa(_tarifaFacturas)</MudText>
                            <MudText>Tarifa configurada (@(_tarifaPropia.HasValue ? "empresa" : "general")) · @Tarifa(_tarifaConfigurada)</MudText>
                        </MudExpansionPanel>
                    </MudExpansionPanels>
                }
            </section>

            <section class="page-panel sage-panel-pad mt-4">
                <h2 class="home-group__title">¿Cuánto podés invertir?</h2>
                <MudGrid>
                    <MudItem xs="12" sm="6">
                        <MudNumericField T="decimal?" @bind-Value="_presupuesto" @bind-Value:after="LimpiarSugerencia"
                                         Label="Presupuesto total (Bs)" Variant="Variant.Outlined" Disabled="@(!HayBase)"
                                         Culture="FacturaReglas.Cultura" Format="#,0.####"
                                         Error="@(_errorPresupuesto is not null)" ErrorText="@_errorPresupuesto" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudSelect T="int" @bind-Value="_instaladoraPresupuestoId" @bind-Value:after="LimpiarSugerencia"
                                   Label="Precios de referencia de" Variant="Variant.Outlined" Disabled="@(!HayBase)">
                            <MudSelectItem T="int" Value="0">Referencia SAGE</MudSelectItem>
                            @foreach (var instaladora in _instaladoras)
                            {
                                <MudSelectItem Value="instaladora.Id">@instaladora.Nombre</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                </MudGrid>
                <MudButton Class="mt-3" Variant="Variant.Outlined" Color="Color.Primary" OnClick="SugerirSistema" Disabled="@(!HayBase)">Sugerir sistema</MudButton>
                @if (_sugerencia is { } sugerencia)
                {
                    <div class="mt-3" role="status">
                        @if (sugerencia.EnergiaRedKwhMes == 0m)
                        {
                            <MudText>Con @Numero(sugerencia.PresupuestoBs) Bs te alcanza para cubrir todo tu consumo con solar (@Numero(sugerencia.PotenciaKwp) kWp por @Numero(sugerencia.InversionBs) Bs) y te sobran @Numero(sugerencia.SobranteBs) Bs.</MudText>
                        }
                        else
                        {
                            <MudText>Con @Numero(sugerencia.PresupuestoBs) Bs te alcanza para un sistema mixto de @Numero(sugerencia.PotenciaKwp) kWp. Cubre @PorcentajeCobertura(sugerencia.Cobertura) % de tu consumo (@Numero(sugerencia.EnergiaCubiertaKwhMes) de @Numero(_consumo) kWh/mes). El resto, @Numero(sugerencia.EnergiaRedKwhMes) kWh/mes, lo seguís pagando a la red.</MudText>
                        }
                    </div>
                    <MudButton Class="mt-2" Variant="Variant.Outlined" Color="Color.Primary" OnClick="AplicarSugerencia">Usar esta sugerencia en Tu propuesta</MudButton>
                }
            </section>

            <div class="page-panel sage-panel-pad mt-4">
                <h2 class="home-group__title">Escenarios</h2>
                <MudForm @ref="_formulario" Disabled="@(!HayBase)">
                    <MudGrid Class="mt-1">
                        <MudItem xs="12" sm="6">
                            <MudText>Solo red · Tarifa usada (@SimulacionBuilder.NombreTarifa(_origenTarifa)) · @Tarifa(TarifaActiva)</MudText>
                            @if (_origenTarifa == OrigenTarifaSimulacion.Facturas && _tarifaFacturas.HasValue &&
                                 RangosSimulacion.Tarifa(_tarifaFacturas) is { } errorTarifa)
                            {
                                <MudText Color="Color.Error" Typo="Typo.caption">@errorTarifa Elegí la tarifa configurada o ingresá una manual.</MudText>
                            }
                            <MudExpansionPanels Class="mt-2">
                                <MudExpansionPanel Text="Cambiar tarifa" KeepContentAlive="true" Disabled="@(!HayBase)">
                                    <MudSelect T="OrigenTarifaSimulacion" @bind-Value="_origenTarifa" Label="Tarifa para los tres escenarios" Variant="Variant.Outlined">
                                        @foreach (var origen in Enum.GetValues<OrigenTarifaSimulacion>())
                                        {
                                            <MudSelectItem Value="origen">@SimulacionBuilder.NombreTarifa(origen)</MudSelectItem>
                                        }
                                    </MudSelect>
                                    @if (_origenTarifa == OrigenTarifaSimulacion.Manual)
                                    {
                                        <MudNumericField T="decimal?" @bind-Value="_tarifaManual" Label="Tarifa manual (Bs/kWh)" Variant="Variant.Outlined"
                                                         Culture="FacturaReglas.Cultura" Format="#,0.####" Validation="@(new Func<decimal?, string?>(RangosSimulacion.Tarifa))" />
                                    }
                                </MudExpansionPanel>
                            </MudExpansionPanels>
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudNumericField T="int?" @bind-Value="_horizonte" Label="Horizonte (años)" Variant="Variant.Outlined"
                                             Culture="FacturaReglas.Cultura" Format="#,0" Validation="@(new Func<int?, string?>(RangosSimulacion.Horizonte))" />
                        </MudItem>
                        @foreach (var entrada in new[] { _solar, _propuesta })
                        {
                            var esPropuesta = entrada == _propuesta;
                            var potencia = Potencia(entrada);
                            var mantenimiento = entrada.MantenimientoManual ? entrada.Mantenimiento : potencia * entrada.MantenimientoPorKwp;
                            <MudItem xs="12" md="6">
                                <MudPaper Outlined="true" Class="pa-4">
                                    <MudStack Spacing="2">
                                        <MudText Typo="Typo.h6">@(esPropuesta ? "Tu propuesta" : "Solar sugerido")</MudText>
                                        @if (esPropuesta)
                                        {
                                            <MudSelect T="ModoPropuesta" @bind-Value="_modoPropuesta" @bind-Value:after="DesvincularPresupuesto"
                                                       Label="Definir por" Variant="Variant.Outlined">
                                                <MudSelectItem Value="ModoPropuesta.KwhMes">kWh por mes que quiero cubrir</MudSelectItem>
                                                <MudSelectItem Value="ModoPropuesta.Kwp">kWp</MudSelectItem>
                                            </MudSelect>
                                            @if (_modoPropuesta == ModoPropuesta.KwhMes)
                                            {
                                                <MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                                                    <MudNumericField T="decimal?" @bind-Value="_metaKwhMes" Label="Quiero cubrir (kWh/mes)"
                                                                     Variant="Variant.Outlined" Culture="FacturaReglas.Cultura" Format="#,0.####"
                                                                     Validation="@(new Func<decimal?, string?>(ValidarMeta))" />
                                                    @if (potencia is decimal kwp)
                                                    {
                                                        <MudText Typo="Typo.body2">= @PotenciaConProduccion(kwp, entrada.Produccion)</MudText>
                                                    }
                                                </MudStack>
                                            }
                                            else
                                            {
                                                <MudNumericField T="decimal?" @bind-Value="_kwpPropuesta" @bind-Value:after="DesvincularPresupuesto" Label="Potencia de tu propuesta (kWp)"
                                                                 Variant="Variant.Outlined" Culture="FacturaReglas.Cultura" Format="#,0.####" Step="0.1m"
                                                                 Validation="@(new Func<decimal?, string?>(RangosSimulacion.Potencia))" />
                                                @if (potencia is decimal kwp && entrada.Produccion is decimal produccion)
                                                {
                                                    <MudText Typo="Typo.caption">≈ @Numero(kwp * produccion) kWh/mes</MudText>
                                                }
                                            }
                                        }
                                        else
                                        {
                                            <MudNumericField T="decimal?" @bind-Value="_cobertura" Label="Cobertura que quiero (%)" Variant="Variant.Outlined"
                                                             Culture="FacturaReglas.Cultura" Format="#,0.####" Validation="@(new Func<decimal?, string?>(RangosSimulacion.Cobertura))" />
                                            @if (potencia is decimal kwp)
                                            {
                                                <MudText Typo="Typo.caption">@PotenciaConProduccion(kwp, entrada.Produccion)</MudText>
                                            }
                                        }
                                        @if (esPropuesta && _presupuestoAplicado is decimal aplicado)
                                        {
                                            <MudText Typo="Typo.caption">Presupuesto aplicado · @Numero(aplicado) Bs · @entrada.Nombre</MudText>
                                        }
                                        <MudExpansionPanels>
                                            <MudExpansionPanel Text="Personalizar precios y producción" KeepContentAlive="true" Disabled="@(!HayBase)">
                                                <MudStack Spacing="2">
                                                    <MudSelect T="int" Value="entrada.InstaladoraId" ValueChanged="@(id => ElegirInstaladora(entrada, id))"
                                                               Label="Instaladora" Variant="Variant.Outlined">
                                                        <MudSelectItem T="int" Value="0">Referencia SAGE</MudSelectItem>
                                                        @foreach (var instaladora in _instaladoras)
                                                        {
                                                            <MudSelectItem Value="instaladora.Id">@instaladora.Nombre</MudSelectItem>
                                                        }
                                                    </MudSelect>
                                                    <MudNumericField T="decimal?" @bind-Value="entrada.Precio" @bind-Value:after="@(() => PrecioCambiado(entrada))"
                                                                     Label="Precio (Bs/kWp instalado)" Variant="Variant.Outlined" Culture="FacturaReglas.Cultura" Format="#,0.####"
                                                                     Validation="@(new Func<decimal?, string?>(RangosSimulacion.Precio))" />
                                                    <MudSwitch T="bool" @bind-Value="entrada.EsManual" @bind-Value:after="@(() => PrecioCambiado(entrada))" Color="Color.Primary" Label="Ya tengo cotización" />
                                                    @if (entrada.EsManual)
                                                    {
                                                        <MudNumericField T="decimal?" @bind-Value="entrada.Cotizacion" Label="Inversión total cotizada (Bs)"
                                                                         Variant="Variant.Outlined" Culture="FacturaReglas.Cultura" Format="#,0.####"
                                                                         Validation="@(new Func<decimal?, string?>(RangosSimulacion.Inversion))" />
                                                    }
                                                    <MudNumericField T="decimal?" Value="mantenimiento" ValueChanged="@(valor => EditarMantenimiento(entrada, valor))"
                                                                     Label="Mantenimiento (Bs/año)" Variant="Variant.Outlined"
                                                                     Culture="FacturaReglas.Cultura" Format="#,0.####"
                                                                     HelperText="@(entrada.MantenimientoPorKwp is decimal tasa ? $"≈ {Numero(tasa)} Bs por kWp al año, valor estándar" : null)"
                                                                     Validation="@(new Func<decimal?, string?>(v => entrada.MantenimientoManual ? RangosSimulacion.Mantenimiento(v) : null))" />
                                                    @if (entrada.MantenimientoManual)
                                                    {
                                                        <MudButton Size="Size.Small" OnClick="@(() => entrada.MantenimientoManual = false)">Volver al calculado</MudButton>
                                                    }
                                                    <MudNumericField T="decimal?" @bind-Value="entrada.Produccion" @bind-Value:after="@(() => PrecioCambiado(entrada))" Label="Producción (kWh por kWp al mes)" Variant="Variant.Outlined"
                                                                     Culture="FacturaReglas.Cultura" Format="#,0.####" Validation="@(new Func<decimal?, string?>(RangosSimulacion.Produccion))"
                                                                     HelperText="≈ 4,2 horas de sol pico por día, típico de Bolivia; bajalo si tenés sombra o mala orientación" />
                                                </MudStack>
                                            </MudExpansionPanel>
                                        </MudExpansionPanels>
                                    </MudStack>
                                </MudPaper>
                            </MudItem>
                        }
                    </MudGrid>
                </MudForm>

                @if (_error is not null)
                {
                    <MudAlert Severity="Severity.Error" Class="mt-3">@_error</MudAlert>
                }

                <div class="page-actions mt-3">
                    <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Simular" Disabled="@(!HayBase || _simulando || _guardando)">
                        @(_simulando ? "Calculando…" : "Simular")
                    </MudButton>
                </div>
            </div>

            @if (UsuarioActual.EsAdministrador && _parametros is not null)
            {
                <MudExpansionPanels Class="mt-3">
                    <MudExpansionPanel Text="Tarifa de la empresa">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                            <MudNumericField T="decimal?" @bind-Value="_nuevaTarifa" Label="Nueva tarifa de la empresa (Bs/kWh)"
                                             Variant="Variant.Outlined" Culture="FacturaReglas.Cultura" Format="#,0.####"
                                             Validation="@(new Func<decimal?, string?>(RangosSimulacion.Tarifa))" @ref="_campoNuevaTarifa" />
                            <MudButton Color="Color.Primary" Variant="Variant.Outlined" OnClick="FijarTarifa" Disabled="_guardandoTarifa">
                                Fijar tarifa
                            </MudButton>
                        </MudStack>
                    </MudExpansionPanel>
                </MudExpansionPanels>
            }
        }

        <MudText Typo="Typo.body2" Class="my-3">Precios referenciales, no son una cotización</MudText>

        @if (_resultado is not null)
        {
            <div class="page-panel sage-panel-pad" tabindex="-1" @ref="_panelResultado" aria-label="Resultado de la simulación">
                <div class="sage-sim-head">
                    <MudChip T="string" Color="Color.Info" Size="Size.Small">SIMULACIÓN</MudChip>
                    <span class="sage-person__mail">Horizonte @_resultado.HorizonteAnios años · parámetros v@_resultado.ParametrosVersion</span>
                    @if (_resultado.Id == 0 && _puedeSimular)
                    {
                        <MudButton Color="Color.Primary" Variant="Variant.Outlined" OnClick="Guardar" Disabled="_guardando">Guardar resultado</MudButton>
                    }
                </div>

                <div class="sage-scenarios">
                    @foreach (var fila in _filasResultado)
                    {
                        <div class="sage-scenario @(fila.Nombre == "Solar sugerido" ? "sage-scenario--best" : null)">
                            <p class="sage-scenario__name">@fila.Nombre</p>
                            <div class="sage-scenario__stat"><span>Potencia</span><span>@fila.Kwp</span></div>
                            <div class="sage-scenario__stat"><span>Inversión</span><span>@Numero(fila.Inversion) Bs</span></div>
                            <div class="sage-scenario__stat"><span>Costo anual</span><span>@Numero(fila.CostoAnual) Bs/año</span></div>
                            <div class="sage-scenario__stat"><span>Acum. @_resultado.HorizonteAnios a.</span><span>@Numero(fila.CostoAcum) Bs</span></div>
                            <div class="sage-scenario__stat"><span>Ahorro vs red</span><span>@Numero(fila.AhorroAcum) Bs</span></div>
                            <div class="sage-scenario__stat"><span>Recuperación</span><span>@fila.Recuperacion</span></div>
                        </div>
                    }
                </div>

                @if (_grafico is not null)
                {
                    var focusIdx = _hoverAnio ?? (_grafico.Puntos.Count - 1);
                    var focus = _grafico.Puntos[focusIdx];
                    var deltaSolar = focus.Red - focus.Solar;
                    var deltaMixto = focus.Red - focus.Mixto;
                    var inv = System.Globalization.CultureInfo.InvariantCulture;
                    var tipLeft = Math.Clamp(focus.X / _grafico.W * 100, 12, 78);

                    <div class="sage-chart @(_ocultarRed ? "ocultar-red" : null) @(_ocultarSolar ? "ocultar-solar" : null) @(_ocultarMixto ? "ocultar-mixto" : null)" aria-label="Costo acumulado por escenario">
                        <div class="sage-chart__head">
                            <div>
                                <h3 class="sage-chart__title">Costo acumulado</h3>
                                <p class="sage-chart__hint">Tocá los puntos para fijar un año y ver el desglose</p>
                            </div>
                        </div>

                        <div class="sage-chart__canvas">
                            <svg class="sage-chart__svg" viewBox="0 0 @_grafico.W.ToString(inv) @_grafico.H.ToString(inv)" role="img" preserveAspectRatio="xMidYMid meet">
                                <defs>
                                    <linearGradient id="sageFillAhorro" x1="0" y1="0" x2="0" y2="1">
                                        <stop offset="0%" stop-color="#34C759" stop-opacity="0.22" />
                                        <stop offset="100%" stop-color="#34C759" stop-opacity="0.03" />
                                    </linearGradient>
                                    <linearGradient id="sageFillRed" x1="0" y1="0" x2="0" y2="1">
                                        <stop offset="0%" stop-color="#007AFF" stop-opacity="0.14" />
                                        <stop offset="100%" stop-color="#007AFF" stop-opacity="0" />
                                    </linearGradient>
                                    <clipPath id="sagePastClip">
                                        <rect x="0" y="0" width="@focus.X.ToString("0.##", inv)" height="@_grafico.H.ToString("0.##", inv)" />
                                    </clipPath>
                                </defs>

                                @foreach (var tick in _grafico.YTicks)
                                {
                                    <line class="sage-chart__grid" x1="@_grafico.PadL.ToString(inv)" y1="@tick.Y.ToString(inv)"
                                          x2="@((_grafico.W - _grafico.PadR).ToString(inv))" y2="@tick.Y.ToString(inv)" />
                                    @SvgText(_grafico.PadL - 8, tick.Y + 3, "sage-chart__axis", tick.Label, "end")
                                }

                                <g class="sage-chart__future" opacity="0.28">
                                    <path class="sage-chart__line sage-chart__line--red" d="@_grafico.PathRed" />
                                    <path class="sage-chart__line sage-chart__line--solar" d="@_grafico.PathSolar" />
                                    <path class="sage-chart__line sage-chart__line--mixto" d="@_grafico.PathMixto" />
                                </g>

                                <g clip-path="url(#sagePastClip)">
                                    <path class="sage-chart__area sage-chart__area--ahorro" d="@_grafico.PathAhorro" fill="url(#sageFillAhorro)" />
                                    <path class="sage-chart__area sage-chart__area--red" d="@_grafico.PathRedArea" fill="url(#sageFillRed)" />
                                    <path class="sage-chart__line sage-chart__line--red" d="@_grafico.PathRed" />
                                    <path class="sage-chart__line sage-chart__line--solar" d="@_grafico.PathSolar" />
                                    <path class="sage-chart__line sage-chart__line--mixto" d="@_grafico.PathMixto" />
                                </g>

                                @* Puntos tocables en cada año *@
                                @for (var i = 0; i < _grafico.Puntos.Count; i++)
                                {
                                    var pt = _grafico.Puntos[i];
                                    var activo = i == focusIdx;
                                    var x = pt.X.ToString(inv);
                                    var radio = activo ? "6" : "3.2";
                                    <circle cx="@x" cy="@pt.YRed.ToString(inv)" r="@radio" class="sage-chart__dot sage-chart__dot--red @(activo ? "is-active" : null)" />
                                    <circle cx="@x" cy="@pt.YSolar.ToString(inv)" r="@radio" class="sage-chart__dot sage-chart__dot--solar @(activo ? "is-active" : null)" />
                                    <circle cx="@x" cy="@pt.YMixto.ToString(inv)" r="@radio" class="sage-chart__dot sage-chart__dot--mixto @(activo ? "is-active" : null)" />
                                }

                                <line class="sage-chart__scrub" x1="@focus.X.ToString(inv)" y1="@_grafico.PadT.ToString(inv)"
                                      x2="@focus.X.ToString(inv)" y2="@((_grafico.H - _grafico.PadB).ToString(inv))" />

                                @for (var i = 0; i < _grafico.Puntos.Count; i++)
                                {
                                    var pt = _grafico.Puntos[i];
                                    var idx = i;
                                    <rect class="sage-chart__hit"
                                          x="@((pt.X - _grafico.HitW / 2).ToString(inv))"
                                          y="@_grafico.PadT.ToString(inv)"
                                          width="@_grafico.HitW.ToString(inv)"
                                          height="@((_grafico.H - _grafico.PadT - _grafico.PadB).ToString(inv))"
                                          @onmouseenter="@(() => SeleccionarAnio(idx, hover: true))"
                                          @onclick="@(() => SeleccionarAnio(idx, hover: false))"
                                          @onfocus="@(() => SeleccionarAnio(idx, hover: true))"
                                          @onkeyup="@(e => { if (e.Key is "Enter" or " ") SeleccionarAnio(idx, hover: false); })"
                                          tabindex="0"
                                          role="button"
                                          aria-label="@pt.Etiqueta" />
                                    @if (i == 0 || i == _grafico.Puntos.Count - 1 || i % Math.Max(1, _grafico.Puntos.Count / 5) == 0)
                                    {
                                        @SvgText(pt.X, _grafico.H - 10, "sage-chart__axis sage-chart__axis--x", pt.EtiquetaCorta, "middle")
                                    }
                                }
                            </svg>

                            <div @key="_tipKey" class="sage-chart__tip @(_anioFijado ? "is-locked" : null)" style="@($"left:{tipLeft.ToString("0.##", inv)}%")">
                                <p class="sage-chart__tip-year">@focus.Etiqueta@(_anioFijado ? " · fijado" : "")</p>
                                @if (!_ocultarRed)
                                {
                                    <div class="sage-chart__tip-row"><span class="sage-chart__swatch sage-chart__swatch--red"></span><span>Solo red</span><b>@Bs(focus.Red)</b></div>
                                }
                                @if (!_ocultarSolar)
                                {
                                    <div class="sage-chart__tip-row"><span class="sage-chart__swatch sage-chart__swatch--solar"></span><span>Solar sugerido</span><b>@Bs(focus.Solar)</b></div>
                                }
                                @if (!_ocultarMixto)
                                {
                                    <div class="sage-chart__tip-row"><span class="sage-chart__swatch sage-chart__swatch--mixto"></span><span>Tu propuesta</span><b>@Bs(focus.Mixto)</b></div>
                                }
                            </div>
                        </div>

                        <div class="sage-delta" role="list">
                            <div class="sage-delta__row" role="listitem">
                                <div class="sage-delta__left">
                                    <span class="sage-chart__swatch sage-chart__swatch--red"></span>
                                    <div>
                                        <button type="button" class="sage-delta__name sage-chart__toggle"
                                                aria-pressed="@(!_ocultarRed ? "true" : "false")" @onclick="@(() => _ocultarRed = !_ocultarRed)">Solo red</button>
                                        <p class="sage-delta__sub">Escenario base</p>
                                    </div>
                                </div>
                                <div class="sage-delta__right">
                                    <p class="sage-delta__value">@Bs(focus.Red)</p>
                                    <p class="sage-delta__note">Referencia</p>
                                </div>
                            </div>
                            <div class="sage-delta__row" role="listitem">
                                <div class="sage-delta__left">
                                    <span class="sage-chart__swatch sage-chart__swatch--solar"></span>
                                    <div>
                                        <button type="button" class="sage-delta__name sage-chart__toggle"
                                                aria-pressed="@(!_ocultarSolar ? "true" : "false")" @onclick="@(() => _ocultarSolar = !_ocultarSolar)">Solar sugerido</button>
                                        <p class="sage-delta__sub">Comparado con red</p>
                                    </div>
                                </div>
                                <div class="sage-delta__right">
                                    <p class="sage-delta__value">@Bs(focus.Solar)</p>
                                    <p class="sage-delta__note @(deltaSolar >= 0 ? "is-save" : "is-spend")">
                                        @(deltaSolar >= 0 ? "Ahorrás" : "Gastás") @Bs(Math.Abs(deltaSolar))
                                    </p>
                                </div>
                            </div>
                            <div class="sage-delta__row" role="listitem">
                                <div class="sage-delta__left">
                                    <span class="sage-chart__swatch sage-chart__swatch--mixto"></span>
                                    <div>
                                        <button type="button" class="sage-delta__name sage-chart__toggle"
                                                aria-pressed="@(!_ocultarMixto ? "true" : "false")" @onclick="@(() => _ocultarMixto = !_ocultarMixto)">Tu propuesta</button>
                                        <p class="sage-delta__sub">Comparado con red</p>
                                    </div>
                                </div>
                                <div class="sage-delta__right">
                                    <p class="sage-delta__value">@Bs(focus.Mixto)</p>
                                    <p class="sage-delta__note @(deltaMixto >= 0 ? "is-save" : "is-spend")">
                                        @(deltaMixto >= 0 ? "Ahorrás" : "Gastás") @Bs(Math.Abs(deltaMixto))
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                }

                @foreach (var adv in _resultado.Advertencias)
                {
                    <MudAlert Severity="Severity.Warning" Class="mt-3">@adv</MudAlert>
                }
                @if (_resultado.Detalle is { } detalle)
                {
                    @foreach (var (nombre, excedente) in new[] { ("Solar sugerido", detalle.ExcedenteSolarKwhMes), ("Tu propuesta", detalle.ExcedentePropuestaKwhMes) })
                    {
                        @if (excedente > 0m)
                        {
                            <MudAlert Severity="Severity.Info" Class="mt-3">
                                <strong>@nombre.</strong> Tu sistema produce @Numero(excedente) kWh/mes de más; ese excedente no se cuenta como ahorro
                            </MudAlert>
                        }
                    }
                    <MudExpansionPanels Class="mt-4" @key="_resultado">
                        <MudExpansionPanel Text="Cómo se calculó">
                            <MudText>Facturas usadas en esta corrida</MudText>
                            <FacturasSimulacion Facturas="detalle.Facturas" />
                            <ol class="sage-assumptions mt-3">
                                @foreach (var paso in detalle.Pasos)
                                {
                                    <li>@paso</li>
                                }
                            </ol>
                        </MudExpansionPanel>
                    </MudExpansionPanels>
                }
                <MudExpansionPanels Class="mt-3">
                    <MudExpansionPanel Text="Limitaciones del modelo">
                        <ul class="sage-assumptions">
                            <li>No considera suba anual de tarifa, pérdida de rendimiento de los paneles, créditos, intereses ni cambio de inversor.</li>
                            <li>El excedente no se vende a la red. Los costos se expresan en Bs de hoy y el modelo no incluye baterías.</li>
                            <li>La simulación usa facturas. La comparación MEDIDA con datos de la maqueta está en Historial y Ensayos.</li>
                        </ul>
                    </MudExpansionPanel>
                </MudExpansionPanels>
            </div>
        }

        <section class="home-group" aria-label="Simulaciones guardadas">
            <MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                <h2 class="home-group__title">Simulaciones guardadas</h2>
                <MudChip T="string" Color="Color.Info" Size="Size.Small">SIMULACIÓN</MudChip>
            </MudStack>
            <div class="page-panel">
                <MudTable Items="_guardadas" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm" Elevation="0">
                    <HeaderContent>
                        <MudTh>Fecha</MudTh>
                        <MudTh>Horizonte</MudTh>
                        <MudTh>Tarifa</MudTh>
                        <MudTh>Solo red</MudTh>
                        <MudTh>Solar sugerido</MudTh>
                        <MudTh>Tu propuesta</MudTh>
                        <MudTh>Detalle</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Fecha">@Formato.HoraLocal(context.Fecha)</MudTd>
                        <MudTd DataLabel="Horizonte">@context.HorizonteAnios años</MudTd>
                        <MudTd DataLabel="Tarifa">
                            @Tarifa(context.Detalle?.TarifaUsadaBsKwh ?? context.TarifaUsadaBsKwh)
                            @if (context.Detalle is { } datos)
                            {
                                <MudText Typo="Typo.caption">@SimulacionBuilder.NombreTarifa(datos.OrigenTarifa)</MudText>
                            }
                        </MudTd>
                        <MudTd DataLabel="Solo red">@Numero(context.CostoAcumRedBs) Bs</MudTd>
                        <MudTd DataLabel="Solar sugerido">@Numero(context.CostoAcumSolarBs) Bs · @ResumenPotencia(context, solar: true)</MudTd>
                        <MudTd DataLabel="Tu propuesta">@Numero(context.CostoAcumMixtoBs) Bs · @ResumenPotencia(context, solar: false)</MudTd>
                        <MudTd DataLabel="Detalle"><MudButton OnClick="@(() => MostrarResultado(context))">Ver resultado</MudButton></MudTd>
                    </RowTemplate>
                    <NoRecordsContent>
                        <div class="sage-empty">
                            <p class="sage-empty__title">Todavía no hay guardadas</p>
                            <p class="sage-empty__text">Los resultados guardados de esta empresa aparecerán acá.</p>
                        </div>
                    </NoRecordsContent>
                </MudTable>
            </div>
        </section>
    }
</div>

@code {
    private bool _cargando = true;
    private bool _simulando;
    private bool _guardando;
    private bool _guardandoTarifa;
    private bool _puedeSimular => !UsuarioActual.EsOperador && !UsuarioActual.DebeCambiarContrasena &&
        (UsuarioActual.EsAdministrador || UsuarioActual.EsTecnico);
    private string? _error;
    private string? _errorPresupuesto;
    private MudForm _formulario = null!;
    private MudNumericField<decimal?>? _campoNuevaTarifa;

    private ParametrosEconomicos? _parametros;
    private List<Instaladora> _instaladoras = [];
    private List<Factura> _facturas = [];
    private List<FacturaBaseSimulacion> _facturasBase = [];
    private decimal _consumo;
    private decimal? _tarifaFacturas;
    private decimal? _tarifaPropia;
    private decimal? _tarifaConfigurada => _tarifaPropia ?? _parametros?.TarifaBsKwh;
    private decimal? _nuevaTarifa;
    private OrigenTarifaSimulacion _origenTarifa = OrigenTarifaSimulacion.Facturas;
    private decimal? _tarifaManual = 0.90m;
    private decimal? TarifaActiva => _origenTarifa switch
    {
        OrigenTarifaSimulacion.Configurada => _tarifaConfigurada,
        OrigenTarifaSimulacion.Manual => _tarifaManual,
        _ => _tarifaFacturas
    };
    private bool HayBase => _tarifaFacturas.HasValue && _parametros is not null;

    private readonly EntradaSolar _solar = new();
    private readonly EntradaSolar _propuesta = new();
    private decimal? _cobertura = 100m;
    private decimal? _kwpPropuesta = 3m;
    private decimal? _metaKwhMes = 375m;
    private ModoPropuesta _modoPropuesta = ModoPropuesta.KwhMes;
    private Dictionary<int, decimal> _produccionHistorica = [];
    private decimal? _presupuesto;
    private int _instaladoraPresupuestoId;
    private SugerenciaPresupuesto? _sugerencia;
    private decimal? _presupuestoAplicado;
    private int? _horizonte = 10;

    private Data.Simulacion? _resultado;
    private ElementReference _panelResultado;
    private bool _enfocarResultado;
    private List<FilaResultado> _filasResultado = [];
    private GraficoAcumulado? _grafico;
    private int? _hoverAnio;
    private bool _anioFijado;
    private int _tipKey;
    private bool _ocultarRed, _ocultarSolar, _ocultarMixto;

    private List<Data.Simulacion> _guardadas = [];

    protected override async Task OnInitializedAsync()
    {
        await UsuarioActual.CargarAsync();
        try
        {
            if (UsuarioActual.EmpresaActivaId is not int empresaId || !UsuarioActual.PuedeVerEmpresa(empresaId))
                return;

            using var scope = ScopeFactory.CreateScope();
            var db = scope.ServiceProvider.GetRequiredService<ApplicationDbContext>();
            _guardadas = await db.Simulaciones.AsNoTracking()
                .Where(s => s.EmpresaId == empresaId)
                .OrderByDescending(s => s.Fecha).ToListAsync();

            var versiones = _guardadas.Where(s => s.Detalle is null).Select(s => s.ParametrosVersion).Distinct().ToArray();
            _produccionHistorica = await db.ParametrosEconomicos.AsNoTracking().Where(p => versiones.Contains(p.Version))
                .ToDictionaryAsync(p => p.Version, p => p.GeneracionKwhKwpMes);

            if (!_puedeSimular)
                return;

            _parametros = await db.ParametrosEconomicos.AsNoTracking()
                .OrderByDescending(p => p.Version).FirstOrDefaultAsync();
            _tarifaPropia = await db.TarifasEmpresa.AsNoTracking()
                .Where(t => t.EmpresaId == empresaId)
                .OrderByDescending(t => t.VigenteDesde)
                .Select(t => (decimal?)t.TarifaBsKwh).FirstOrDefaultAsync();
            _nuevaTarifa = _tarifaConfigurada;
            _instaladoras = await db.Instaladoras.AsNoTracking().Where(i => i.Activa)
                .OrderBy(i => i.Nombre).ToListAsync();
            _facturas = await db.Facturas.AsNoTracking()
                .Where(f => f.EmpresaId == empresaId)
                .OrderByDescending(f => f.Anio).ThenByDescending(f => f.Mes)
                .Take(12).ToListAsync();
            (_consumo, _tarifaFacturas) = SimulacionBuilder.ResumirFacturas(_facturas);
            _facturasBase = _facturas.Select(f => new FacturaBaseSimulacion(f.Anio, f.Mes, f.ConsumoKwh, f.MontoBs)).ToList();
            _solar.Produccion = _propuesta.Produccion = _parametros?.GeneracionKwhKwpMes;
            if (_propuesta.Produccion is decimal produccion)
                _metaKwhMes = _kwpPropuesta * produccion;
            ElegirInstaladora(_solar, 0);
            ElegirInstaladora(_propuesta, 0);
        }
        finally
        {
            _cargando = false;
        }
    }

    private void ElegirInstaladora(EntradaSolar entrada, int id)
    {
        var instaladora = _instaladoras.Find(i => i.Id == id);
        entrada.InstaladoraId = id;
        entrada.Nombre = instaladora?.Nombre ?? "Referencia SAGE";
        entrada.Precio = instaladora?.BsPorKwp ?? _parametros?.CostoInstalacionBsKwp;
        entrada.MantenimientoPorKwp = instaladora?.MantenimientoBsKwpAnio ?? _parametros?.MantenimientoBsKwpAnio;
        PrecioCambiado(entrada);
    }

    private decimal? Potencia(EntradaSolar entrada)
    {
        if (entrada == _propuesta && _modoPropuesta == ModoPropuesta.Kwp)
            return RangosSimulacion.Potencia(_kwpPropuesta) is null ? _kwpPropuesta : null;

        var energia = entrada == _solar
            ? RangosSimulacion.Cobertura(_cobertura) is null ? _consumo * (_cobertura / 100m) : null
            : RangosSimulacion.MetaKwh(_metaKwhMes) is null ? _metaKwhMes : null;
        return energia is > 0m && RangosSimulacion.Produccion(entrada.Produccion) is null
            ? SimulacionBuilder.PotenciaPorEnergia(energia.Value, entrada.Produccion!.Value) : null;
    }

    private string? ValidarMeta(decimal? valor) =>
        RangosSimulacion.MetaKwh(valor) ??
        (RangosSimulacion.Produccion(_propuesta.Produccion) is null
            ? RangosSimulacion.Potencia(SimulacionBuilder.PotenciaPorEnergia(valor!.Value, _propuesta.Produccion!.Value))
            : null);

    private static void EditarMantenimiento(EntradaSolar entrada, decimal? valor)
    {
        entrada.Mantenimiento = valor;
        entrada.MantenimientoManual = true;
    }

    private void PrecioCambiado(EntradaSolar entrada)
    {
        if (entrada == _propuesta)
            DesvincularPresupuesto();
    }

    private void DesvincularPresupuesto() => _presupuestoAplicado = null;

    private void LimpiarSugerencia()
    {
        _errorPresupuesto = null;
        _sugerencia = null;
    }

    private void SugerirSistema()
    {
        LimpiarSugerencia();
        if (!HayBase)
            return;

        var referencia = new EntradaSolar();
        ElegirInstaladora(referencia, _instaladoraPresupuestoId);
        try
        {
            _sugerencia = SimulacionBuilder.SugerirPorPresupuesto(_presupuesto ?? 0m, _consumo,
                referencia.Nombre, referencia.Precio!.Value, _parametros!.GeneracionKwhKwpMes);
        }
        catch (InvalidOperationException ex)
        {
            _errorPresupuesto = ex.Message;
        }
    }

    private void AplicarSugerencia()
    {
        if (_sugerencia is not { } sugerencia || _parametros is null)
            return;

        ElegirInstaladora(_propuesta, _instaladoraPresupuestoId);
        _propuesta.Produccion = _parametros.GeneracionKwhKwpMes;
        _propuesta.EsManual = false;
        _kwpPropuesta = sugerencia.PotenciaKwp;
        _modoPropuesta = ModoPropuesta.Kwp;
        _presupuestoAplicado = sugerencia.PresupuestoBs;
    }

    private static string PorcentajeCobertura(decimal cobertura) =>
        cobertura >= 1m ? Numero(decimal.Floor(cobertura)) : Numero(cobertura);

    private async Task Simular()
    {
        if (_simulando || !_puedeSimular || !HayBase)
            return;

        _simulando = true;
        _error = null;
        _resultado = null;
        try
        {
            if (UsuarioActual.EmpresaActivaId is not int empresaId || !UsuarioActual.PuedeVerEmpresa(empresaId))
                throw new InvalidOperationException("No tenés una empresa activa válida.");
            if (_parametros is null || _tarifaConfigurada is not decimal configurada)
                throw new InvalidOperationException("Faltan parámetros económicos para simular.");

            await _formulario.ValidateAsync();
            if (!_formulario.IsValid || UsuarioActual.EmpresaActivaId != empresaId)
                return;

            var builder = new SimulacionBuilder()
                .ParaEmpresa(new Empresa { Id = empresaId })
                .ConConsumo(_facturas)
                .ConParametros(_parametros)
                .ConTarifa(_origenTarifa, configurada, _tarifaManual)
                .ConSolarSugerido(_cobertura!.Value, _solar.Datos())
                .ConHorizonte(_horizonte!.Value);
            if (_modoPropuesta == ModoPropuesta.KwhMes)
                builder.ConPropuestaPorKwh(_metaKwhMes!.Value, _propuesta.Datos());
            else
                builder.ConPropuesta(_kwpPropuesta!.Value, _propuesta.Datos(), _presupuestoAplicado);
            MostrarResultado(builder.Construir());
        }
        catch (InvalidOperationException ex)
        {
            _error = ex.Message;
        }
        catch (OverflowException)
        {
            _error = "Los importes ingresados son demasiado grandes para calcular el resultado.";
        }
        finally
        {
            _simulando = false;
        }
    }

    private void MostrarResultado(Data.Simulacion simulacion)
    {
        if (UsuarioActual.EmpresaActivaId != simulacion.EmpresaId || !UsuarioActual.PuedeVerEmpresa(simulacion.EmpresaId))
            return;

        _resultado = simulacion;
        _enfocarResultado = true;
        ConstruirTabla(simulacion);
        ConstruirGrafico(simulacion);
        _hoverAnio = null;
        _ocultarRed = _ocultarSolar = _ocultarMixto = false;
        _anioFijado = false;
        _tipKey++;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_enfocarResultado && _resultado is not null)
        {
            _enfocarResultado = false;
            await _panelResultado.FocusAsync();
        }
    }

    private void ConstruirTabla(Data.Simulacion s)
    {
        _filasResultado = new()
        {
            new FilaResultado("Solo red", "—", 0m, s.CostoAnualRedBs, s.CostoAcumRedBs, 0m, "—"),
            new FilaResultado("Solar sugerido", ResumenPotencia(s, solar: true), s.InversionSolarBs, s.CostoAnualSolarBs, s.CostoAcumSolarBs,
                s.CostoAcumRedBs - s.CostoAcumSolarBs, Recuperacion(s.RecuperacionSolarAnios)),
            new FilaResultado("Tu propuesta", ResumenPotencia(s, solar: false), s.InversionMixtoBs, s.CostoAnualMixtoBs, s.CostoAcumMixtoBs,
                s.CostoAcumRedBs - s.CostoAcumMixtoBs, Recuperacion(s.RecuperacionMixtoAnios))
        };
    }

    private void ConstruirGrafico(Data.Simulacion s)
    {
        const double w = 920;
        const double h = 340;
        const double padL = 64;
        const double padR = 28;
        const double padT = 18;
        const double padB = 36;

        // Año 0 = inversión inicial; después el acumulado año a año.
        var n = s.HorizonteAnios;
        var red = new double[n + 1];
        var solar = new double[n + 1];
        var mixto = new double[n + 1];
        red[0] = 0;
        solar[0] = (double)s.InversionSolarBs;
        mixto[0] = (double)s.InversionMixtoBs;

        for (var y = 1; y <= n; y++)
        {
            red[y] = (double)(y * s.CostoAnualRedBs);
            solar[y] = (double)(s.InversionSolarBs + y * s.CostoAnualSolarBs);
            mixto[y] = (double)(s.InversionMixtoBs + y * s.CostoAnualMixtoBs);
        }

        var maxY = Math.Max(1, red.Concat(solar).Concat(mixto).Max()) * 1.08;
        var plotW = w - padL - padR;
        var plotH = h - padT - padB;
        double X(int i) => padL + (n == 0 ? 0 : plotW * i / n);
        double Y(double v) => padT + plotH * (1 - v / maxY);

        var puntos = new List<GraficoPunto>(n + 1);
        for (var i = 0; i <= n; i++)
        {
            puntos.Add(new GraficoPunto(
                i,
                i == 0 ? "Hoy" : $"Año {i}",
                i == 0 ? "0" : i.ToString(),
                X(i),
                Y(red[i]),
                Y(solar[i]),
                Y(mixto[i]),
                red[i],
                solar[i],
                mixto[i]));
        }

        string LinePath(Func<GraficoPunto, double> sel)
        {
            var sb = new System.Text.StringBuilder();
            for (var i = 0; i < puntos.Count; i++)
            {
                sb.Append(i == 0 ? "M" : "L")
                  .Append(puntos[i].X.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))
                  .Append(' ')
                  .Append(sel(puntos[i]).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))
                  .Append(' ');
            }
            return sb.ToString().Trim();
        }

        string AreaPath(Func<GraficoPunto, double> sel)
        {
            var line = LinePath(sel);
            var yBase = Y(0).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
            var x0 = puntos[0].X.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
            var xn = puntos[^1].X.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
            return $"{line} L{xn} {yBase} L{x0} {yBase} Z";
        }

        // Franja de ahorro: entre Red y Solar (solo donde Red > Solar).
        var ahorro = new System.Text.StringBuilder();
        ahorro.Append('M')
              .Append(puntos[0].X.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)).Append(' ')
              .Append(puntos[0].YRed.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture));
        for (var i = 1; i < puntos.Count; i++)
        {
            ahorro.Append(" L")
                  .Append(puntos[i].X.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)).Append(' ')
                  .Append(puntos[i].YRed.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture));
        }
        for (var i = puntos.Count - 1; i >= 0; i--)
        {
            ahorro.Append(" L")
                  .Append(puntos[i].X.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)).Append(' ')
                  .Append(puntos[i].YSolar.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture));
        }
        ahorro.Append(" Z");

        var yTicks = new List<GraficoTick>();
        for (var t = 0; t <= 4; t++)
        {
            var val = maxY * t / 4;
            yTicks.Add(new GraficoTick(Y(val), BsCorto(val)));
        }

        _grafico = new GraficoAcumulado(
            W: w,
            H: h,
            PadL: padL,
            PadR: padR,
            PadT: padT,
            PadB: padB,
            HitW: Math.Max(18, plotW / Math.Max(1, n) * 0.9),
            PathRed: LinePath(p => p.YRed),
            PathSolar: LinePath(p => p.YSolar),
            PathMixto: LinePath(p => p.YMixto),
            PathRedArea: AreaPath(p => p.YRed),
            PathSolarArea: AreaPath(p => p.YSolar),
            PathAhorro: ahorro.ToString(),
            EndX: puntos[^1].X,
            EndRedY: puntos[^1].YRed,
            EndSolarY: puntos[^1].YSolar,
            EndMixtoY: puntos[^1].YMixto,
            Puntos: puntos,
            YTicks: yTicks);
    }

    private void SeleccionarAnio(int idx, bool hover)
    {
        if (_grafico is null)
            return;

        idx = Math.Clamp(idx, 0, _grafico.Puntos.Count - 1);

        if (hover && _anioFijado)
            return;

        if (!hover)
        {
            if (_anioFijado && _hoverAnio == idx)
            {
                _anioFijado = false;
            }
            else
            {
                _anioFijado = true;
                _hoverAnio = idx;
            }

            _tipKey++;
            return;
        }

        _hoverAnio = idx;
    }

    private static string Bs(double v) =>
        v.ToString("N0", FacturaReglas.Cultura) + " Bs";

    private static string BsCorto(double v)
    {
        if (v >= 1_000_000)
            return (v / 1_000_000d).ToString("0.#", FacturaReglas.Cultura) + " M";
        if (v >= 1_000)
            return (v / 1_000d).ToString("0.#", FacturaReglas.Cultura) + " mil";
        return v.ToString("N0", FacturaReglas.Cultura);
    }

    // Blazor reserva <text>; el SVG se emite como MarkupString.
    private static MarkupString SvgText(double x, double y, string css, string content, string anchor = "start")
    {
        var inv = System.Globalization.CultureInfo.InvariantCulture;
        var safe = System.Net.WebUtility.HtmlEncode(content);
        return new MarkupString(
            $"<text class=\"{css}\" x=\"{x.ToString("0.##", inv)}\" y=\"{y.ToString("0.##", inv)}\" text-anchor=\"{anchor}\">{safe}</text>");
    }

    private async Task Guardar()
    {
        if (_guardando || !_puedeSimular || _resultado is not { Id: 0 } resultado)
            return;

        _guardando = true;
        try
        {
            if (UsuarioActual.EmpresaActivaId != resultado.EmpresaId || !UsuarioActual.PuedeVerEmpresa(resultado.EmpresaId))
            {
                Snackbar.Add("El resultado no pertenece a tu empresa activa.", Severity.Error);
                return;
            }

            if (UsuarioActual.UsuarioId is not string usuarioId)
            {
                Snackbar.Add("No se pudo identificar al usuario.", Severity.Error);
                return;
            }

            using var scope = ScopeFactory.CreateScope();
            var db = scope.ServiceProvider.GetRequiredService<ApplicationDbContext>();

            resultado.UsuarioId = usuarioId;
            resultado.Fecha = DateTime.UtcNow;
            db.Simulaciones.Add(resultado);
            await db.SaveChangesAsync();
            _guardadas.Insert(0, resultado);
            Snackbar.Add("Simulación guardada.", Severity.Success);
        }
        catch
        {
            Snackbar.Add("No se pudo guardar la simulación.", Severity.Error);
        }
        finally
        {
            _guardando = false;
        }
    }

    private async Task FijarTarifa()
    {
        if (_guardandoTarifa)
            return;

        if (_campoNuevaTarifa is null)
            return;

        await _campoNuevaTarifa.ValidateAsync();
        if (_campoNuevaTarifa.HasErrors || _nuevaTarifa is not decimal tarifa)
            return;

        _guardandoTarifa = true;
        try
        {
            if (!UsuarioActual.EsAdministrador ||
                UsuarioActual.EmpresaActivaId is not int empresaId ||
                !UsuarioActual.PuedeVerEmpresa(empresaId) ||
                UsuarioActual.UsuarioId is not string usuarioId)
            {
                Snackbar.Add("No tenés permiso para fijar la tarifa.", Severity.Error);
                return;
            }

            using var scope = ScopeFactory.CreateScope();
            var db = scope.ServiceProvider.GetRequiredService<ApplicationDbContext>();

            db.TarifasEmpresa.Add(new TarifaEmpresa
            {
                EmpresaId = empresaId,
                TarifaBsKwh = tarifa,
                VigenteDesde = DateTime.UtcNow,
                CreadoPorId = usuarioId
            });
            await db.SaveChangesAsync();
            Snackbar.Add("Tarifa de la empresa actualizada.", Severity.Success);
            _tarifaPropia = tarifa;
        }
        catch
        {
            Snackbar.Add("No se pudo fijar la tarifa.", Severity.Error);
        }
        finally
        {
            _guardandoTarifa = false;
        }
    }

    private static string Recuperacion(decimal? anios) =>
        anios is decimal a ? $"{Numero(a)} años" : "No se recupera en el horizonte";

    private string ResumenPotencia(Data.Simulacion simulacion, bool solar)
    {
        var kwp = solar ? simulacion.KwpSolar : simulacion.Detalle?.PotenciaPropuestaKwp ?? simulacion.KwpMixto;
        var datos = solar ? simulacion.Detalle?.Solar : simulacion.Detalle?.Propuesta;
        var produccion = datos?.ProduccionKwhKwpMes ?? _produccionHistorica.GetValueOrDefault(simulacion.ParametrosVersion);
        return PotenciaConProduccion(kwp, produccion > 0m ? produccion : null);
    }

    private static string PotenciaConProduccion(decimal kwp, decimal? produccion) =>
        produccion is decimal tasa ? $"{Numero(kwp)} kWp · ≈ {Numero(kwp * tasa)} kWh/mes" : $"{Numero(kwp)} kWp";

    private static string Numero(decimal valor) => valor.ToString("#,0.####", FacturaReglas.Cultura);

    private static string Tarifa(decimal? valor) => valor is decimal tarifa ? $"{Numero(tarifa)} Bs/kWh" : "Sin datos";

