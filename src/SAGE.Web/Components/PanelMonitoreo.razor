@page "/monitoreo/{Id:int}"
@attribute [Authorize(Roles = "Administrador,Tecnico,Consulta")]
@implements IDisposable

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components
@using Microsoft.EntityFrameworkCore
@using MudBlazor
@using SAGE.Web.Data
@using SAGE.Web.Servicios
@using SAGE.Web.Servicios.EnVivo
@using SAGE.Web.Servicios.Seguridad
@using SAGE.Web.Components.Shared
@using SAGE.Web.Servicios.Ordenes
@using SAGE.Web.Servicios.Telemetria

@inject IServiceScopeFactory ScopeFactory
@inject IUsuarioActual UsuarioActual
@inject EstadoDispositivosEnVivo EnVivo
@inject ICanalOrdenes CanalOrdenes
@inject ISnackbar Snackbar

<PageTitle>Monitoreo de dispositivo - SAGE</PageTitle>

<div class="page">

    @if (cargando)
    {
        <MudProgressCircular Indeterminate="true"
                             Color="Color.Primary" />
    }
    else if (dispositivo is null)
    {
        <MudAlert Severity="Severity.Warning">
            No encontrado.
        </MudAlert>
    }
    else
    {
        <MudStack Spacing="3">

            <MudButton Href="/monitoreo"
                       Variant="Variant.Text"
                       Color="Color.Primary">
                Volver al monitoreo
            </MudButton>

            <MudPaper Class="pa-4" Elevation="1">

                <MudText Typo="Typo.h5">
                    @dispositivo.Nombre
                </MudText>

                <MudStack Row="true"
                          Spacing="2"
                          Class="mt-2">

                    <MudChip T="string"
                             Color="@(EnLinea ? Color.Success : Color.Error)">
                        @(EnLinea ? "● En línea" : "● Sin conexión")
                    </MudChip>

                    <MudChip T="string"
                             Color="Color.Info">
                        @(dispositivo.EsSimulado ? "SIMULADO" : "REAL")
                    </MudChip>

                    <ChipEscala Factor="@dispositivo.FactorEscala" />

                </MudStack>

                <MudText Class="mt-3">
                    Última conexión:
                    @Formato.Hace(
                        estado?.TsServidor ?? dispositivo.UltimoContacto)
                </MudText>

                <MudText>
                    Modo:
                    @Formato.Modo(
                        estado?.Modo ?? dispositivo.ModoActual ?? "",
                        estado?.FuenteSeleccionada
                            ?? dispositivo.FuenteSeleccionada ?? "")
                </MudText>

            </MudPaper>

            <MudTabs Elevation="1"
                     Rounded="true"
                     ApplyEffectsToContainer="true"
                     TabPanelsClass="pt-4">

            <MudTabPanel Text="Monitoreo"
                         Icon="@Icons.Material.Outlined.MonitorHeart">

            <MudStack Spacing="3">

            <MudPaper Class="pa-4" Elevation="1">

                <MudText Typo="Typo.h6">
                    Estado de alimentación
                </MudText>

                <MudStack Row="true"
                          Spacing="2"
                          Class="mt-3"
                          Style="flex-wrap:wrap">

                    <MudChip T="string"
                             Color="Color.Info">
                        Solicitada: @ModoSolicitado
                    </MudChip>

                    <MudChip T="string"
                             Color="Color.Primary">
                        Seleccionada:
                        @Formato.Fuente(
                            estado?.FuenteSeleccionada
                            ?? dispositivo.FuenteSeleccionada ?? "")
                    </MudChip>

                    <MudChip T="string"
                             Color="@(Comprobada ? Color.Success : Color.Warning)">
                        Comprobada: @TextoComprobacion
                    </MudChip>

                </MudStack>

            </MudPaper>

            @* S23-M9: Control de fuente (patrón Command). Solo Admin y Técnico. *@
            @if (PuedeControlar)
            {
                <MudPaper Class="pa-4" Elevation="1">

                    <MudText Typo="Typo.h6">
                        Control de fuente
                    </MudText>

                    <MudStack Row="true"
                              Spacing="2"
                              Class="mt-3"
                              Style="flex-wrap:wrap">

                        @foreach (var (modo, texto, icono) in BotonesModo)
                        {
                            var actual = ModoActual == modo;
                            <MudButton Variant="@(actual ? Variant.Filled : Variant.Outlined)"
                                       Color="Color.Primary"
                                       StartIcon="@icono"
                                       Disabled="@enviandoOrden"
                                       OnClick="@(() => EnviarModoAsync(modo))">
                                @texto
                            </MudButton>
                        }

                    </MudStack>

                    @if (ordenes.Count > 0)
                    {
                        var ultima = ordenes[0];
                        <MudStack Row="true"
                                  Spacing="2"
                                  AlignItems="AlignItems.Center"
                                  Class="mt-3">
                            <MudText Typo="Typo.body2">
                                Última orden (@TextosOrdenes.Descripcion(ultima)):
                            </MudText>
                            <MudChip T="string"
                                     Color="@ColorOrden(ultima.Estado)"
                                     Variant="Variant.Filled">
                                @TextosOrdenes.EstadoConMotivo(ultima)
                            </MudChip>
                        </MudStack>
                    }

                </MudPaper>
            }

            @if (ordenes.Count > 0)
            {
                <MudPaper Class="pa-4" Elevation="1">

                    <MudText Typo="Typo.h6">
                        Últimas 10 órdenes
                    </MudText>

                    <MudTable T="Orden"
                              Items="@ordenes"
                              Dense="true"
                              Hover="true"
                              Class="mt-2">

                        <HeaderContent>
                            <MudTh>Hora</MudTh>
                            <MudTh>Quién</MudTh>
                            <MudTh>Orden</MudTh>
                            <MudTh>Estado</MudTh>
                            <MudTh>Motivo</MudTh>
                            <MudTh>Tiempo hasta resolverse</MudTh>
                        </HeaderContent>

                        <RowTemplate>
                            <MudTd DataLabel="Hora">
                                @Formato.HoraLocal(context.Creada)
                            </MudTd>
                            <MudTd DataLabel="Quién">
                                @(context.Usuario?.NombreCompleto ?? "—")
                            </MudTd>
                            <MudTd DataLabel="Orden">
                                @TextosOrdenes.Descripcion(context)
                            </MudTd>
                            <MudTd DataLabel="Estado">
                                <MudChip T="string"
                                         Size="Size.Small"
                                         Color="@ColorOrden(context.Estado)">
                                    @TextosOrdenes.Estado(context.Estado)
                                </MudChip>
                            </MudTd>
                            <MudTd DataLabel="Motivo">
                                @TextosOrdenes.Motivo(context.Motivo)
                            </MudTd>
                            <MudTd DataLabel="Tiempo hasta resolverse">
                                @(context.Resuelta is DateTime r
                                    ? ((decimal)(r - context.Creada).TotalSeconds).ToString("N1", System.Globalization.CultureInfo.GetCultureInfo("es-BO")) + " s"
                                    : "—")
                            </MudTd>
                        </RowTemplate>

                    </MudTable>

                </MudPaper>
            }

            <MudGrid Spacing="3">

                <MudItem xs="12" md="6">

                    <MudPaper Class="pa-4" Elevation="1">

                        <MudText Typo="Typo.h6"
                                 Color="Color.Success">
                            Energía solar
                        </MudText>

                        <MudDivider Class="my-3" />

                        <MudText>
                            Tensión:
                            @Formato.Tension(estado?.VSol ?? 0m)
                        </MudText>

                        <MudText>
                            Corriente:
                            @Formato.Corriente(estado?.ISolMa ?? 0m)
                        </MudText>

                        <MudText>
                            Potencia:
                            @Formato.Potencia(
                                estado?.PSolMw ?? 0m,
                                dispositivo.FactorEscala)
                        </MudText>

                        <MudText>
                            Energía acumulada:
                            @Formato.Energia(
                                estado?.WhSolAcum ?? 0m,
                                dispositivo.FactorEscala)
                        </MudText>

                        <ChipEscala Factor="@dispositivo.FactorEscala" />

                    </MudPaper>

                </MudItem>

                <MudItem xs="12" md="6">

                    <MudPaper Class="pa-4" Elevation="1">

                        <MudText Typo="Typo.h6"
                                 Color="Color.Primary">
                            Energía de red
                        </MudText>

                        <MudDivider Class="my-3" />

                        <MudText>
                            Tensión:
                            @Formato.Tension(estado?.VRed ?? 0m)
                        </MudText>

                        <MudText>
                            Corriente:
                            @Formato.Corriente(estado?.IRedMa ?? 0m)
                        </MudText>

                        <MudText>
                            Potencia:
                            @Formato.Potencia(
                                estado?.PRedMw ?? 0m,
                                dispositivo.FactorEscala)
                        </MudText>

                        <MudText>
                            Energía acumulada:
                            @Formato.Energia(
                                estado?.WhRedAcum ?? 0m,
                                dispositivo.FactorEscala)
                        </MudText>

                        <ChipEscala Factor="@dispositivo.FactorEscala" />

                    </MudPaper>

                </MudItem>

            </MudGrid>

            <MudPaper Class="pa-4" Elevation="1">

                <MudText Typo="Typo.h6">
                    Potencia en tiempo real
                </MudText>

                <MudText Typo="Typo.caption">
                    Solar y red, últimos 5 minutos.
                    Máximo 300 mediciones.
                </MudText>

                @if (puntos.Count == 0)
                {
                    <MudText Class="mt-3">
                        Todavía no hay mediciones para el gráfico.
                    </MudText>
                }
                else
                {
                    <MudChart T="double"
                              ChartType="ChartType.Line"
                              ChartSeries="@series"
                              ChartLabels="@etiquetas"
                              Width="100%"
                              Height="300px" />
                }

            </MudPaper>

            <MudPaper Class="pa-4" Elevation="1">

                <MudText Typo="Typo.h6">
                    Últimos 10 eventos
                </MudText>

                @if (eventos.Count == 0)
                {
                    <MudText Class="mt-3">
                        No hay eventos registrados.
                    </MudText>
                }
                else
                {
                    <MudTable T="Evento"
                              Items="@eventos"
                              Dense="true"
                              Hover="true">

                        <HeaderContent>
                            <MudTh>Hora</MudTh>
                            <MudTh>Tipo</MudTh>
                            <MudTh>Estado</MudTh>
                            <MudTh>Motivo</MudTh>
                            <MudTh>Origen</MudTh>
                        </HeaderContent>

                        <RowTemplate>
                            <MudTd DataLabel="Hora">
                                @Formato.HoraLocal(context.TsServidor)
                            </MudTd>

                            <MudTd DataLabel="Tipo">
                                @TextosEventos.Tipo(context.Tipo)
                                @if (context.De is not null || context.A is not null)
                                {
                                    <span> (@TextosEventos.DeA(context.De, context.A))</span>
                                }
                            </MudTd>

                            <MudTd DataLabel="Estado">
                                @TextosEventos.Estado(context.Estado)
                            </MudTd>

                            <MudTd DataLabel="Motivo">
                                @TextosEventos.Motivo(context.Motivo)
                            </MudTd>

                            <MudTd DataLabel="Origen">
                                @TextosEventos.Origen(context.Origen)
                            </MudTd>
                        </RowTemplate>

                    </MudTable>
                }

            </MudPaper>

            </MudStack>

            </MudTabPanel>

            @* S23-M10: Pestaña Reglas (RF15). Admin y Técnico editan; Consulta solo ve. *@
            <MudTabPanel Text="Reglas"
                         Icon="@Icons.Material.Outlined.Rule">

                <MudPaper Class="pa-4" Elevation="1">

                    <MudStack Row="true"
                              AlignItems="AlignItems.Center"
                              Spacing="2"
                              Style="flex-wrap:wrap">

                        <MudText Typo="Typo.h6">
                            Reglas de conmutación
                        </MudText>

                        <MudChip T="string"
                                 Color="@(ParametrosAplicados ? Color.Success : Color.Warning)"
                                 Variant="Variant.Filled">
                            Versión @dispositivo.ParametrosVersion —
                            @(ParametrosAplicados ? "Aplicada" : "Pendiente de aplicar")
                        </MudChip>

                    </MudStack>

                    @if (dispositivo.ParametrosVersion == 0)
                    {
                        <MudText Typo="Typo.caption">
                            Usa los valores de fábrica.
                        </MudText>
                    }

                    <MudGrid Spacing="2" Class="mt-2">

                        <MudItem xs="12" sm="6" md="4">
                            <MudNumericField T="decimal"
                                             @bind-Value="formReglas.VMin"
                                             Label="V_min"
                                             Adornment="Adornment.End"
                                             AdornmentText="V"
                                             Step="0.05m"
                                             Format="0.00"
                                             ReadOnly="@(!PuedeControlar)"
                                             HelperText="Mínima con carga (4,0 a 4,9 V)"
                                             Variant="Variant.Outlined" />
                        </MudItem>

                        <MudItem xs="12" sm="6" md="4">
                            <MudNumericField T="decimal"
                                             @bind-Value="formReglas.VRetorno"
                                             Label="V_retorno"
                                             Adornment="Adornment.End"
                                             AdornmentText="V"
                                             Step="0.05m"
                                             Format="0.00"
                                             ReadOnly="@(!PuedeControlar)"
                                             HelperText="Para intentar volver a solar (V_min + 0,2 a 5,3 V)"
                                             Variant="Variant.Outlined" />
                        </MudItem>

                        <MudItem xs="12" sm="6" md="4">
                            <MudNumericField T="decimal"
                                             @bind-Value="formReglas.IMinMa"
                                             Label="I_min"
                                             Adornment="Adornment.End"
                                             AdornmentText="mA"
                                             Step="1m"
                                             ReadOnly="@(!PuedeControlar)"
                                             HelperText="Por debajo no hay consumo (5 a 100 mA)"
                                             Variant="Variant.Outlined" />
                        </MudItem>

                        <MudItem xs="12" sm="6" md="4">
                            <MudNumericField T="decimal"
                                             @bind-Value="formReglas.TFallaS"
                                             Label="T_falla"
                                             Adornment="Adornment.End"
                                             AdornmentText="s"
                                             Step="0.5m"
                                             Format="0.0"
                                             ReadOnly="@(!PuedeControlar)"
                                             HelperText="Tiempo bajo V_min antes de abandonar solar (0,5 a 5 s)"
                                             Variant="Variant.Outlined" />
                        </MudItem>

                        <MudItem xs="12" sm="6" md="4">
                            <MudNumericField T="decimal"
                                             @bind-Value="formReglas.TEstableS"
                                             Label="T_estable"
                                             Adornment="Adornment.End"
                                             AdornmentText="s"
                                             Step="5m"
                                             ReadOnly="@(!PuedeControlar)"
                                             HelperText="Solar estable antes de intentar volver (10 a 300 s)"
                                             Variant="Variant.Outlined" />
                        </MudItem>

                        <MudItem xs="12" sm="6" md="4">
                            <MudNumericField T="decimal"
                                             @bind-Value="formReglas.TPruebaS"
                                             Label="T_prueba"
                                             Adornment="Adornment.End"
                                             AdornmentText="s"
                                             Step="1m"
                                             ReadOnly="@(!PuedeControlar)"
                                             HelperText="Solar sosteniendo la carga para quedar comprobada (2 a 30 s)"
                                             Variant="Variant.Outlined" />
                        </MudItem>

                    </MudGrid>

                    @if (erroresReglas.Count > 0)
                    {
                        <MudAlert Severity="Severity.Error" Class="mt-3">
                            @foreach (var error in erroresReglas)
                            {
                                <div>@error</div>
                            }
                        </MudAlert>
                    }

                    @if (PuedeControlar)
                    {
                        <MudStack Row="true"
                                  Spacing="2"
                                  Class="mt-4"
                                  Style="flex-wrap:wrap">

                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       StartIcon="@Icons.Material.Outlined.Save"
                                       Disabled="@guardandoReglas"
                                       OnClick="GuardarReglasAsync">
                                Guardar y enviar al dispositivo
                            </MudButton>

                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Secondary"
                                       StartIcon="@Icons.Material.Outlined.RestartAlt"
                                       Disabled="@guardandoReglas"
                                       OnClick="RestablecerFabricaAsync">
                                Restablecer valores de fábrica
                            </MudButton>

                        </MudStack>
                    }

                </MudPaper>

            </MudTabPanel>

            </MudTabs>

        </MudStack>
    }

</div>

@code {

    [Parameter]
    public int Id { get; set; }

    private Dispositivo? dispositivo;

    private EstadoDispositivo? estado;

    private List<Evento> eventos = new();

    private readonly List<PuntoPotencia> puntos = new();

    private List<ChartSeries<double>> series = new();

    private string[] etiquetas = Array.Empty<string>();

    private bool cargando = true;

    private bool destruido;

    private readonly CancellationTokenSource cancelacion = new();

    private int empresaId;

    private sealed record PuntoPotencia(
        DateTime Fecha,
        decimal SolarMw,
        decimal RedMw);

    // =====================================================
    // S23-M9: ÓRDENES
    // =====================================================

    private List<Orden> ordenes = new();

    private bool enviandoOrden;

    private static readonly (string Modo, string Texto, string Icono)[] BotonesModo =
    {
        ("AUTO", "Automático", Icons.Material.Outlined.Autorenew),
        ("SOLAR", "Solar", Icons.Material.Outlined.WbSunny),
        ("CARGADOR", "Red", Icons.Material.Outlined.Power)
    };

    private bool PuedeControlar =>
        UsuarioActual.EsAdministrador || UsuarioActual.EsTecnico;

    private string ModoActual =>
        (estado?.Modo ?? dispositivo?.ModoActual ?? "").ToUpperInvariant();

    private static Color ColorOrden(string estadoOrden) => estadoOrden switch
    {
        Orden.EstadoEjecutada => Color.Success,
        Orden.EstadoRechazada => Color.Error,
        Orden.EstadoExpirada => Color.Warning,
        Orden.EstadoEntregada => Color.Info,
        _ => Color.Default
    };

    private async Task EnviarModoAsync(string modo)
    {
        if (!PuedeControlar || dispositivo is null)
            return;

        enviandoOrden = true;

        try
        {
            await CanalOrdenes.EnviarModoAsync(dispositivo.Id, modo);
            await CargarOrdenesAsync();
            Snackbar.Add("Orden enviada. Se entrega con la próxima telemetría.", Severity.Info);
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
        catch (UnauthorizedAccessException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            enviandoOrden = false;
        }
    }

    private async Task CargarOrdenesAsync()
    {
        if (dispositivo is null)
            return;

        ordenes = (await CanalOrdenes.UltimasAsync(dispositivo.Id, 10)).ToList();
    }

    private void AlCambiarOrdenes(int dispositivoId)
    {
        if (destruido || dispositivo is null || dispositivoId != Id)
            return;

        _ = InvokeAsync(async () =>
        {
            if (destruido)
                return;

            await CargarOrdenesAsync();
            await RecargarVersionesParametrosAsync();
            StateHasChanged();
        });
    }

    // =====================================================
    // S23-M10: PESTAÑA REGLAS
    // =====================================================

    private sealed class FormReglas
    {
        public decimal VMin { get; set; }
        public decimal VRetorno { get; set; }
        public decimal IMinMa { get; set; }
        public decimal TFallaS { get; set; }
        public decimal TEstableS { get; set; }
        public decimal TPruebaS { get; set; }

        public static FormReglas Desde(SAGE.Web.Servicios.Configuracion.ParametrosFuente p) => new()
        {
            VMin = p.VMin,
            VRetorno = p.VRetorno,
            IMinMa = p.IMinMa,
            TFallaS = p.TFallaS,
            TEstableS = p.TEstableS,
            TPruebaS = p.TPruebaS
        };

        public SAGE.Web.Servicios.Configuracion.ParametrosFuente AParametros(int version) =>
            new(VMin, VRetorno, IMinMa, TFallaS, TEstableS, TPruebaS) { Version = version };
    }

    private FormReglas formReglas = FormReglas.Desde(
        SAGE.Web.Servicios.Configuracion.ParametrosFuente.Predeterminados);

    private IReadOnlyList<string> erroresReglas = Array.Empty<string>();

    private bool guardandoReglas;

    private bool ParametrosAplicados =>
        dispositivo is not null &&
        dispositivo.ParametrosVersionConfirmada == dispositivo.ParametrosVersion;

    private void CargarFormReglas()
    {
        if (dispositivo is null)
            return;

        formReglas = FormReglas.Desde(
            SAGE.Web.Servicios.Configuracion.ParametrosFuente.DesdeJson(
                dispositivo.ParametrosJson,
                dispositivo.ParametrosVersion));
    }

    private async Task RecargarVersionesParametrosAsync()
    {
        if (dispositivo is null)
            return;

        await using var scope = ScopeFactory.CreateAsyncScope();
        var db = scope.ServiceProvider.GetRequiredService<ApplicationDbContext>();

        var versiones = await db.Dispositivos
            .AsNoTracking()
            .Where(d => d.Id == Id && d.EmpresaId == empresaId)
            .Select(d => new { d.ParametrosVersion, d.ParametrosVersionConfirmada, d.ParametrosJson })
            .FirstOrDefaultAsync();

        if (versiones is null)
            return;

        dispositivo.ParametrosVersion = versiones.ParametrosVersion;
        dispositivo.ParametrosVersionConfirmada = versiones.ParametrosVersionConfirmada;
        dispositivo.ParametrosJson = versiones.ParametrosJson;
    }

    private async Task GuardarReglasAsync()
    {
        if (!PuedeControlar || dispositivo is null)
            return;

        guardandoReglas = true;

        try
        {
            await RecargarVersionesParametrosAsync();

            var nuevaVersion = dispositivo.ParametrosVersion + 1;
            var parametros = formReglas.AParametros(nuevaVersion);

            erroresReglas = parametros.Validar();

            // Valores fuera de rango: no se guarda ni se crea orden.
            if (erroresReglas.Count > 0)
                return;

            // Primero la orden: si hay una entregada esperando resultado, no se guarda nada.
            await CanalOrdenes.EnviarParametrosAsync(dispositivo.Id, parametros);

            await using (var scope = ScopeFactory.CreateAsyncScope())
            {
                var db = scope.ServiceProvider.GetRequiredService<ApplicationDbContext>();

                // Vuelve a comprobar en el servidor que el dispositivo es de la empresa activa.
                var entidad = await db.Dispositivos.FirstOrDefaultAsync(
                    d => d.Id == Id && d.EmpresaId == empresaId);

                if (entidad is null || !UsuarioActual.PuedeVerEmpresa(entidad.EmpresaId))
                {
                    Snackbar.Add("El dispositivo no pertenece a su empresa activa.", Severity.Error);
                    return;
                }

                entidad.ParametrosJson = parametros.AJsonOrden();
                entidad.ParametrosVersion = nuevaVersion;

                await db.SaveChangesAsync();
            }

            await RecargarVersionesParametrosAsync();
            await CargarOrdenesAsync();
            CargarFormReglas();

            Snackbar.Add($"Versión {nuevaVersion} guardada. Se aplica con la próxima telemetría.", Severity.Success);
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
        catch (UnauthorizedAccessException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            guardandoReglas = false;
        }
    }

    private async Task RestablecerFabricaAsync()
    {
        formReglas = FormReglas.Desde(
            SAGE.Web.Servicios.Configuracion.ParametrosFuente.Predeterminados);

        await GuardarReglasAsync();
    }

    private bool EnLinea =>
        estado?.EnLinea ??
        (dispositivo?.UltimoContacto is DateTime ultima &&
         DateTime.UtcNow - ultima <= TimeSpan.FromSeconds(30));

    private string ModoSolicitado =>
        (estado?.Modo ?? dispositivo?.ModoActual ?? "")
            .ToUpperInvariant() switch
        {
            "AUTO" => "Automático",
            "SOLAR" => "Solar",
            "CARGADOR" => "Red",
            _ => "Desconocido"
        };

    private bool Comprobada =>
        estado?.AlimentacionComprobada
        ?? dispositivo?.AlimentacionComprobada
        ?? false;

    private string TextoComprobacion
    {
        get
        {
            if (!Comprobada)
                return "No";

            if (estado is null)
                return "Sí";

            var corriente =
                estado.FuenteSeleccionada == "SOLAR"
                    ? estado.ISolMa
                    : estado.IRedMa;

            return corriente < 20m
                ? "Sin consumo"
                : "Sí";
        }
    }

    protected override void OnInitialized()
    {
        EnVivo.Cambio += AlCambiarEstado;

        EnVivo.EventosRegistrados += AlRegistrarEventos;

        EnVivo.OrdenesCambiaron += AlCambiarOrdenes;

        _ = ActualizarTiempoAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        cargando = true;

        dispositivo = null;

        estado = null;

        eventos.Clear();

        puntos.Clear();

        try
        {
            await UsuarioActual.CargarAsync();

            if (UsuarioActual.EmpresaActivaId is not int empresa)
                return;

            empresaId = empresa;

            await using var scope =
                ScopeFactory.CreateAsyncScope();

            var db = scope.ServiceProvider
                .GetRequiredService<ApplicationDbContext>();

            dispositivo = await db.Dispositivos
                .AsNoTracking()
                .FirstOrDefaultAsync(d =>
                    d.Id == Id &&
                    d.EmpresaId == empresaId &&
                    d.Activo);

            if (dispositivo is null)
                return;

            var ultima = await db.Mediciones
                .AsNoTracking()
                .Where(m => m.DispositivoId == Id)
                .OrderByDescending(m => m.TsServidor)
                .FirstOrDefaultAsync();

            if (ultima is not null)
            {
                estado = EstadoDispositivo.Desde(
                    ultima,
                    empresaId,
                    dispositivo.FactorEscala);

                estado = estado with
                {
                    EnLinea =
                        dispositivo.UltimoContacto.HasValue &&
                        DateTime.UtcNow -
                        dispositivo.UltimoContacto.Value
                        <= TimeSpan.FromSeconds(30)
                };
            }

            var estadoVivo = EnVivo.Obtener(Id);

            if (estadoVivo is not null &&
                estadoVivo.EmpresaId == empresaId)
            {
                estado = estadoVivo;
            }

            var desde = DateTime.UtcNow.AddMinutes(-5);

            var mediciones = await db.Mediciones
                .AsNoTracking()
                .Where(m =>
                    m.DispositivoId == Id &&
                    m.TsServidor >= desde)
                .OrderByDescending(m => m.TsServidor)
                .Take(300)
                .ToListAsync();

            foreach (var m in mediciones.OrderBy(m => m.TsServidor))
            {
                puntos.Add(new PuntoPotencia(
                    m.TsServidor,
                    m.PSolMw,
                    m.PRedMw));
            }

            ActualizarGrafico();

            await CargarEventosAsync();

            await CargarOrdenesAsync();

            CargarFormReglas();
        }
        finally
        {
            cargando = false;
        }
    }

    private void AlCambiarEstado(EstadoDispositivo nuevo)
    {
        if (destruido ||
            dispositivo is null ||
            nuevo.DispositivoId != Id ||
            nuevo.EmpresaId != empresaId)
        {
            return;
        }

        _ = InvokeAsync(() =>
        {
            if (destruido)
                return;

            estado = nuevo;

            if (puntos.Count == 0 ||
                nuevo.TsServidor > puntos[^1].Fecha)
            {
                puntos.Add(new PuntoPotencia(
                    nuevo.TsServidor,
                    nuevo.PSolMw,
                    nuevo.PRedMw));

                ActualizarGrafico();
            }

            StateHasChanged();
        });
    }

    private void AlRegistrarEventos(int dispositivoId)
    {
        if (destruido ||
            dispositivo is null ||
            dispositivoId != Id)
        {
            return;
        }

        _ = InvokeAsync(async () =>
        {
            if (destruido)
                return;

            await CargarEventosAsync();

            StateHasChanged();
        });
    }

    private async Task CargarEventosAsync()
    {
        if (dispositivo is null)
            return;

        await using var scope =
            ScopeFactory.CreateAsyncScope();

        var db = scope.ServiceProvider
            .GetRequiredService<ApplicationDbContext>();

        eventos = await db.Eventos
            .AsNoTracking()
            .Where(e =>
                e.DispositivoId == Id &&
                e.Dispositivo.EmpresaId == empresaId)
            .OrderByDescending(e => e.TsServidor)
            .Take(10)
            .ToListAsync();
    }

    private void ActualizarGrafico()
    {
        if (dispositivo is null)
            return;

        var desde = DateTime.UtcNow.AddMinutes(-5);

        puntos.RemoveAll(p => p.Fecha < desde);

        if (puntos.Count > 300)
        {
            puntos.RemoveRange(0, puntos.Count - 300);
        }

        var factor = dispositivo.FactorEscala;

        series = new List<ChartSeries<double>>
        {
            new ChartSeries<double>
            {
                Name = "Solar (W)",
                Data = puntos
                    .Select(p =>
                        (double)(p.SolarMw * factor / 1000m))
                    .ToArray()
            },

            new ChartSeries<double>
            {
                Name = "Red (W)",
                Data = puntos
                    .Select(p =>
                        (double)(p.RedMw * factor / 1000m))
                    .ToArray()
            }
        };

        etiquetas = puntos
            .Select(p =>
                Formato.HoraLocal(p.Fecha).Substring(11))
            .ToArray();
    }

    private async Task ActualizarTiempoAsync()
    {
        using var temporizador =
            new PeriodicTimer(TimeSpan.FromSeconds(1));

        try
        {
            while (await temporizador.WaitForNextTickAsync(
                       cancelacion.Token))
            {
                await InvokeAsync(() =>
                {
                    if (!destruido)
                        StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException)
        {
            // El componente se cerró.
        }
    }

    public void Dispose()
    {
        destruido = true;

        EnVivo.Cambio -= AlCambiarEstado;

        EnVivo.EventosRegistrados -= AlRegistrarEventos;

        EnVivo.OrdenesCambiaron -= AlCambiarOrdenes;

        cancelacion.Cancel();

        cancelacion.Dispose();
    }
}