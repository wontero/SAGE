@implements IDisposable

@using Microsoft.EntityFrameworkCore
@using SAGE.Web.Data
@using SAGE.Web.Servicios.EnVivo
@using SAGE.Web.Servicios.Seguridad

@inject IUsuarioActual UsuarioActual
@inject EstadoDispositivosEnVivo EnVivo
@inject IServiceScopeFactory ScopeFactory
@inject NavigationManager NavigationManager

@* // Patrón: Observer — rol: observador *@

<button type="button"
        class="sage-alert-bell"
        aria-label="@(_alertasActivas > 0 ? $"Ver alertas ({_alertasActivas} abiertas)" : "Ver alertas")"
        title="@(_alertasActivas > 0 ? $"{_alertasActivas} alerta{(_alertasActivas == 1 ? "" : "s")} abierta{(_alertasActivas == 1 ? "" : "s")}" : "Sin alertas abiertas")"
        @onclick="IrAAlertas">
    <MudIcon Icon="@Icons.Material.Outlined.Notifications" Class="sage-alert-bell__icon" />
    @if (_alertasActivas > 0)
    {
        <span class="sage-alert-bell__badge">@TextoBadge</span>
    }
</button>

@code {
    private int _alertasActivas;
    private bool _disposed;
    private long _versionConsulta;

    private string TextoBadge => _alertasActivas > 99 ? "99+" : _alertasActivas.ToString();

    protected override async Task OnInitializedAsync()
    {
        await UsuarioActual.CargarAsync();

        EnVivo.AlertasCambiaron += OnAlertasCambiaron;
        UsuarioActual.EmpresaCambiada += OnEmpresaCambiada;

        await CargarContadorAsync();
    }

    private async Task CargarContadorAsync()
    {
        var version = Interlocked.Increment(ref _versionConsulta);
        var empresaId = UsuarioActual.EmpresaActivaId;

        if (empresaId is null)
        {
            _alertasActivas = 0;
            return;
        }

        try
        {
            await using var scope = ScopeFactory.CreateAsyncScope();
            var db = scope.ServiceProvider.GetRequiredService<ApplicationDbContext>();

            var cantidad = await db.Alertas
                .AsNoTracking()
                .CountAsync(a =>
                    a.Dispositivo.EmpresaId == empresaId.Value &&
                    a.Activa &&
                    a.Fin == null);

            if (!_disposed &&
                version == Interlocked.Read(ref _versionConsulta) &&
                UsuarioActual.EmpresaActivaId == empresaId)
            {
                _alertasActivas = cantidad;
            }
        }
        catch (ObjectDisposedException)
        {
        }
        catch (Exception)
        {
        }
    }

    private void OnAlertasCambiaron(int empresaId)
    {
        if (_disposed || UsuarioActual.EmpresaActivaId != empresaId)
            return;

        _ = ActualizarEnInterfazAsync();
    }

    private async Task ActualizarEnInterfazAsync()
    {
        try
        {
            await InvokeAsync(async () =>
            {
                if (_disposed)
                    return;

                await CargarContadorAsync();

                if (!_disposed)
                    StateHasChanged();
            });
        }
        catch (ObjectDisposedException)
        {
        }
        catch (InvalidOperationException)
        {
        }
    }

    private void OnEmpresaCambiada()
    {
        if (_disposed)
            return;

        _ = ActualizarEnInterfazAsync();
    }

    private void IrAAlertas()
    {
        NavigationManager.NavigateTo("/alertas");
    }

    public void Dispose()
    {
        _disposed = true;
        EnVivo.AlertasCambiaron -= OnAlertasCambiaron;
        UsuarioActual.EmpresaCambiada -= OnEmpresaCambiada;
    }
}
