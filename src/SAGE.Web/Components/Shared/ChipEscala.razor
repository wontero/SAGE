@using Microsoft.AspNetCore.Components
@using MudBlazor
@using System.Globalization

@if (Factor != 1m)
{
    <MudChip T="string"
             Color="Color.Info"
             Variant="Variant.Outlined"
             Size="Size.Small">
        Maqueta ×@Factor.ToString("0.##", CultureInfo.GetCultureInfo("es-BO"))
    </MudChip>
}

@code {
    [Parameter]
    public decimal Factor { get; set; } = 1m;
}
