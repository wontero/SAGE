@page "/Account/CambiarContrasenaInicial"

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@using SAGE.Web.Data

@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject IdentityRedirectManager RedirectManager
@inject NavigationManager NavigationManager
@inject ILogger<CambiarContrasenaInicial> Logger

<PageTitle>Cambiar contraseña — SAGE</PageTitle>

<div class="account-card-wrap">
    <div class="account-card">
        <div class="sage-brand-row">
            <SageMark Size="52" />
            <div>
                <h1 class="sage-brand">SAGE</h1>
                <p class="sage-brand-sub">Primer inicio de sesión</p>
            </div>
        </div>

        <h2 class="account-card__title">Cambia tu contraseña temporal</h2>
        <p class="sage-brand-sub">
            Por seguridad, debes definir una contraseña nueva antes de usar la plataforma.
        </p>

        <StatusMessage Message="@message" />

        <EditForm Model="Input" FormName="cambiar-contrasena-inicial" OnValidSubmit="OnValidSubmitAsync" method="post">
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" role="alert" />

            <div class="form-floating mb-3">
                <InputText type="password" @bind-Value="Input.ContrasenaTemporal" id="Input.ContrasenaTemporal" class="form-control" autocomplete="current-password" aria-required="true" placeholder="Contraseña temporal" />
                <label for="Input.ContrasenaTemporal" class="form-label">Contraseña temporal</label>
                <ValidationMessage For="() => Input.ContrasenaTemporal" class="text-danger" />
            </div>
            <div class="form-floating mb-3">
                <InputText type="password" @bind-Value="Input.NuevaContrasena" id="Input.NuevaContrasena" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Nueva contraseña" />
                <label for="Input.NuevaContrasena" class="form-label">Nueva contraseña</label>
                <ValidationMessage For="() => Input.NuevaContrasena" class="text-danger" />
            </div>
            <div class="form-floating mb-3">
                <InputText type="password" @bind-Value="Input.ConfirmarContrasena" id="Input.ConfirmarContrasena" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Confirmar nueva contraseña" />
                <label for="Input.ConfirmarContrasena" class="form-label">Confirmar nueva contraseña</label>
                <ValidationMessage For="() => Input.ConfirmarContrasena" class="text-danger" />
            </div>

            <button type="submit" class="w-100 btn btn-lg btn-sage">Guardar y continuar</button>
        </EditForm>
    </div>
</div>

@code {
    private string? message;
    private ApplicationUser? user;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();

        user = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }

        // Si ya no debe cambiarla, no tiene sentido quedarse aquí.
        if (HttpMethods.IsGet(HttpContext.Request.Method) && !user.DebeCambiarContrasena)
        {
            RedirectManager.RedirectTo("/");
        }
    }

    private async Task OnValidSubmitAsync()
    {
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }

        if (Input.NuevaContrasena == Input.ContrasenaTemporal)
        {
            message = "Error: La nueva contraseña debe ser distinta de la temporal.";
            return;
        }

        var resultado = await UserManager.ChangePasswordAsync(user, Input.ContrasenaTemporal, Input.NuevaContrasena);
        if (!resultado.Succeeded)
        {
            message = $"Error: {string.Join(" ", resultado.Errors.Select(e => e.Description))}";
            return;
        }

        user.DebeCambiarContrasena = false;
        await UserManager.UpdateAsync(user);

        await SignInManager.RefreshSignInAsync(user);
        Logger.LogInformation("El usuario cambió su contraseña temporal.");

        RedirectManager.RedirectTo("/");
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "Ingresá la contraseña temporal.")]
        [DataType(DataType.Password)]
        public string ContrasenaTemporal { get; set; } = "";

        [Required(ErrorMessage = "Ingresá la nueva contraseña.")]
        [StringLength(100, ErrorMessage = "La contraseña debe tener entre {2} y {1} caracteres.", MinimumLength = 8)]
        [DataType(DataType.Password)]
        public string NuevaContrasena { get; set; } = "";

        [DataType(DataType.Password)]
        [Compare(nameof(NuevaContrasena), ErrorMessage = "Las contraseñas no coinciden.")]
        public string ConfirmarContrasena { get; set; } = "";
    }
}
