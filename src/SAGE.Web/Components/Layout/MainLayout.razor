@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager NavigationManager
@inject SAGE.Web.Servicios.Seguridad.IUsuarioActual UsuarioActual

<MudThemeProvider Theme="_temaSage" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout Class="sage-shell">
    <MudAppBar Elevation="0" Dense="true" Class="sage-toolbar" Color="Color.Transparent">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="ToggleDrawer" aria-label="Menú" />
        <a class="sage-toolbar__brand" href="/" aria-label="SAGE inicio">
            <SageMark Size="34" Class="sage-toolbar__mark" />
            <span class="sage-toolbar__word">SAGE</span>
        </a>
        <MudSpacer />
        <AuthorizeView>
            <Authorized>
                @if (UsuarioActual.EsOperador)
                {
                    <span class="sage-toolbar__chip">Operador SAGE</span>
                }
                else if (UsuarioActual.Empresas.Count == 1)
                {
                    <span class="sage-toolbar__chip">@UsuarioActual.Empresas[0].Nombre</span>
                }
                else if (UsuarioActual.Empresas.Count > 1)
                {
                    <MudSelect T="int"
                               Dense="true"
                               Margin="Margin.Dense"
                               Class="sage-toolbar__empresa"
                               Value="UsuarioActual.EmpresaActivaId ?? 0"
                               ValueChanged="CambiarEmpresa"
                               Variant="Variant.Outlined"
                               AnchorOrigin="Origin.BottomCenter"
                               TransformOrigin="Origin.TopCenter"
                               aria-label="Empresa activa">
                        @foreach (var e in UsuarioActual.Empresas)
                        {
                            <MudSelectItem T="int" Value="@e.Id">@e.Nombre</MudSelectItem>
                        }
                    </MudSelect>
                }
                <span class="sage-toolbar__user">@context.User.Identity?.Name</span>
                <form action="Account/Logout" method="post" class="sage-toolbar__logout">
                    <AntiforgeryToken />
                    <input type="hidden" name="ReturnUrl" value="@_currentUrl" />
                    <button type="submit" class="sage-toolbar__btn">Cerrar sesión</button>
                </form>
            </Authorized>
        </AuthorizeView>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="0" Class="sage-sidebar" Variant="DrawerVariant.Persistent">
        <div class="sage-sidebar__head">
            <a class="sage-sidebar__brand" href="/" aria-label="SAGE">
                <SageMark Size="40" />
                <span>
                    <span class="sage-sidebar__word">SAGE</span>
                    <span class="sage-sidebar__caption">Menú</span>
                </span>
            </a>
        </div>
        <NavMenu />
    </MudDrawer>

    <MudMainContent Class="sage-main">
        <div @key="UsuarioActual.EmpresaActivaId">
            @Body
        </div>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    Ha ocurrido un error inesperado.
    <a href="." class="reload">Recargar</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _drawerOpen = true;
    private string? _currentUrl;

    private readonly MudTheme _temaSage = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#1565C0",
            Secondary = "#00ACC1",
            AppbarBackground = "rgba(255,255,255,0.72)",
            AppbarText = "#1C2430",
            DrawerBackground = "#F2F4F7",
            Background = "#F2F4F7",
            Surface = "#FFFFFF",
            TextPrimary = "#1C2430",
            TextSecondary = "#5B6775"
        },
        Typography = new Typography
        {
            Default = new DefaultTypography
            {
                FontFamily = ["-apple-system", "BlinkMacSystemFont", "SF Pro Text", "Segoe UI", "system-ui", "sans-serif"]
            }
        }
    };

    protected override async Task OnInitializedAsync()
    {
        _currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
        UsuarioActual.EmpresaCambiada += OnEmpresaCambiada;

        await UsuarioActual.CargarAsync();

        if (UsuarioActual.DebeCambiarContrasena)
        {
            NavigationManager.NavigateTo("/Account/CambiarContrasenaInicial", forceLoad: true);
        }
    }

    private async Task CambiarEmpresa(int empresaId)
    {
        await UsuarioActual.SeleccionarEmpresaAsync(empresaId);
    }

    private void OnEmpresaCambiada() => InvokeAsync(StateHasChanged);

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
        UsuarioActual.EmpresaCambiada -= OnEmpresaCambiada;
    }
}
