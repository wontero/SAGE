<MudNavMenu Class="sage-nav"
            Color="Color.Default"
            Bordered="false">

    <MudNavLink Href="/"
                Match="NavLinkMatch.All"
                Icon="@Icons.Material.Outlined.Home">
        Inicio
    </MudNavLink>

    @* S23-M6: Monitoreo en tiempo real *@
    <AuthorizeView Roles="Administrador,Tecnico,Consulta">
        <Authorized>
            <MudNavLink Href="/monitoreo"
                        Match="NavLinkMatch.Prefix"
                        Icon="@Icons.Material.Outlined.MonitorHeart">
                Monitoreo
            </MudNavLink>
        </Authorized>
    </AuthorizeView>

    <AuthorizeView Roles="Operador">
        <Authorized>
            <MudNavLink Href="/empresas"
                        Icon="@Icons.Material.Outlined.Apartment">
                Empresas
            </MudNavLink>

            <MudNavLink Href="/usuarios"
                        Icon="@Icons.Material.Outlined.People">
                Usuarios
            </MudNavLink>

            <MudNavLink Href="/parametros"
                        Icon="@Icons.Material.Outlined.Tune">
                Parámetros económicos
            </MudNavLink>
        </Authorized>
    </AuthorizeView>

    <AuthorizeView Roles="Administrador">
        <Authorized>
            <MudNavLink Href="/usuarios"
                        Icon="@Icons.Material.Outlined.People">
                Usuarios
            </MudNavLink>
        </Authorized>
    </AuthorizeView>

    <AuthorizeView Roles="Administrador,Tecnico,Consulta">
        <Authorized>

            <MudNavLink Href="/dispositivos"
                        Icon="@Icons.Material.Outlined.Devices">
                Dispositivos
            </MudNavLink>

            <MudNavLink Href="/mediciones"
                        Icon="@Icons.Material.Outlined.ShowChart">
                Mediciones
            </MudNavLink>

            @* S23-M5: Pantalla de eventos *@
            <MudNavLink Href="/eventos"
                        Icon="@Icons.Material.Outlined.EventNote">
                Eventos
            </MudNavLink>

            @* S23-M7: Pantalla de alertas automáticas *@
            <MudNavLink Href="/alertas"
                        Icon="@Icons.Material.Outlined.NotificationsActive">
                Alertas
            </MudNavLink>

            <MudNavLink Href="/facturas"
                        Icon="@Icons.Material.Outlined.Receipt">
                Facturas
            </MudNavLink>

            <MudNavLink Href="/simulacion"
                        Icon="@Icons.Material.Outlined.Calculate">
                Simulación
            </MudNavLink>

        </Authorized>
    </AuthorizeView>

</MudNavMenu>