
<MudNavMenu Class="sage-nav"
            Color="Color.Default"
            Bordered="false">

    <MudNavLink Href="/"
                Match="NavLinkMatch.All"
                Icon="@Icons.Material.Outlined.Home">
        Inicio
    </MudNavLink>

    <AuthorizeView Roles="Administrador">
        <Authorized>
            <MudNavLink Href="/empresas"
                        Icon="@Icons.Material.Outlined.Apartment">
                Empresas
            </MudNavLink>

            <MudNavLink Href="/usuarios"
                        Icon="@Icons.Material.Outlined.People">
                Usuarios
            </MudNavLink>
        </Authorized>
    </AuthorizeView>

    <AuthorizeView Roles="Administrador,Tecnico,Consulta">
        <Authorized>
            <MudNavLink Href="/dispositivos"
                        Icon="@Icons.Material.Outlined.Devices">
                Dispositivos
            </MudNavLink>

            <MudNavLink Href="/mediciones"
                        Icon="@Icons.Material.Outlined.ShowChart">
                Mediciones
            </MudNavLink>
        </Authorized>
    </AuthorizeView>

</MudNavMenu>
